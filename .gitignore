# Secrets — never commit
.env
.env.*
*.key
secrets/

# Source doc contains plaintext credentials — stays out of git until sanitized
*.odt

# OS/editor noise
.DS_Store
*.swp
node_modules/

# vault (SEC-02) — real values live only in gitignored .env; .env.example is the committed name registry
.env
.env.*
!.env.example

# Obsidian — personal/volatile UI state (shareable configs stay tracked)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# research fetch cache — transient, never enters history
.planning/research/.cache/

# graphify working output — canonical copy lives in .planning/graphs/
graphify-out/

# TypeScript monorepo build output — regenerated by `pnpm build` (tsc --build)
dist/
*.tsbuildinfo

# B36, 2026-08-23 — ONE exception, and the reason is that this file is not run by
# our toolchain. Claude Code executes tools/hooks/dist/tag-subscription-call.js
# at the end of every session (.claude/settings.json), so on a machine where
# nobody has run `pnpm typecheck` the wall that keeps construction costs out of
# the holding's ledger would simply not exist. A third audit said so. The built
# file therefore travels with the commit, and tests/b36 fails the battery if it
# is ever not byte-for-byte what the source compiles to.
!tools/hooks/dist/
tools/hooks/dist/*
!tools/hooks/dist/tag-subscription-call.js
# B39, 2026-08-25 — and its one import travels with it for the same reason. The
# token arithmetic was moved out of the hook so it could be tested at all (the
# hook runs its own main() at import time and no test can import it). The built
# hook now does `import { sumTranscript } from "./transcript-usage.js"`, so a
# clone without this file would fail the hook with a module-not-found at the end
# of every session — exactly the silence the block above exists to prevent.
!tools/hooks/dist/transcript-usage.js

# pnpm local store — not committed, restored via lockfile
.pnpm-store/

# Next.js build output + generated env types (apps/dashboard)
.next/
next-env.d.ts

# outbox-executor harmless-proof artifacts (tests write here; never history)
tmp/

# open-notebook local secret carrier (06-01; A8 — value never committed)
vps/open-notebook/secrets.local

# memory router runtime notes (06-04 DESIGN DECISION): router-written memories
# are runtime data — vault-visible locally, never auto-committed (durability =
# disk + memory_index + audit trail; VPS backup owns the rest at Phase 7)
memory-store/

# Hetzner API token carrier (07-04; CEO-minted, project-scoped — value never committed)
vps/provision/.hetzner.local

# LibreOffice lock files
.~lock.*#

# Playwright MCP session artifacts (console logs, page snapshots) — transient;
# durable evidence is copied into .planning/phases/*/evidence/
.playwright-mcp/
BEKLENTİLER
**/.impeccable/

# R3.1 voice: transient answer-WAV handoff + scheduler log — runtime artifacts, never committed
/var/
tests/e2e/evidence/

# rival intel (C42) raw material — evidence lives as sha256 + transcript + report,
# never as committed media. Repos are shallow clones of public upstreams.
.planning/research/rival-intel/media/
.planning/research/rival-intel/repos/
.planning/research/rival-intel/frames/
.planning/research/rival-intel/work/
