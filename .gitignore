# Secrets — never commit
.env
.env.*
*.key
secrets/

# Source doc contains plaintext credentials — stays out of git until sanitized
*.odt

# OS/editor noise
.DS_Store
*.swp
node_modules/

# External clone — read-only persona source, not part of OS repo
agency-agents/

# vault (SEC-02) — real values live only in gitignored .env; .env.example is the committed name registry
.env
.env.*
!.env.example

# Obsidian — personal/volatile UI state (shareable configs stay tracked)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# research fetch cache — transient, never enters history
.planning/research/.cache/

# graphify working output — canonical copy lives in .planning/graphs/
graphify-out/
