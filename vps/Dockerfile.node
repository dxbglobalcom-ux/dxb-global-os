# DXB monorepo runtime image (07-05). One image, per-service command in
# compose (outbox scheduler today; vps-worker joins in 07-06; dxb-mcp ships in
# the image but is session-spawned over stdio, not a daemon). Node pinned
# exact (tag verified on Docker Hub 2026-07-09); pnpm pinned via the repo's
# packageManager field through corepack — no moving tags anywhere.
FROM node:22.23.1-slim

WORKDIR /app
COPY . .
RUN corepack enable \
  && pnpm install --frozen-lockfile \
  && pnpm build

# Default command = outbox scheduler (pg-boss: tick/reaper/breaker/compaction/
# memSync + tool-pin-check 04:00). Other services override `command`.
CMD ["node", "--input-type=module", "-e", "const {startScheduler} = await import('/app/packages/outbox-executor/dist/scheduler.js'); await startScheduler(); console.log('outbox scheduler up');"]
