# DXB VPS environment template (07-05). NAMES ONLY — never a real value in
# this tracked file (T-07-15; gitleaks pre-commit). On the box: copy to
# vps/.env, fill, chmod 600. Infra secrets are GENERATED on the box at deploy
# (openssl rand); only OPENROUTER_API_KEY is CEO-provided.

# --- Postgres / Supabase core ---
POSTGRES_PASSWORD=            # openssl rand -hex 24
JWT_SECRET=                   # openssl rand -hex 32 (signs anon/service tokens)
ANON_KEY=                     # HS256 JWT {role:anon} signed with JWT_SECRET (deploy script mints)
SERVICE_ROLE_KEY=             # HS256 JWT {role:service_role} signed with JWT_SECRET
DASHBOARD_USERNAME=           # Studio basic-auth user (kong)
DASHBOARD_PASSWORD=           # openssl rand -hex 16
SECRET_KEY_BASE=              # openssl rand -hex 32 (realtime)
REALTIME_DB_ENC_KEY=          # EXACTLY 16 chars: openssl rand -hex 8

# --- LiteLLM (real provider keys live ONLY here — COST-02) ---
LITELLM_MASTER_KEY=           # sk-... openssl rand -hex 24
LITELLM_SALT_KEY=             # openssl rand -hex 24 (stable; virtual keys break if rotated)
OPENROUTER_API_KEY=           # CEO-provided (vault); the ONLY human-supplied secret here

# --- Domain / TLS (07-04 Caddy) ---
DXB_DOMAIN=                   # FQDN of the CEO's DNS A record

# --- brain profile (07-06 wave) ---
OPEN_NOTEBOOK_ENCRYPTION_KEY= # openssl rand -hex 24

# --- backups (07-05 Task 3) ---
BACKUP_DIR=/opt/dxb/backups   # local dump dir on the box
BACKUP_DEST=                  # off-site target, e.g. user@host:path (scp) — CEO decides destination
BACKUP_RETENTION_DAYS=14
