{
  "name": "dxb-global-os",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "scheduler": "node packages/outbox-executor/dist/main.js",
    "jarvis": "node packages/voice/dist/jarvis-daemon.js",
    "test": "vitest run",
    "verify:ledger": "node scripts/governance/ledger-truth.mjs",
    "verify:ledger:update": "node scripts/governance/ledger-truth.mjs --update",
    "video-learn": "node tools/video-learn/dist/cli.js",
    "construction:start": "supabase start --workdir construction",
    "construction:stop": "supabase stop --workdir construction",
    "construction:schema": "DXB_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres DXB_PSQL='docker exec -i supabase_db_DxB_Build psql -U postgres -d postgres' DXB_PSQL_ADMIN='docker exec -i supabase_db_DxB_Build psql -U supabase_admin -d postgres' bash scripts/bootstrap-db.sh",
    "construction:seed": "DXB_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres node --experimental-strip-types db/seed/build-seed.ts",
    "verify:schema-parity": "DXB_COMPANY_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres DXB_CONSTRUCTION_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres node scripts/b36/schema-parity.mjs",
    "b36:prove-block1": "DXB_COMPANY_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres DXB_ALLOWED_LEDGER_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres node scripts/b36/prove-block1.mjs",
    "b36:window": "node scripts/b36/install-company-window.mjs company",
    "b36:prove-window": "node scripts/b36/prove-window.mjs company",
    "b36:prove-window-preserves": "node scripts/b36/prove-window-preserves.mjs",
    "b36:prove-window-escapes": "node scripts/b36/prove-window-escapes.mjs"
  },
  "devDependencies": {
    "@dxb/cli": "workspace:*",
    "@dxb/video-learn": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "catalog:",
    "jsdom": "^29.1.1",
    "kysely": "catalog:",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "supabase": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@playwright/mcp": "0.0.78",
    "@upstash/context7-mcp": "3.2.4"
  }
}
