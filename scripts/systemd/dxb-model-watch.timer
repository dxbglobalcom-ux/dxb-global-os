# THE MODEL WATCH — MONDAY AND THURSDAY at 09:00, row B55 (2026-09-24).
#
# Twice a week, his order the same day ("her gün değil haftada 2 defalık yapalım pazartesi ve
# perşembe olsun"): a model or a guidance page is announced, not slipped in by the hour, and the
# notice waits for the next session's opening anyway. 09:00 so that day's first session already
# carries what appeared since the run before.
#
# Persistent=true: if the machine was off at 09:00, the watch runs at the next boot instead of
# being silently skipped — and if it still cannot read a page for five days, the opening names
# that page. A watch that fails in silence is believed. RandomizedDelaySec keeps it off the exact
# second the other timers wake on.
[Unit]
Description=DXB — model watch, Monday and Thursday at 09:00

[Timer]
OnCalendar=Mon,Thu *-*-* 09:00:00
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
