# THE BACKUP'S FAILURE, SAID ALOUD — systemd USER unit (install: scripts/systemd/install.sh).
#
# B72, 2026-11-22: the nightly copy had failed its off-site leg for 55 nights and
# nobody was told, because the only place it spoke was a log nobody opens.
# dxb-backup.service names this unit in OnFailure=; it is never enabled and has
# no timer of its own. It raises one critical desktop notification naming the
# leg that failed (scripts/backup/backup-alert.sh). It runs in the user manager,
# which carries the session's D-Bus address — measured from a transient user
# unit the same night: gnome-shell took the notification.
[Unit]
Description=DXB — says on the desktop that the nightly backup failed

[Service]
Type=oneshot
ExecStart=/usr/bin/bash "%h/DxB Global OS/scripts/backup/backup-alert.sh"
StandardOutput=append:%h/backups/dxb/backup.log
StandardError=append:%h/backups/dxb/backup.log
