#!/usr/bin/env python3
"""dxb-warm-wait -- a session's alarm clock while it waits, which keeps its prompt cache warm.

A session that must wait (the 5-hour quota window, a long render) loses its prompt cache
after an hour without a turn, and its next turn then writes the whole context again. Run
in the background, this command ends -- and so wakes the session -- either when the wait
is over or, before that, when the cache is about to go cold; the turn that wake causes is
the warm-keeping itself. The session then runs the line this command printed, and waits on.

  dxb-warm-wait --watch            no end: work is running (hands, tests, a render); only keep warm
  dxb-warm-wait --until-reset      wait for the 5-hour window to reset (the status line's quota record)
  dxb-warm-wait --until 01:50      wait until that local time (tomorrow, when it has passed)
  dxb-warm-wait --until @1794500000   the same, as epoch seconds (what a re-arm line carries)
  dxb-warm-wait --for 90           wait that many minutes
  dxb-warm-wait --status           at once: is a clock armed, and is the session marked away
  dxb-warm-wait --away on|off      mark the session as left to work alone (dxb-away-gate.py reads it)

The cache goes cold 55 minutes after the session's LAST TURN, not after the arming: the turn
is read from the session's transcript ($CLAUDE_CODE_SESSION_ID's, or --transcript PATH), and a
clock that comes to its ping and finds a newer turn moves the ping forward and sleeps on. So
one clock is enough for a whole job, and a session has one: it is written down in
$XDG_RUNTIME_DIR/claude-ctx/warm-wait-<session>.pid while it runs -- its pid, its session and the
moment its process started, which together prove it; a name on a command line proves nothing.

A wait prints one line and exits 0:
  WAIT_OVER ...                  the wait is over: go on with the work
  WARM_PING ... | re-arm: <cmd>  the cache was about to go cold: run <cmd> in the background again
  SUPERSEDED by --until-reset    a --watch, when --until-reset was armed over it: nothing to do
It never ends on a wake the quota would cut: before either line a turn must have room -- the
5-hour window and the week both under 98 %, and the session model's own week too when dxb-usage has
a reading of it (one not known leaves the two windows to decide, as before). A full window is slept
to its reset (the latest one when more are full); a quota that cannot be read is read again every
minute, in here, and after 5 h 10 min the session is woken all the same. It also stays asleep through pings when so many
would be needed that a cold start is cheaper. Each of these is said on WAIT_OVER as `cold: ...`.
Exit 2: bad usage, or --until-reset with no 5-hour reset ahead in the record.
Exit 3: ALREADY_ARMED ... -- the session's clock is running; only --until-reset may be armed
over a --watch. --status first: ARMED <mode> pid <n>, next ping <HH:MM> or NOT_ARMED, then
AWAY on|off.
Exit 4: NOT_ARMED the clock could not be written down ... -- said at once, and nothing sleeps:
a clock the gate cannot see is not left running.

The weights are list prices (a cached read 0.1 of the input price, a one-hour cache write
2.0); how the Max quota weighs a cached read is not measured. Every wake appends one line
to $XDG_RUNTIME_DIR/claude-ctx/warm-wait.log with the mode and the quota then, so what a ping
costs can be read from two neighbouring lines.
"""

import contextlib
import datetime
import fcntl
import glob
import importlib.machinery
import importlib.util
import json
import math
import os
import subprocess
import sys
import time

USAGE = ("usage: dxb-warm-wait (--watch | --until-reset | --until HH:MM | --until @EPOCH | --for MINUTES) [--transcript PATH]\n"
         "       dxb-warm-wait --status [--transcript PATH] | --away (on | off)")


def test_knob(name, real):
    """A number the tests and a hand run shorten, as DXB_WARM_WAIT_TEST_<name>: PING_AFTER_S, STEP_S,
    QUOTA_LINE_TIMEOUT_S, LOCK_PATIENCE_S."""
    return float(os.environ.get(f"DXB_WARM_WAIT_TEST_{name}", real))


PING_AFTER_MIN = 55     # his number (CEO, 2026-11-13): one turn at the 55th minute of an hour's cache
PING_AFTER_S = test_knob("PING_AFTER_S", PING_AFTER_MIN * 60)
CACHE_READ = 0.1        # what a ping costs, as a share of the context at the input price
CACHE_WRITE_1H = 2.0    # what a cold start costs, the same way
FULL_WINDOW_PCT = 98    # from here a window has no room for a turn: the turn could be cut
RESET_MARGIN_MIN = 2    # waited past the reset, so the status line has the new window
WINDOWS = {"five_hour": ("5-hour window", 5 * 3600), "seven_day": ("week", 7 * 24 * 3600)}  # in the record: (its name, its length)
QUOTA_RETRY_S = 60      # a quota that cannot be read is read again this often -- by the clock, which takes no turn
BLIND_CEILING_MIN = 310  # ... and after 5 h 10 min the session is woken all the same: a 5-hour window has reset by
#                          then, and with a week that cannot be read the session, awake, decides
STEP_S = test_knob("STEP_S", 20)  # the clocks are asked this often, so a suspended machine wakes on time
NO_END = math.inf       # --watch: the wait has no end of its own
TRANSCRIPT_TAIL_BYTES = 256 * 1024  # as much of the transcript as dxb-statusline.js reads
QUOTA_LINE_TIMEOUT_S = test_knob("QUOTA_LINE_TIMEOUT_S", 20)  # dxb-quota's line is only shown: the wake waits no longer for it
LOCK_PATIENCE_S = test_knob("LOCK_PATIENCE_S", 10)  # an arming waits this long for the clocks' folder, never without an end

QUOTA = os.path.expanduser("~/.local/bin/dxb-quota")
OWN_WEEKS = os.path.join(os.path.dirname(os.path.abspath(__file__)), "dxb-usage")  # each model's own week: its record and its rule
FETCH_TIMEOUT_S = 30    # dxb-usage --refresh; its request's own limit is ten seconds
PROJECTS = os.path.expanduser("~/.claude/projects")
RUNTIME = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "claude-ctx")
QUOTA_RECORD = os.path.join(RUNTIME, "rate-limits.json")  # dxb-statusline.js writes it; dxb-quota reads the same file
LOG = os.path.join(RUNTIME, "warm-wait.log")


class Superseded(Exception):
    """Another clock has taken this session over; it carries that clock's mode."""


def wall_clock():
    return time.time()


def boot_clock():
    """Seconds since the machine booted, a suspend counted in; nothing sets this clock."""
    return time.clock_gettime(time.CLOCK_BOOTTIME)


def pings_needed(wait_s, ping_after_s=PING_AFTER_S):
    """How many warm-keeping turns a wait of this length takes."""
    return max(0, math.ceil(wait_s / ping_after_s) - 1)


def worth_keeping_warm(pings):
    """Pings pay while together they cost less than the one cold start they save."""
    return pings * CACHE_READ < CACHE_WRITE_1H


def next_wake(now, target, ping_after_s=PING_AFTER_S):
    """(when to wake, whether that wake ends the wait)."""
    ping = now + ping_after_s
    return (target, True) if target <= ping else (ping, False)


def past_reset(reset):
    """When a window that resets at that second has reset and the status line has the new one."""
    return reset + RESET_MARGIN_MIN * 60


def parse_target(argv, now, reset):
    """The epoch second the wait ends at, from the command line; None when it cannot be told.

    `reset` is the second the 5-hour window resets, None when the record holds none that is still to come.
    """
    if argv == ["--watch"]:
        return NO_END
    if argv == ["--until-reset"]:
        return None if reset is None else past_reset(reset)
    if len(argv) != 2:
        return None
    flag, value = argv
    try:
        if flag == "--for":
            minutes = float(value)
            return now + minutes * 60 if math.isfinite(minutes) and minutes > 0 else None
        if flag == "--until" and value.startswith("@"):
            epoch = float(value[1:])
            return epoch if math.isfinite(epoch) else None
        if flag == "--until":
            hour, minute = (int(part) for part in value.split(":"))
            at = datetime.datetime.fromtimestamp(now).replace(hour=hour, minute=minute, second=0, microsecond=0)
            if at.timestamp() <= now:
                at += datetime.timedelta(days=1)
            return at.timestamp()
    except ValueError:
        return None
    return None


def read_quota():
    """The account's quota as the status line last wrote it down, or {} with no record to read.

    {"five_hour": {"used_percentage", "resets_at"}, "seven_day": {...}}: the reading of the last turn any
    session took, so it goes stale while every session sleeps. The clock reads the record itself and not
    dxb-quota's numbers, for the second each window resets at: dxb-quota rounds it to a tenth of an hour.
    """
    try:
        with open(QUOTA_RECORD) as handle:
            record = json.load(handle)
    except (OSError, ValueError):
        return {}
    return record if isinstance(record, dict) else {}


def is_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)


def reading(quota, window):
    held = quota.get(window)
    return held if isinstance(held, dict) else {}


def used(quota, window):
    """That window's percentage used, or None when the record holds no number for it."""
    value = reading(quota, window).get("used_percentage")
    return value if is_number(value) else None


def reset_at(quota, window, now):
    """The second that window resets -- it may have passed -- or None when the record holds none to go by.

    It is slept on, so it is checked first: a finite number, a real moment, and no further away than the
    window is long. Anything else would be a sleep with no end behind a clock that looks alive.
    """
    value = reading(quota, window).get("resets_at")
    return value if is_number(value) and 0 < value <= past_reset(now + WINDOWS[window][1]) else None


def keep_resets(seen, quota):
    """The record as read now; a window it holds no percentage for keeps the reset this clock last read.

    From a window's reset to the new window's first turn the status line writes that window empty (its
    history, 2026-11-13: from 06:50:01 to 10:03:05). The reset read before still says the window is over.
    """
    return {window: quota[window] if used(quota, window) is not None else {"resets_at": reading(seen, window).get("resets_at")}
            for window in WINDOWS}


def no_room(quota, now):
    """The windows that leave a turn no room now, each as (what to say of it, the second it resets or None
    when that cannot be told); none when a turn has room."""
    in_the_way = []
    for window, (name, _) in WINDOWS.items():
        percent, reset = used(quota, window), reset_at(quota, window, now)
        if reset is not None and reset <= now:
            continue  # what the record holds is of a window that has reset since: the new one has room
        if percent is None:
            in_the_way.append((f"the {name} had no reading", None))
        elif percent >= FULL_WINDOW_PCT:
            in_the_way.append((f"the {name} stood at {percent:g}%" + ("" if reset else " with no reset to read"), reset))
    return in_the_way


def session_model(session):
    """The session's model as the status line last wrote it in the session's record -- "Fable 5.2" is "fable" --
    or None when it is not known."""
    try:
        with open(os.path.join(RUNTIME, f"{session}.json")) as handle:
            return json.load(handle)["model"].split()[0].lower()
    except (OSError, ValueError, LookupError, TypeError, AttributeError, IndexError):
        return None


def own_week_in_the_way(session, now):
    """The session model's own week when it leaves a turn no room, as no_room() says a window: [(what to say of it,
    the second it resets)]; [] when it has room or is not known. A reading that is due by dxb-usage's rule is
    fetched first, and waited for: the clock is a background process."""
    model = session_model(session) if session else None
    if model is None:
        return []
    try:
        loader = importlib.machinery.SourceFileLoader("dxb_usage", OWN_WEEKS)
        usage = importlib.util.module_from_spec(importlib.util.spec_from_loader("dxb_usage", loader))
        loader.exec_module(usage)
        if usage.due(now):
            try:
                subprocess.run([OWN_WEEKS, "--refresh"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=FETCH_TIMEOUT_S)
            except (OSError, subprocess.SubprocessError):
                pass  # a refresh that runs out of time or cannot start leaves the record that stands, judged below
        reading = usage.readings(wall_clock()).get(model)  # the moment after the refresh: its record was read after `now`
    except Exception:  # noqa: BLE001 -- an own week that cannot be had is not known, and the clock goes on as before
        return []
    if reading is None or reading["used"] < FULL_WINDOW_PCT:
        return []
    return [(f"{model.capitalize()}'s own week stood at {reading['used']:g}%", reading["resets_at"])]


def quota_line():
    """dxb-quota's one line, for the wake's own line; "" when it cannot be had in time -- it is only shown."""
    try:
        return subprocess.run([QUOTA], capture_output=True, text=True, timeout=QUOTA_LINE_TIMEOUT_S).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def log(event, mode, quota):
    try:
        os.makedirs(RUNTIME, exist_ok=True)
        with open(LOG, "a") as handle:
            handle.write(json.dumps({"ts": datetime.datetime.now().isoformat(timespec="seconds"), "event": event,
                                     "mode": mode, "5h": used(quota, "five_hour"), "7d": used(quota, "seven_day")}) + "\n")
    except OSError:
        pass  # the log is a measurement, never a reason to miss the wake


def clock(epoch):
    return datetime.datetime.fromtimestamp(epoch).strftime("%H:%M")


def session_id():
    """This session, from the Bash tool's environment; None when it is not known or is no plain id."""
    session = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    return session if session.replace("-", "").isalnum() else None


def session_transcript(session):
    """The session's own transcript, whichever project folder holds it; None when there is none."""
    found = glob.glob(os.path.join(glob.escape(PROJECTS), "*", f"{session}.jsonl")) if session else []
    return max(found, key=os.path.getmtime) if found else None


def last_turn_at(transcript):
    """The epoch second of the session's last cache-warming turn; None when it cannot be read.

    This must agree with lastRequestAt in dxb-statusline.js, which the bar's "önbellek N dk" counts
    from: the last `assistant` row in the transcript's tail that is not a subagent's (isSidechain), is
    an answer of the API and not Claude Code's own row for a request that failed (isApiErrorMessage,
    or the model `<synthetic>`: nothing was read, nothing warmed), and carries a time that can be
    read. test-warm-wait.py asks both about the same transcripts.
    """
    try:
        with open(transcript, "rb") as handle:
            size = handle.seek(0, os.SEEK_END)
            handle.seek(max(0, size - TRANSCRIPT_TAIL_BYTES))
            rows = handle.read().decode("utf-8", "replace").split("\n")
    except (OSError, TypeError):
        return None
    for line in reversed(rows):
        if '"assistant"' not in line:
            continue
        try:
            row = json.loads(line)
            message = row.get("message")
            failed = row.get("isApiErrorMessage") is True or (isinstance(message, dict) and message.get("model") == "<synthetic>")
            if row["type"] == "assistant" and row.get("isSidechain") is not True and not failed:
                return datetime.datetime.fromisoformat(row["timestamp"].replace("Z", "+00:00")).timestamp()
        except (ValueError, LookupError, TypeError, AttributeError):
            continue  # the tail's cut first line, a torn last one, a row with no time on it
    return None


def warm_since(transcript, armed_at):
    """When the session's cache was last warmed: its last turn, and never before the arming.

    The arming is itself made by a turn of the session, so a transcript that cannot be read, lags
    or is dated after now falls back to it -- and a stale one cannot make every re-arm ping at once.
    """
    last = last_turn_at(transcript)
    return armed_at if last is None or last > wall_clock() else max(armed_at, last)


# One clock per session. The clock writes itself down in clock_file() -- {"pid", "session", "started",
# "mode", "armed_at", "until"} -- and that record is the session's clock only while is_clock() says so.
# The away marker is away_file(). dxb-away-gate.py reads both files by the same names and the same
# rule; the two must agree, and test-away-gate.py makes the files with this command and asks the gate.

def clock_file(session):
    return os.path.join(RUNTIME, f"warm-wait-{session}.pid")


def away_file(session):
    return os.path.join(RUNTIME, f"away-{session}")


def started(pid):
    """The moment the kernel started the process under that pid (/proc/<pid>/stat, field 22: its ticks
    since boot); None when none runs. A pid is given out again; a pid with its start is one process."""
    try:
        with open(f"/proc/{int(pid)}/stat", "rb") as handle:
            state, *fields = handle.read().rpartition(b")")[2].split()  # what follows the name, which may hold spaces
        return None if state in (b"Z", b"X") else int(fields[18])
    except (OSError, ValueError, TypeError, IndexError):
        return None


def is_clock(record, session):
    """Whether that record is this session's running clock: written for this session, by a process that
    still runs -- its pid alive and started at the moment written down. A name on a command line proves
    neither: another session's clock carries it, and so may the command a dead clock's pid was given to."""
    return record["session"] == session and record["started"] is not None and started(record["pid"]) == record["started"]


def read_clock(session):
    """What the session's clock file holds when that is its running clock; None for anything else."""
    try:
        with open(clock_file(session)) as handle:
            record = json.load(handle)
        return record if is_clock(record, session) else None
    except (OSError, ValueError, LookupError, TypeError):
        return None  # no file, or not a record: not a clock


@contextlib.contextmanager
def clock_folder_lock(patience_s):
    """Hold the lock on the clocks' folder: who holds it is alone in looking at a clock file and then
    changing it. BlockingIOError when it is not free within `patience_s`: no clock waits without an end."""
    folder = os.open(RUNTIME, os.O_RDONLY)
    try:
        give_up = time.monotonic() + patience_s
        while True:
            try:
                fcntl.flock(folder, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= give_up:
                    raise
                time.sleep(0.05)
        yield
    finally:
        os.close(folder)  # which lets the lock go


def live_clock(session):
    """What the session's running clock wrote down, or None; a dead clock's file is removed."""
    if not session:
        return None
    record = read_clock(session)
    if record is None:
        with contextlib.suppress(OSError), clock_folder_lock(0):  # no file or no folder, or the lock is busy: nothing to clean now
            record = read_clock(session)  # again, under the lock: a clock armed meanwhile is no dead file
            if record is None:
                os.remove(clock_file(session))
    return record


def take_clock(session, mode, armed_at, target):
    """Write this clock down as the session's one clock. The clock that already runs, when this mode may
    not take it over (then nothing is written); None when this clock is now the one.

    The look and the write are one step under the folder's lock, so two armings cannot both take the
    session. OSError when the record cannot be written or does not read back as this clock: the caller
    must not sleep on as a clock the gate cannot see.
    """
    if not session:
        return None
    record = {"pid": os.getpid(), "session": session, "started": started(os.getpid()),
              "mode": mode, "armed_at": armed_at, "until": None if target == NO_END else target}
    os.makedirs(RUNTIME, exist_ok=True)
    with clock_folder_lock(LOCK_PATIENCE_S):
        running = read_clock(session)
        if running and (mode, running["mode"]) != ("--until-reset", "--watch"):
            return running
        draft = f"{clock_file(session)}.{os.getpid()}"
        try:
            with open(draft, "w") as handle:
                json.dump(record, handle)
            os.replace(draft, clock_file(session))  # whole or not at all: a half-written file would read as no clock
        except OSError:
            with contextlib.suppress(OSError):
                os.remove(draft)
            raise
        if read_clock(session) != record:
            raise OSError("what was written does not read back as this session's running clock")
    return None


def unregister(session):
    if not session:
        return
    with contextlib.suppress(OSError), clock_folder_lock(LOCK_PATIENCE_S):
        owner = read_clock(session)
        if owner and owner["pid"] == os.getpid():  # never the file of the clock that took over
            os.remove(clock_file(session))


def describe(record, transcript):
    """`<mode> pid <n>, next ping <HH:MM>` of a running clock, as --status and ALREADY_ARMED say it."""
    warm = warm_since(transcript, record["armed_at"])
    until = record.get("until")
    wake, over = next_wake(warm, NO_END if until is None else until)
    ends_first = f" (the wait ends first, {clock(wake)})" if over else ""
    return f"{record['mode']} pid {record['pid']}, next ping {clock(warm + PING_AFTER_S)}{ends_first}"


def sleep_until(when, session=None):
    """Sleep to that wall-clock moment, in steps; Superseded when another clock has taken the session.

    The machine may be suspended, and the wall clock may be set. So the wait is over when EITHER the wall
    clock has come to the moment OR the time that was left has passed on CLOCK_BOOTTIME, which counts a
    suspend and which nothing sets: a wall clock set back cannot lengthen the wait.
    """
    due = boot_clock() + (when - wall_clock())
    while wall_clock() < when and boot_clock() < due:
        time.sleep(min(STEP_S, max(0.0, when - wall_clock()), max(0.0, due - boot_clock())))
        owner = live_clock(session)
        if owner and owner["pid"] != os.getpid():
            raise Superseded(owner["mode"])


def sleep_until_room(session, seen):
    """Sleep on, waking nobody, until a turn has room: (the quota then, the `cold:` note of that sleep or "").

    The session's last wake must not be spent on a turn the quota cuts: a turn that dies arms no clock,
    and the Stop gate does not run on it. A full window is slept to its reset, the latest one when more
    are full; the session model's own week is weighed with the two windows. A window that cannot be read,
    or is full with no reset to sleep to, is read again every QUOTA_RETRY_S, and after BLIND_CEILING_MIN
    of that the session is woken all the same. `seen` is the quota as this clock last read it.
    """
    blind_since, note = None, ""
    while True:
        now = wall_clock()
        seen = keep_resets(seen, read_quota())
        in_the_way = no_room(seen, now) + own_week_in_the_way(session, now)
        if not in_the_way or (blind_since is not None and now - blind_since >= BLIND_CEILING_MIN * 60):
            return seen, note
        said = " and ".join(what for what, _ in in_the_way)
        resets = [reset for _, reset in in_the_way]
        if None in resets:
            blind_since = now if blind_since is None else blind_since
            wake = now + QUOTA_RETRY_S
            note = f" | cold: the quota could not be read for {round((wake - blind_since) / 60)} min ({said})"
        else:
            blind_since, wake = None, past_reset(max(resets))
            note = f" | cold: at {clock(now)} {said} and had no room for a turn"
        sleep_until(wake, session)


def sleep_to_wake(mode, target, armed_at, session, transcript, quota):
    """Sleep to the wait's end, or to the moment the cache is about to go cold; the line that says which.

    `quota` is the quota as it was read at the arming.
    """
    stayed_cold = ""
    pings = 0 if target == NO_END else pings_needed(target - armed_at)  # a --watch weighs each ping on its own
    if not worth_keeping_warm(pings):
        stayed_cold = f" | cold: {pings} pings would cost more than the cold start they save"
        wake, over = target, True
        sleep_until(wake, session)
    else:
        warm = armed_at
        while True:
            wake, over = next_wake(warm, target)
            sleep_until(wake, session)
            newer = warm_since(transcript, armed_at)
            if over or newer <= warm:
                break
            warm = newer  # a turn came meanwhile and warmed the cache by itself: the ping moves with it

    while True:
        quota, no_room_note = sleep_until_room(session, quota)
        if not no_room_note:
            break
        stayed_cold, over = no_room_note, True  # it slept through the ping: what is left of the wait is slept cold
        if target == NO_END or wall_clock() >= target:
            break
        sleep_until(target, session)

    line = quota_line()
    if over:
        log("over", mode, quota)
        return f"WAIT_OVER {clock(wall_clock())}{stayed_cold} | {line}"
    log("ping", mode, quota)
    if target == NO_END:
        return f"WARM_PING {clock(wall_clock())} — work is running, no end set | {line} | re-arm: scripts/ops/dxb-warm-wait --watch"
    left = round((target - wall_clock()) / 60)
    return (f"WARM_PING {clock(wall_clock())} — {left} min to go, until {clock(target)} | {line} | "
            f"re-arm: scripts/ops/dxb-warm-wait --until @{int(target)}")


def wait(argv, session, transcript):
    """Arm the session's clock and print the one line it ends on. The exit code."""
    armed_at = wall_clock()
    quota = read_quota()
    reset = reset_at(quota, "five_hour", armed_at)
    target = parse_target(argv, armed_at, reset if reset is not None and reset > armed_at else None)
    if target is None:
        print(USAGE if argv != ["--until-reset"] else "dxb-warm-wait: no 5-hour reset ahead in the quota record to wait for; give --until HH:MM",
              file=sys.stderr)
        return 2
    mode = argv[0]
    try:
        running = take_clock(session, mode, armed_at, target)
    except OSError as error:
        print(f"NOT_ARMED the clock could not be written down ({error.__class__.__name__}: {error}); this session has no clock")
        return 4
    if running:
        print(f"ALREADY_ARMED {describe(running, transcript)}")
        return 3
    log("armed", mode, quota)
    try:
        print(sleep_to_wake(mode, target, armed_at, session, transcript, quota))
    except Superseded as taken_over:
        print(f"SUPERSEDED by {taken_over}")
    finally:
        unregister(session)
    return 0


def status(session, transcript):
    """--status: the session's clock and its away marker, at once."""
    armed = live_clock(session)
    print(f"ARMED {describe(armed, transcript)}" if armed else "NOT_ARMED")
    print("AWAY on" if session and os.path.exists(away_file(session)) else "AWAY off")
    return 0


def set_away(session, switch):
    """--away on|off: write or remove the marker that says the session was left to work alone."""
    if switch not in (["on"], ["off"]):
        print(USAGE, file=sys.stderr)
        return 2
    if not session:
        print("dxb-warm-wait: no session to mark; CLAUDE_CODE_SESSION_ID is not set", file=sys.stderr)
        return 2
    if switch == ["on"]:
        os.makedirs(RUNTIME, exist_ok=True)
        with open(away_file(session), "w") as handle:
            handle.write(datetime.datetime.now().isoformat(timespec="seconds") + "\n")
    else:
        with contextlib.suppress(FileNotFoundError):
            os.remove(away_file(session))
    print(f"AWAY {switch[0]}")
    return 0


def main(argv):
    transcript = None
    if "--transcript" in argv[:-1]:
        at = argv.index("--transcript")
        transcript, argv = argv[at + 1], argv[:at] + argv[at + 2:]
    session = session_id()
    transcript = transcript or session_transcript(session)
    if argv == ["--status"]:
        return status(session, transcript)
    if argv[:1] == ["--away"]:
        return set_away(session, argv[1:])
    return wait(argv, session, transcript)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
