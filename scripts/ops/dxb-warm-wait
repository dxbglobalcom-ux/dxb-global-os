#!/usr/bin/env python3
"""Keep an away session's prompt cache warm: one small turn 55 minutes after its last one, nothing else.

  --away on | --away off   mark the session away; off ends its clock too
  --watch [--pings N]      the clock; run it in the background, its end wakes the session with one line:
      WARM_PING    55 minutes since the session's last turn (N of 5): run the re-arm command, end the turn;
                   the fifth says `close` instead: the session stood idle for five pings
      WINDOW_RESET the 5-hour window that stood near full has reset: re-arm, go on with the work
  --status                 ARMED or NOT_ARMED, AWAY on or off

A cache that is already cold is never pinged: after a suspend, or a spent quota, the clock sleeps on without
waking anybody until somebody's own turn has warmed the session. A quota that is missing or unreadable holds
nothing (Ultra has no 5-hour window). dxb-away-gate.py reads the two files written here.
"""
import datetime
import glob
import json
import os
import signal
import sys
import time

PING_S = float(os.environ.get("DXB_WARM_WAIT_TEST_PING_AFTER_S", 55 * 60))
STEP_S = float(os.environ.get("DXB_WARM_WAIT_TEST_STEP_S", 20))
COLD_S = float(os.environ.get("DXB_WARM_WAIT_TEST_COLD_S", 60 * 60))    # the prompt cache's life
MOST_PINGS = 5           # his number (CEO, 2026-11-24): a session that stands idle is kept warm five pings
NEAR_FULL = 95           # from here the session opens no new work and the clock wakes it at the reset
RESET_MARGIN_S = float(os.environ.get("DXB_WARM_WAIT_TEST_MARGIN_S", 120))
OWN_TURN_S = 180         # the turn that arms the clock ends within this; a later turn is somebody's
RUNTIME = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "claude-ctx")
SESSION = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
CLOCK = os.path.join(RUNTIME, f"warm-wait-{SESSION}.pid")
AWAY = os.path.join(RUNTIME, f"away-{SESSION}")
HERE = "scripts/ops/dxb-warm-wait"


def started(pid):
    """The kernel's start moment of that process, None when none runs (the gate reads it the same way)."""
    try:
        with open(f"/proc/{int(pid)}/stat", "rb") as handle:
            state, *fields = handle.read().rpartition(b")")[2].split()
        return None if state in (b"Z", b"X") else int(fields[18])
    except (OSError, ValueError, TypeError, IndexError):
        return None


def running_clock():
    try:
        with open(CLOCK) as handle:
            record = json.load(handle)
        alive = record["session"] == SESSION and record["started"] is not None and started(record["pid"]) == record["started"]
        return record if alive else None
    except (OSError, ValueError, LookupError, TypeError):
        return None


def last_turn():
    """The session's last answer of the API, as lastRequestAt in dxb-statusline.js reads it; 0 when unreadable."""
    found = glob.glob(os.path.expanduser(f"~/.claude/projects/*/{SESSION}.jsonl"))
    try:
        with open(max(found, key=os.path.getmtime), "rb") as handle:
            size = handle.seek(0, os.SEEK_END)
            handle.seek(max(0, size - 256 * 1024))
            rows = handle.read().decode("utf-8", "replace").split("\n")
    except (OSError, ValueError):
        return 0
    for line in reversed(rows):
        if '"assistant"' not in line:
            continue
        try:
            row = json.loads(line)
            failed = row.get("isApiErrorMessage") is True or row["message"].get("model") == "<synthetic>"
            if row["type"] == "assistant" and row.get("isSidechain") is not True and not failed:
                at = datetime.datetime.fromisoformat(row["timestamp"].replace("Z", "+00:00")).timestamp()
                return at if at <= time.time() else 0
        except (ValueError, LookupError, TypeError, AttributeError):
            continue
    return 0


def windows():
    """{"five_hour": (percent, reset), ...} for the windows the status line holds a number for."""
    try:
        with open(os.path.join(RUNTIME, "rate-limits.json")) as handle:
            record = json.load(handle)
        return {name: (float(record[name]["used_percentage"]), float(record[name]["resets_at"]))
                for name in ("five_hour", "seven_day")
                if isinstance(record.get(name), dict) and record[name].get("used_percentage") is not None
                and record[name].get("resets_at") is not None}
    except (OSError, ValueError, TypeError, AttributeError, KeyError):
        return {}


def hour(epoch):
    return datetime.datetime.fromtimestamp(epoch).strftime("%H:%M")


def log(event):
    seen = windows()
    with open(os.path.join(RUNTIME, "warm-wait.log"), "a") as handle:
        handle.write(json.dumps({"ts": datetime.datetime.now().isoformat(timespec="seconds"), "event": event,
                                 "5h": seen.get("five_hour", (None,))[0], "7d": seen.get("seven_day", (None,))[0]}) + "\n")


def watch(pings):
    armed, reset, tick = time.time(), None, time.time()
    while True:
        now, turn, seen = time.time(), last_turn(), windows()
        if turn > armed + OWN_TURN_S:
            pings = 0            # somebody's turn: the count starts again
        if now - tick > 10 * STEP_S + 60:
            reset = None         # the machine was suspended: the work is not waked for a reset long past
        tick, idle = now, now - max(armed, turn)
        percent, resets_at = seen.get("five_hour", (0, 0))
        if percent >= NEAR_FULL and resets_at > now:
            reset = resets_at
        if os.path.exists(AWAY):
            if reset and now >= reset + RESET_MARGIN_S:
                return "window_reset", f"WINDOW_RESET {hour(now)} — the 5-hour window is new, go on with the work | re-arm: {HERE} --watch"
            spent = any(used >= 100 and back + RESET_MARGIN_S > now for used, back in seen.values())
            if PING_S <= idle < COLD_S and not spent:
                then = f"re-arm: {HERE} --watch --pings {pings + 1}" if pings + 1 < MOST_PINGS else f"close: {HERE} --away off"
                return "ping", f"WARM_PING {hour(now)} ({pings + 1} of {MOST_PINGS}) | {then}"
        time.sleep(STEP_S)


def main(argv):
    if not SESSION.replace("-", "").isalnum():
        print("no session id in CLAUDE_CODE_SESSION_ID")
        return 2
    os.makedirs(RUNTIME, exist_ok=True)
    if argv[:1] == ["--away"] and argv[1:2] in (["on"], ["off"]):
        if argv[1] == "on":
            with open(AWAY, "w") as handle:
                handle.write(datetime.datetime.now().isoformat(timespec="seconds") + "\n")
        else:
            record = running_clock()
            if record:
                os.kill(record["pid"], signal.SIGTERM)
            for path in (AWAY, CLOCK):
                if os.path.exists(path):
                    os.remove(path)
        print(f"AWAY {argv[1]}")
        return 0
    record = running_clock()
    if argv == ["--status"]:
        due = record and max(record["armed_at"], last_turn()) + PING_S
        print(f"ARMED pid {record['pid']}, next ping {hour(due)}" if record else "NOT_ARMED")
        print("AWAY on" if os.path.exists(AWAY) else "AWAY off")
        return 0
    if argv[:1] != ["--watch"] or (argv[1:] and (len(argv) != 3 or argv[1] != "--pings" or not argv[2].isdigit())):
        print(__doc__)
        return 2
    if record:
        print(f"ALREADY_ARMED pid {record['pid']}")
        return 3
    with open(CLOCK, "w") as handle:
        json.dump({"pid": os.getpid(), "session": SESSION, "started": started(os.getpid()), "armed_at": time.time()}, handle)
    log("armed")
    event, line = watch(int(argv[2]) if argv[1:] else 0)
    log(event)
    os.remove(CLOCK)
    print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
