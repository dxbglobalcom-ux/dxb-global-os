#!/usr/bin/env sh
# DXB Global OS — fail-closed secret-scanning pre-commit hook (SEC-03)
#
# Blocks any commit containing a detectable secret in staged changes.
#
# CLONE BOOTSTRAP (required once per fresh clone):
#   git config core.hooksPath scripts/hooks
# Without this the hook file exists but never fires (RESEARCH Pitfall 7).
#
# Policy:
#   - Fail closed: if gitleaks is missing, the commit is BLOCKED (exit 1).
#     A missing scanner must never let a commit pass unscanned.
#   - --redact is mandatory: hook output never prints a matched secret value
#     (CEO no-values rule).

# (1) Ensure gitleaks resolves for every git client (GUI, agents, cron),
#     regardless of the login-shell PATH.
PATH="$HOME/.local/bin:$PATH"
export PATH

# (2) Fail closed if the scanner is absent.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "ERROR: gitleaks not installed — commit blocked (fail closed)." >&2
  echo "Install: download release from github.com/gitleaks/gitleaks/releases into ~/.local/bin" >&2
  exit 1
fi

# (3) THE CLASS'S RULER RUNS BEFORE THE COMMIT — the CEO's ruling of 2026-09-15
#     (ceo-approvals.json, `ruler-table-holding-wide-2026-09-15`): "every commit runs its
#     class's ruler automatically — no ruler green, no commit". The research engine is a class
#     of its own and its ruler is scripts/research-ruler.sh (~0.3 s). It runs ONLY when that
#     engine, its tests or the ruler itself are in the staged change, so an ordinary commit
#     pays nothing. Measured on 2026-09-17, the day it was written: the engine went into that
#     commit at 10/10 PASS, having been at 4/10 with 18 failures that morning.
RESEARCH_TOUCHED=$(git diff --cached --name-only | grep -E '^\.claude/skills/dxb-research/|^tests/b46/|^scripts/research-ruler\.sh$' || true)
if [ -n "$RESEARCH_TOUCHED" ]; then
  REPO_TOP=$(git rev-parse --show-toplevel)
  if ! bash "$REPO_TOP/scripts/research-ruler.sh"; then
    echo "" >&2
    echo "COMMIT DURDURULDU — arastirma motorunun cetveli kirmizi (yukaridaki tablo)." >&2
    echo "Duzelt, 'bash scripts/research-ruler.sh' yesil yansin, sonra tekrar commit et." >&2
    exit 1
  fi
fi

# (3b) THE RECORDS RULER RUNS BEFORE THE COMMIT — same ruling, second class. The records
#      (.planning/STATE.md, the open board, the approvals ledger) have had their ruler since
#      2026-09-19, on the CEO's order of that day (ceo-approvals.json,
#      `records-ruler-ordered-on-his-word-2026-09-19`): tests/b43/records-truth.ts (~0.3 s), which
#      rings when a record still says his eye is awaited on something the ledger holds as
#      accepted. It runs ONLY when a record or the ruler itself is in the staged change. It reads
#      the working tree, as the research ruler does.
RECORDS_TOUCHED=$(git diff --cached --name-only | grep -E '^\.planning/STATE\.md$|^HOLDING-OS-MASTER-PLAN/00-BOARD-OPEN-WORK\.md$|^scripts/governance/ceo-approvals\.json$|^tests/b43/records-truth' || true)
if [ -n "$RECORDS_TOUCHED" ]; then
  REPO_TOP=$(git rev-parse --show-toplevel)
  if ! node --no-warnings "$REPO_TOP/tests/b43/records-truth.ts"; then
    echo "" >&2
    echo "COMMIT DURDURULDU — kayit cetveli kirmizi (yukaridaki tablo): bir kayit, defterin kabul dedigine hala 'gozunu bekliyor' diyor, ya da bir kabulun cetvelde satiri yok." >&2
    echo "Duzelt, 'node --no-warnings tests/b43/records-truth.ts' yesil yansin, sonra tekrar commit et." >&2
    exit 1
  fi
fi

# (4) Scan staged changes only; redact matched values in all output.
exec gitleaks git --pre-commit --staged --redact --verbose
