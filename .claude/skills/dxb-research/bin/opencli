#!/usr/bin/env python3
# DXB-HIDDEN-CHROME-SHIM — the research tool's one door to opencli. (hidden.py finds copies of this
# file by the marker at the start of this line, so a shim never mistakes another shim for opencli.)
"""
WHY IT EXISTS. 2026-09-24: every research run threw two Chrome windows and an empty `about:blank`
window onto the CEO's screen, because opencli drives HIS Chrome through the Browser Bridge.
sweep.sh, crowd.sh, fetch.py, probe.sh, accept.sh and fleet.sh (and, through CLAUDE_ENV_FILE, the
hunters it launches) put this folder first on PATH, so every `opencli` they run arrives here:

  * a browser-backed command gets its OWN window in the hidden research Chrome (Xvfb :99,
    127.0.0.1:9333) — opened here, handed to opencli as OPENCLI_CDP_ENDPOINT, and closed when
    opencli ends: on success, on error and on timeout alike;
  * an API-only command runs untouched;
  * `opencli browser ...`, every other built-in that could reach the Bridge, sign-in and every
    write verb are REFUSED with exit 3 and a line saying what to use instead;
  * when 127.0.0.1:9333 does not answer: one line, a non-zero exit, and nothing is started.

Why a window per call and not opencli's own `OPENCLI_CDP_ENDPOINT=http://…` mode: that mode picks
ONE existing page (cdp.js selectCDPTarget), so parallel calls would drive and overwrite each other's
tab. The sites themselves are routed to port 9333 by ~/.opencli/apps.yaml (hidden.py apps) — X to a
port where nothing listens, so X is read through this door only.

Every `opencli twitter <command>` also passes the X gate (scripts/xgate.py): one X reader at a time
on the machine, inside his account's budget, and a refused call starts nothing. What X answered is
read from X itself: a second DevTools client on the command's own window watches every response
(a 429 on a later page, which opencli swallows and exits 0), then the window's final address, then a
failed command's words; the worst of the three is recorded. Past xgate.RUNAWAY_MAX X responses in
one command it is stopped.
"""
import contextlib
import os
import signal
import socket
import subprocess
import sys
import threading
import time
from pathlib import Path

sys.dont_write_bytecode = True     # the skill folder is read-only inside a hunter's jail
SCRIPTS = Path(__file__).resolve().parent.parent / "scripts"
sys.path.insert(0, str(SCRIPTS))
import hidden  # noqa: E402
import xgate  # noqa: E402

REFUSED = 3
# The built-ins that never touch a browser. Everything else that is not a site — `browser`,
# `doctor`, `daemon`, `profile`, `plugin`, `adapter`, `external`, ... — is refused.
HARMLESS = {"list", "help", "completion", "--help", "-h", "--version", "-V"}
SLOT_WAIT = 600        # seconds a call queues for one of hidden.SLOTS windows
MAX_SECONDS = 900      # a hung opencli may not hold a window for ever
READER = f"python3 '{SCRIPTS / 'hidden.py'}' read '<adres>'"
BROWSER_MSG = ("`opencli browser` bu makinede kapali: CEO'nun kendi Chrome'unu surer ve ekranina pencere "
               f"acar (2026-09-24). Sayfayi gizli arastirma Chrome'unda oku: {READER} "
               "[--wait SN] [--expand 'See more']")


def say(msg: str) -> None:
    print(f"opencli (dxb): {msg}", file=sys.stderr)


def classify(argv: list[str], root: Path) -> tuple[str, str]:
    """('plain' | 'hidden' | 'refuse', why)."""
    first = argv[0] if argv else "--help"
    if first in HARMLESS:
        return "plain", ""
    if first == "browser":
        return "refuse", BROWSER_MSG
    sites = hidden.commands(root)
    registered = hidden.registered_sites()
    if first not in sites:
        return "refuse", (f"'{first}' opencli'nin bir sitesi degil; buradan yalniz site komutlari ve "
                          "list/help calisir (baska yerlesik komutlar Browser Bridge'e gidebilir)")
    cmd = argv[1] if len(argv) > 1 and not argv[1].startswith("-") else None
    if cmd is None:
        return "plain", ""                      # the site's own help
    entry = sites[first].get(cmd)
    if entry is None:
        # not in the manifest: opencli will answer "unknown command" — but if it is a browser
        # command after all, it must not find its way to the Bridge
        return ("hidden", "") if first in registered else (
            "refuse", f"'{first} {cmd}' opencli'nin listesinde yok ve '{first}' gizli Chrome'a kayitli degil")
    browser_backed, access = entry
    if access == "write" or cmd == "login":
        return "refuse", (f"'{first} {cmd}' bir yazma/giris fiili: arastirma yalniz okur, yazmak CEO'nun "
                          "imzasidir (SKILL.md 8)")
    if not browser_backed:
        return "plain", ""
    if first not in registered:
        return "refuse", (f"'{first}' ~/.opencli/apps.yaml'da gizli Chrome'a kayitli degil; opencli onu "
                          "CEO'nun ekranindaki Browser Bridge'e gonderirdi. Kayit: "
                          f"python3 '{SCRIPTS / 'hidden.py'}' apps")
    return "hidden", ""


def run(real: str, argv: list[str], env: dict) -> int:
    child = subprocess.Popen([real, *argv], env=env)

    def forward(signum, _frame):
        with contextlib.suppress(ProcessLookupError):
            child.send_signal(signum)

    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, forward)
    try:
        rc = child.wait(timeout=MAX_SECONDS)
    except subprocess.TimeoutExpired:
        say(f"opencli {MAX_SECONDS} sn'yi asti; durduruldu, penceresi kapatiliyor")
        child.terminate()
        try:
            child.wait(10)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait()
        return 124
    return 128 - rc if rc < 0 else rc


class Watch:
    """A second DevTools client on an X command's own window, watching its responses while opencli
    drives it. Chrome 153 accepts a second client on a page's websocket and gives it the page's
    Network events, the in-page fetches of the first client included (measured 2026-10-18)."""

    def __init__(self, ws: str):
        try:
            self.cdp = hidden.CDP(ws)
            self.cdp.send("Network.enable", {}, 10)
        except (hidden.CDPError, OSError) as e:
            # fail closed: an X call nobody watches is the call that drew 429 twice on 2026-10-18
            raise xgate.Refused(f"X cagrisi yapilmadi: penceresi izlenemiyor (ikinci DevTools baglantisi: {e})") from None
        self.responses: list[tuple[str, int]] = []
        self.x_requests = 0
        self.runaway = False
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._drain, daemon=True)
        self._thread.start()

    def _note(self, m: dict) -> None:
        r = hidden.response_of(m)
        if r:
            self.responses.append(r)
            if xgate.is_x_url(r[0]):
                self.x_requests += 1
                self.runaway = self.runaway or self.x_requests > xgate.RUNAWAY_MAX

    def _drain(self) -> None:
        signal.pthread_sigmask(signal.SIG_BLOCK, hidden._HELD)   # hidden.Tab: threads hold these
        # A short timeout, so the stop is seen; a timeout inside recv leaves a partial frame in
        # CDP._buf, whole for the next pass.
        self.cdp.sock.settimeout(0.2)
        while not self._stop.is_set():
            try:
                m = self.cdp._message()
            except (socket.timeout, TimeoutError):
                continue
            except (hidden.CDPError, OSError, ValueError):
                return
            self._note(m)

    def finish(self) -> list[tuple[str, str]]:
        """Stop watching, ask the window where it ended up, close. Returns the (verdict, detail)
        pairs: what the responses showed and what the final address shows."""
        self._stop.set()
        self._thread.join(5)
        href = ""
        with contextlib.suppress(hidden.CDPError, OSError, ValueError):
            href = str(self.cdp.evaluate("location.href", 10) or "")
        for m in self.cdp.events:          # events that came in while evaluate waited
            self._note(m)
        self.cdp.close()
        seen, _, seen_at = xgate.judge_responses(self.responses)
        return [(seen, seen_at), (xgate.judge_url(href), href)]


def _stop(child: subprocess.Popen) -> tuple[bytes, bytes]:
    child.terminate()
    try:
        return child.communicate(timeout=10)
    except subprocess.TimeoutExpired:
        child.kill()
        return child.communicate()


def run_captured(real: str, argv: list[str], env: dict, watch: Watch | None = None) -> tuple[int, str]:
    """run(), with the output held back until opencli ends so the X gate can read it, then passed on
    unchanged. Returns (exit code, stderr + stdout). With a watch, a command that runs away past
    xgate.RUNAWAY_MAX X responses is stopped like a hung one, exit 75."""
    child = subprocess.Popen([real, *argv], env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)

    def forward(signum, _frame):
        with contextlib.suppress(ProcessLookupError):
            child.send_signal(signum)

    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, forward)
    end = time.monotonic() + MAX_SECONDS
    while True:
        try:
            # a watched command is looked at every second (communicate keeps what it read so far)
            out, err = child.communicate(timeout=max(0.01, min(1.0 if watch else MAX_SECONDS,
                                                               end - time.monotonic())))
        except subprocess.TimeoutExpired:
            if watch is not None and watch.runaway:
                say(f"tek komut X'e {xgate.RUNAWAY_MAX}'dan fazla istek yapti ({watch.x_requests}); "
                    "opencli durduruldu, penceresi kapatiliyor")
                out, err = _stop(child)
                rc = 75
                break
            if time.monotonic() < end:
                continue
            say(f"opencli {MAX_SECONDS} sn'yi asti; durduruldu, penceresi kapatiliyor")
            out, err = _stop(child)
            rc = 124
            break
        rc = 128 - child.returncode if child.returncode < 0 else child.returncode
        break
    sys.stdout.buffer.write(out)
    sys.stdout.flush()
    sys.stderr.buffer.write(err)
    sys.stderr.flush()
    return rc, err.decode("utf-8", "replace") + "\n" + out.decode("utf-8", "replace")


def is_x_call(argv: list[str]) -> bool:
    """A site command on X (its bare help does not reach X)."""
    return len(argv) > 1 and argv[0] in xgate.X_SITES and not argv[1].startswith("-")


def through_x_gate(argv: list[str], go) -> int:
    """Run `go` inside the X gate and record the worst thing X answered. `go` returns run_captured's
    pair, and from a watched window also (the watch's (verdict, detail) pairs, its X requests)."""
    try:
        with xgate.call("opencli " + " ".join(argv[:3])) as gate:
            rc, text, *watched = go()
            found = [xgate.text_verdict(text) if rc != 0 else ("ok", "")]
            if watched:
                found += watched[0]
                gate.requests = watched[1]
            gate.report(*xgate.worst(found))
            return rc
    except xgate.Refused as e:
        say(str(e))
        return xgate.REFUSED


def _exit_now(signum, _frame):
    raise SystemExit(128 + signum)   # unwinds the `with` blocks: a window already opened is closed


def main() -> int:
    for s in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, _exit_now)
    argv = sys.argv[1:]
    real = hidden.next_opencli()
    if not real:
        say("gercek opencli PATH'te bulunamadi")
        return 127
    if argv[:1] == ["browser"]:
        say(BROWSER_MSG)
        return REFUSED
    root = hidden.package_root(real)
    if root is None:
        # a stand-in (the test benches and the ruler put one first on PATH): nothing behind it can
        # reach a browser, and it must answer exactly as it would without this door — unless a test
        # points the X gate at its own folder to prove the gate
        if is_x_call(argv) and os.environ.get("DXB_XGATE_DIR"):
            return through_x_gate(argv, lambda: run_captured(real, argv, dict(os.environ)))
        os.execv(real, [real, *argv])
    kind, why = classify(argv, root)
    if kind == "refuse":
        say(why)
        return REFUSED
    x = is_x_call(argv)
    if kind == "plain":
        if x:
            return through_x_gate(argv, lambda: run_captured(real, argv, dict(os.environ)))
        os.execv(real, [real, *argv])
    if not hidden.apps_valid(root):
        say(f"{hidden.APPS_YAML} opencli'nin kendi YAML okuyucusundan gecmiyor; opencli onu sessizce yok "
            "sayar ve her tarayici cagrisini CEO'nun ekranina gonderir. Yeniden yaz: "
            f"python3 '{SCRIPTS / 'hidden.py'}' apps")
        return REFUSED
    if not hidden.version():
        say(hidden.DOWN_MSG)
        return 69
    def in_a_window(capture: bool):
        hidden.reap()
        with hidden.slot(SLOT_WAIT):
            with hidden.Tab() as tab:
                env = dict(os.environ, OPENCLI_CDP_ENDPOINT=tab.ws)
                env.pop("OPENCLI_CDP_TARGET", None)
                if not capture:
                    return run(real, argv, env)
                watch = Watch(tab.ws)          # before opencli starts: a refused watch starts nothing
                try:
                    rc, text = run_captured(real, argv, env, watch)
                finally:
                    found = watch.finish()     # before the window closes: its final address
                return rc, text, found, watch.x_requests

    try:
        if x:
            return through_x_gate(argv, lambda: in_a_window(True))
        return in_a_window(False)
    except hidden.Down:
        say(hidden.DOWN_MSG)
        return 69
    except hidden.SlotTimeout as e:
        say(str(e))
        return 75
    except (hidden.CDPError, OSError) as e:
        say(f"gizli Chrome'da pencere acilamadi: {e}")
        return 69


if __name__ == "__main__":
    raise SystemExit(main())
