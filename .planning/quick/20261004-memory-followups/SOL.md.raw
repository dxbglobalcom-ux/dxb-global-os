   180	interface StreamMessage {
   181	  type?: unknown;
   182	  subtype?: unknown;
   183	  session_id?: unknown;
   184	  tools?: unknown;
   185	  mcp_servers?: unknown;
   186	  plugins?: unknown;
   187	  skills?: unknown;
   188	  agents?: unknown;
   189	  usage?: { input_tokens?: unknown; cache_creation_input_tokens?: unknown; cache_read_input_tokens?: unknown };
   190	}
   191	
   192	const count = (v: unknown): number => (Array.isArray(v) ? v.length : 0);
   193	const tokens = (v: unknown): number => (typeof v === "number" && Number.isFinite(v) ? v : 0);
   194	
   195	/**
   196	 * One line per company model call — what the run loaded and what it read — so the resident itself
   197	 * proves the separation. The scheduler's stdout is `var/scheduler.log` (the unit's
   198	 * `StandardOutput=append:`; the journal carries only systemd's own lines):
   199	 * `grep '\[isolation\]' var/scheduler.log`. `session=` is the run's own id, so "no transcript was
   200	 * left" is checked by name — `~/.claude/projects/<any>/<session>.jsonl` and `<session>/` absent.
   201	 * `home=` is the company Claude home the call ran from (phase 3; `refused` when it was refused).
   202	 * `hooks=` counts the hooks that started: SessionStart hooks are always streamed (sdk.d.ts
   203	 * `includeHookEvents`), and a leaking run fired the construction's.
   204	 *
   205	 * Feed it every message of the stream; it speaks once, at the result. It is a witness, never a
   206	 * participant: whatever a message holds or the sink throws, the call's own answer is untouched
