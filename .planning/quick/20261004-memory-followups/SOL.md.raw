   249	// are ~20 tool calls — so a surface carrying media_submit gets 40 turns. The lease
   250	// heartbeat (A15) and media_wait keep such a run alive; the budget only stops it
   251	// from being cut off before the first cut.
   252	export const TURN_BUDGET = { toolless: 4, default: 12, hands: 40 } as const;
   253	export function turnBudgetFor(allowedTools: readonly string[]): number {
   254	  return allowedTools.some((t) => t.endsWith("__media_submit")) ? TURN_BUDGET.hands : TURN_BUDGET.default;
