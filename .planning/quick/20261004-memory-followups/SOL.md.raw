    81	/** A ref of the writer's exact shape, of the expected kind, joined to the root. */
    82	function notePath(ref: string, kind: string, root: string): string {
    83	  const m = NOTE_REF_RE.exec(ref);
    84	  if (!m) throw new Error(`memory note: ref is not a memory-store/<kind>/<uuid>.md note: ${ref}`);
    85	  if (m[1] !== kind) throw new Error(`memory note: ref is a ${m[1]} note, this store holds ${kind}: ${ref}`);
    86	  return path.join(root, ref);
    87	}
    88	
    89	/** The path the descriptor really opened — whatever the name pointed at meanwhile. */
    90	function openedPath(fd: number): Promise<string> {
    91	  return readlink(`/proc/self/fd/${fd}`);
    92	}
    93	
    94	/** Read one note by its ref: only a note of the writer's shape and of this
    95	 *  store's kind, opened once without following a link, whose descriptor sits
    96	 *  exactly at <real root>/<ref> and is a regular file. Loud otherwise. */
    97	export async function readNote(ref: string, kind: string): Promise<string> {
    98	  const root = memoryRoot();
    99	  notePath(ref, kind, root);
   100	  const expected = path.join(await realpath(root), ref);
   101	  const handle = await open(expected, constants.O_RDONLY | constants.O_NOFOLLOW).catch((e: NodeJS.ErrnoException) => {
   102	    throw new Error(`memory note: ${ref} cannot be opened as a note in the memory root (${e.code ?? e.message})`);
   103	  });
   104	  try {
   105	    const opened = await openedPath(handle.fd);
   106	    if (opened !== expected) throw new Error(`memory note: ${ref} opened ${opened}, not ${expected}`);
   107	    if (!(await handle.stat()).isFile()) throw new Error(`memory note: ${ref} is not a regular file`);
   108	    return await handle.readFile("utf8");
   109	  } finally {
   110	    await handle.close();
   111	  }
   112	}
   113	
   114	/** Frontmatter values are serialized with JSON.stringify — JSON scalars/objects
   115	 *  are valid YAML flow syntax, so user content can never break the frontmatter
   116	 *  (card pitfall: no string-concat of unescaped content). */
   117	function frontmatter(args: ObsidianNoteArgs): string {
   118	  return [
   119	    "---",
   120	    `id: ${JSON.stringify(args.indexId)}`,
   121	    `kind: ${JSON.stringify(args.kind)}`,
   122	    `trust_tier: ${JSON.stringify(args.trustTier)}`,
   123	    `provenance: ${JSON.stringify(args.provenance)}`,
   124	    `created_at: ${JSON.stringify(args.createdAt)}`,
   125	    "---",
   126	    "",
   127	  ].join("\n");
   128	}
   129	
   130	/** Write one memory note under the memory root; returns the root-relative ref.
   131	 *  Never overwrites: an indexId collision is a hard error (O_EXCL). */
   132	export async function writeNote(args: ObsidianNoteArgs): Promise<string> {
   133	  if (!UUID_RE.test(args.indexId)) throw new Error(`obsidian adapter: indexId is not a uuid: ${args.indexId}`);
   134	  if (!KIND_RE.test(args.kind)) throw new Error(`obsidian adapter: invalid kind: ${args.kind}`);
   135	  const root = memoryRoot();
   136	  const rel = path.posix.join(MEMORY_STORE_ROOT, args.kind, `${args.indexId}.md`);
   137	  notePath(rel, args.kind, root);
   138	  // The root is the configured folder itself; below it, one level at a time, each a real folder.
   139	  await mkdir(root, { recursive: true });
   140	  const base = await realpath(root);
   141	  let dir = base;
   142	  for (const part of [MEMORY_STORE_ROOT, args.kind]) {
   143	    dir = path.join(dir, part);
   144	    await mkdir(dir).catch((e: NodeJS.ErrnoException) => {
   145	      if (e.code !== "EEXIST") throw e;
   146	    });
   147	    const st = await lstat(dir);
   148	    if (st.isSymbolicLink() || !st.isDirectory()) {
   149	      throw new Error(`memory note: ${dir} is not a real folder inside the memory root`);
   150	    }
   151	  }
   152	  const expected = path.join(base, rel);
   153	  const handle = await open(
   154	    expected,
   155	    constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL | constants.O_NOFOLLOW,
   156	    0o644,
   157	  );
   158	  try {
   159	    const opened = await openedPath(handle.fd);
   160	    if (opened !== expected) {
   161	      await unlink(opened).catch(() => undefined);
   162	      throw new Error(`memory note: the write for ${rel} opened ${opened}, not ${expected}`);
   163	    }
   164	    await handle.writeFile(frontmatter(args) + args.body + "\n");
   165	  } finally {
   166	    await handle.close();
   167	  }
   168	  return rel;
   169	}

