   229	        try {
   230	          home = companyClaudeHome();
   231	        } catch {
   232	          // a refused home is the call's own error
   233	        }
   234	        log(`[isolation] lane=${lane} session=${session} ${loaded} hooks=${hooks} input=${input} home=${home}`);
   235	      }
   236	    } catch {
   237	      // the line is lost; the company's answer is not
   238	    }
   239	  };
   240	}

