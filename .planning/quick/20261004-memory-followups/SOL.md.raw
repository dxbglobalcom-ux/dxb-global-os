    10	import { join } from "node:path";
    11	
    12	const ROOT = join(import.meta.dirname, "..", "..", "..");
    13	const fail = (why) => {
    14	  console.log(`PROBE_ABORT ${why}`);
    15	  process.exit(2);
    16	};
    17	
    18	const dbUrl = new URL(process.env.DXB_DATABASE_URL ?? "postgresql://x@nowhere:1/x");
    19	if (dbUrl.port !== "54422") fail(`DXB_DATABASE_URL is not the construction engine (port ${dbUrl.port})`);
    20	if (process.env.DXB_COMPANY_DATABASE_URL) fail("DXB_COMPANY_DATABASE_URL is set — the company must not be reachable");
    21	if (process.cwd() !== ROOT) fail(`cwd ${process.cwd()} is not the residents' WorkingDirectory`);
    22	
    23	const stamp = randomUUID().slice(0, 8);
    24	const memRoot = join(ROOT, "var", `note-probe-${stamp}`);
    25	mkdirSync(memRoot);
    26	process.env.DXB_MEMORY_ROOT = memRoot;
    27	
    28	const dist = (pkg, file) => join(ROOT, "packages", pkg, "dist", file);
    29	const { companyClaudeHome } = await import(dist("kernel", "sdk-isolation.js"));
    30	const { getDb } = await import(dist("shared", "index.js"));
    31	const { recallMemory } = await import(dist("memory-router", "index.js"));
    32	const { defaultExecutor } = await import(dist("orchestrator", "worker-shim.js"));
    33	
    34	const receipts = [];
    35	const log = console.log.bind(console);
    36	console.log = (...a) => {
    37	  const line = a.map(String).join(" ");
    38	  if (line.startsWith("[isolation]")) receipts.push(line);
    39	  log(...a);
    40	};
    41	
    42	// the company's drawer, counted (names only) — it must not move
    43	const companyHome = companyClaudeHome();
    44	const drawerCount = () => {
    45	  let n = 0;
    46	  for (const sub of ["artifact", "relation"]) {
    47	    const d = join(companyHome, "memory-store", sub);
    48	    if (existsSync(d)) n += readdirSync(d).length;
    49	  }
    50	  return n;
    51	};
    52	const companyBefore = drawerCount();
    53	
    54	const db = getDb();
    55	const seat = await db.selectFrom("agents").select(["id", "slug", "department"]).where("slug", "=", "finance-financial-analyst").executeTakeFirstOrThrow();
    56	const anyTask = await db.selectFrom("tasks").select(["id"]).orderBy("created_at").limit(1).executeTakeFirstOrThrow();
    57	const t0 = (await db.selectNoFrom((eb) => eb.fn("now", []).as("t")).executeTakeFirst()).t;
    58	const canary = `NOTE_PROBE_${stamp}`;
    59	
    60	const out = await defaultExecutor({
    61	  id: anyTask.id,
    62	  department: seat.department,
    63	  objective:
    64	    `Call the tool mcp__dxb-mcp__memory_commit exactly once with this input: ` +
    65	    JSON.stringify({
    66	      facts: [],
    67	      artifact: { path: `note-probe/${canary}.md`, body: `${canary} — the employee's note from a real task.` },
    68	      provenance: { agent: seat.slug, task_id: null, origin: "agent", source: "reasoning" },
    69	    }) +
    70	    ` Then reply with the JSON the tool returned, nothing else.`,
    71	  output_contract: "result: the tool's JSON; confidence 0-1; evidence: [the tool call]; acceptance_map: {}",
    72	  model_tier: "L4",
    73	  approval_class: "none",
    74	  budget_max_tokens: 4000,
    75	  priority: 5,
    76	  status: "running",
    77	  agent_id: seat.id,
    78	});
    79	console.log(`task lane: toolSurfaceMounted=${out.toolSurfaceMounted} result=${JSON.stringify(out.result?.text ?? out.result).slice(0, 300)}`);
    80	
    81	// what the employee's child wrote, read from the engine and the drawer
    82	const rows = await db
    83	  .selectFrom("memory_index")
    84	  .select(["id", "store", "ref", "trust_tier"])
    85	  .where("store", "=", "obsidian")
    86	  .where("created_at", ">=", t0)
    87	  .execute();
    88	console.log(`memory_index rows since the call: ${JSON.stringify(rows)}`);
    89	const onDisk = rows.map((r) => {
    90	  const file = join(memRoot, r.ref);
    91	  return { ref: r.ref, exists: existsSync(file), holdsCanary: existsSync(file) && readFileSync(file, "utf8").includes(canary) };
    92	});
    93	console.log(`in the handed root: ${JSON.stringify(onDisk)}`);
    94	
    95	// the scheduler side — the same recall Hamza's lanes call
    96	const recall = await recallMemory(db, { query: canary, kind: "artifact", limit: 5 }, { caller: "note-probe" });
    97	const found = recall.rows.filter((r) => r.body.includes(canary));
    98	console.log(`scheduler-side recall: rows=${recall.rows.length} holding the canary=${found.length}`);
    99	
   100	const companyAfter = drawerCount();
   101	console.log(`company drawer files: before=${companyBefore} after=${companyAfter}`);
   102	
   103	const ok = rows.length === 1 && onDisk[0]?.holdsCanary === true && found.length === 1 && companyBefore === companyAfter;
   104	console.log(ok ? "NOTE_PROBE_OK" : "NOTE_PROBE_FAIL");
   105	
   106	// removal: the probe's index row, its cost row, its root
   107	if (rows.length) await db.deleteFrom("memory_index").where("id", "in", rows.map((r) => r.id)).execute();
   108	await db.deleteFrom("cost_ledger").where("task_id", "=", anyTask.id).where("created_at", ">=", t0).execute();
   109	rmSync(memRoot, { recursive: true, force: true });
   110	console.log(`removed: memory_index ${rows.length} · root ${existsSync(memRoot) ? "STILL THERE" : "gone"}`);
   111	
   112	console.log(`SESSIONS ${receipts.map((r) => r.match(/session=(\S+)/)?.[1]).join(" ")}`);
   113	await db.destroy();
   114	console.log("PROBE_DONE");
   115	if (!ok) process.exit(1);

