   138	 * home's own knob. Nothing else: no HOME, XDG_*, GIT_*, NODE_OPTIONS, ANTHROPIC_*, CLAUDE*.
   139	 */
   140	const COMPANY_ENV = new Set([
   141	  "PATH", "TMPDIR", "LANG", "TERM", "TZ", "USER", "LOGNAME", "SHELL",
   142	  "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "ALL_PROXY", "http_proxy", "https_proxy", "no_proxy", "all_proxy",
   143	  "NODE_EXTRA_CA_CERTS", "LITELLM_BASE_URL",
   144	]);
   145	const companyEnvName = (k: string): boolean =>
   146	  COMPANY_ENV.has(k) || k.startsWith("LC_") || k.startsWith("SSL_CERT_") || (k.startsWith("DXB_") && k !== "DXB_COMPANY_CLAUDE_HOME");
   147	
   148	export function companyIsolation(env: NodeJS.ProcessEnv = process.env): SdkIsolation | null {
   149	  if (env.DXB_WORKER_ISOLATION === "0") return null;
   150	  const home = companyClaudeHome(env);
   151	  const work = join(home, "work");
   152	  const carried: Record<string, string> = {};
   153	  for (const [k, v] of Object.entries(env)) {
   154	    if (v !== undefined && companyEnvName(k)) carried[k] = v;
   155	  }
   156	  return {
   157	    settingSources: [],
   158	    settings: { autoMemoryEnabled: false },
   159	    persistSession: false,
   160	    strictMcpConfig: true,
   161	    cwd: work,
   162	    env: { ...carried, CLAUDE_CONFIG_DIR: home, HOME: home, XDG_CACHE_HOME: join(home, "cache"), PWD: work },
   163	  };
   164	}
