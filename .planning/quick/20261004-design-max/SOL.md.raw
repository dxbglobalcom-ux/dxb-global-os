     1	#!/usr/bin/env python3
     2	"""DXB design-at-max mode (PostToolUse Skill / UserPromptSubmit / `close`): design turns run at max.
     3	
     4	The CEO's order of 2026-10-03 (design-plan-architecture-at-max-2026-10-03): design, plan and
     5	architecture run at Opus max, the orchestration after them at high -- without his hand on /effort.
     6	A session cannot hold max on its own. A skill whose frontmatter says `effort: max` runs the rest of
     7	its turn at max, and Claude Code clears it at his next message (measured 2026-10-04: a headless
     8	session at high, the model invoking such a skill itself -- transcript effort high, then max for every
     9	later step of the turn, high again on the next prompt; .planning/quick/20261004-design-max/). His word
    10	to that answer, "bunu yapalım tmm." (design-max-skill-every-turn-2026-10-04): the lead invokes the
    11	`dxb-design-max` skill first in every design turn, and this hook keeps the mode alive across turns:
    12	
    13	  * PostToolUse on Skill: the call of `dxb-design-max` opens the mode for that session -- a flag file
    14	    $XDG_RUNTIME_DIR/dxb-design-max/<session_id> (/tmp/dxb-design-max/ without XDG_RUNTIME_DIR).
    15	  * UserPromptSubmit: while the session's flag stands, each of his messages carries a reminder into
    16	    the session's context -- invoke the skill first, or, when this message is his yes to the plan,
    17	    close the mode and go on at the session's own level.
    18	  * `dxb-design-max.py close`, run by the lead from Bash: removes the flag of the session named by
    19	    CLAUDE_CODE_SESSION_ID (the same id the hook receives on stdin, measured 2026-10-04).
    20	
    21	Only a session id shaped like Claude Code's (SESSION_ID) ever names a flag, so no path leaves the
    22	flag folder. The flags live in the runtime directory: a reboot clears them, a resumed session keeps
    23	its own. Stdlib only. As a hook it never fails a session: on any failure it exits 0 with nothing on
    24	stdout or stderr. `close` answers on stdout, and refuses with exit 2 when it has no valid session id.
    25	"""
    26	
    27	import json
    28	import os
    29	import re
    30	import sys
    31	
    32	SKILL = "dxb-design-max"
    33	SESSION_ID = re.compile(r"[0-9a-f-]{8,}", re.IGNORECASE)
    34	FLAG_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "dxb-design-max")
    35	CLOSE_COMMAND = f'python3 "{os.path.abspath(__file__)}" close'
    36	
    37	
    38	def reminder():
    39	    return (
    40	        f"🟣 DESIGN AT MAX is open for this session (dxb-team2 §4 PLAN). If this message continues "
    41	        f"design, plan or architecture work, invoke Skill {SKILL} as your FIRST step, so the rest of the "
    42	        f"turn runs at max. If this message is the CEO's yes to the plan, close the mode instead, as your "
    43	        f"first step -- `{CLOSE_COMMAND}` -- and go on at the session's own level.")
    44	
    45	
    46	def flag_path(session_id):
    47	    """The session's flag, or None when the id could name anything but a file in the flag folder."""
    48	    if not isinstance(session_id, str) or not SESSION_ID.fullmatch(session_id):
    49	        return None
    50	    return os.path.join(FLAG_DIR, session_id)
    51	
    52	
    53	def on_hook(data):
    54	    flag = flag_path(data.get("session_id"))
    55	    if flag is None:
    56	        return
    57	    event = data.get("hook_event_name")
    58	    tool_input = data.get("tool_input")
    59	    if (event == "PostToolUse" and data.get("tool_name") == "Skill"
    60	            and isinstance(tool_input, dict) and tool_input.get("skill") == SKILL):
    61	        os.makedirs(FLAG_DIR, mode=0o700, exist_ok=True)
    62	        with open(flag, "w", encoding="utf-8"):
    63	            pass
    64	    elif event == "UserPromptSubmit" and os.path.isfile(flag):
    65	        output = {"hookSpecificOutput": {"hookEventName": event, "additionalContext": reminder()}}
    66	        sys.stdout.write(json.dumps(output) + "\n")
    67	
    68	
    69	def close():
    70	    flag = flag_path(os.environ.get("CLAUDE_CODE_SESSION_ID"))
    71	    if flag is None:
    72	        sys.stderr.write("dxb-design-max close: no valid CLAUDE_CODE_SESSION_ID in the environment\n")
    73	        return 2
    74	    try:
    75	        os.remove(flag)
    76	    except FileNotFoundError:
    77	        print("design at max: not open for this session")
    78	        return 0
    79	    print("design at max: closed -- the session goes on at its own level")
    80	    return 0
    81	
    82	
    83	def main():
    84	    raw = sys.stdin.buffer.read()
    85	    if not raw.strip():
    86	        return
    87	    data = json.loads(raw)
    88	    if isinstance(data, dict):
    89	        on_hook(data)
    90	
    91	
    92	if __name__ == "__main__":
    93	    if sys.argv[1:] == ["close"]:
    94	        sys.exit(close())
    95	    try:
    96	        main()
    97	        sys.stdout.flush()
    98	    except Exception:
    99	        pass
   100	    os._exit(0)
