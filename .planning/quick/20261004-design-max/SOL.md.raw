import runpy,io,contextlib
from unittest.mock import patch
from threading import Thread,Event
g=runpy.run_path('.claude/hooks/dxb-design-max.py',run_name='audit')
sid='5e1f0a2b-d351-4000-8000-000000000000'
entered=Event(); release=Event(); result=[]
# Intercept the real hook's open to simulate POSIX opening a FIFO with no reader.
def fifo_open(*args,**kwargs):
 entered.set(); release.wait(); return io.StringIO()
def worker():
 g['on_hook']({'session_id':sid,'hook_event_name':'PostToolUse','tool_name':'Skill','tool_input':{'skill':g['SKILL']}});result.append('returned')
with patch('os.makedirs'),patch('builtins.open',fifo_open):
 t=Thread(target=worker,daemon=True); t.start(); entered.wait(1);t.join(.15)
 print('READ_ONLY FIFO simulation: reached blocking open=',entered.is_set(),'hook still waiting=',t.is_alive())
 release.set();t.join(1)
print('No real FIFO created or opened; this measures the unguarded blocking call, not a filesystem end-to-end test')
