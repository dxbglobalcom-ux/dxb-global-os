   152	    );
   153	  }
   154	
   155	  const basePrompt = classifyPrompt(text, taskClasses, deptSlugs);
   156	
   157	  let lastError = "";
   158	  for (let attempt = 0; attempt < 2; attempt++) {
   159	    const prompt =
   160	      attempt === 0
   161	        ? basePrompt
   162	        : `${basePrompt}\n\nYour previous JSON failed schema validation:\n${lastError}\nReturn corrected JSON only.`;
