   133	  // Legal task classes are live data — whatever routing_rules can route.
   134	  const taskClasses = [...new Set(rules.map((r) => r.task_class))].sort();
   135	
   136	  const ownCi = {
   137	    intent_summary: "kernel classification call",
   138	    departments: deptSlugs.length > 0 ? [deptSlugs[0]] : ["engineering"],
   139	    approval_class: "none" as const,
   140	    complexity: "single" as const,
   141	  };
   142	  let own: ResolvedRoute;
