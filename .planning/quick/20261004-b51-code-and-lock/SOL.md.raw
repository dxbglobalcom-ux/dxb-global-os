    59	// Unicode lookarounds, not \b: ASCII \b never fires at the edge of 'önceki'.
    60	const BACK_REFERENCE =
    61	  /(?<![\p{L}\p{N}])(yukarıda|yukarıya|önceki|above|previous step|as mentioned)(?![\p{L}\p{N}])/iu;
    62	
    63	const APPROVAL_RANK = { none: 0, internal: 1, outward: 2 } as const;
    64	type ApprovalClass = keyof typeof APPROVAL_RANK;
    65	
    66	function raiseApproval(base: ApprovalClass, draft: ApprovalClass): ApprovalClass {
    67	  return APPROVAL_RANK[draft] > APPROVAL_RANK[base] ? draft : base;
    68	}
    69	
    70	/** Longest dependency chain, counted in envelopes (a lone task = 1). Exported for unit tests. */
    71	export function chainDepth(deps: number[][]): number {
    72	  const depth: number[] = [];
    73	  for (let i = 0; i < deps.length; i++) {
    74	    let longest = 0;
    75	    for (const d of deps[i]) {
    76	      // forward-only is validated in lintBatch; guard here keeps the DP total.
    77	      if (d < i) longest = Math.max(longest, depth[d]);
    78	    }
    79	    depth[i] = longest + 1;
    80	  }
    81	  return depth.length === 0 ? 0 : Math.max(...depth);
    82	}
    83	
    84	/**
    85	 * Structural + self-contained lint over a draft batch. Returns human-readable
    86	 * failure lines ([] = clean). Exported for unit tests.
    87	 */
    88	export function lintBatch(drafts: Pick<EnvelopeDraft, "objective" | "deps">[]): string[] {
    89	  const failures: string[] = [];
    90	  if (drafts.length > MAX_ENVELOPES) {
    91	    failures.push(`batch of ${drafts.length} envelopes exceeds the cap of ${MAX_ENVELOPES}`);
    92	  }
    93	  drafts.forEach((d, i) => {
    94	    const backref = d.objective.match(BACK_REFERENCE);
    95	    if (backref) {
    96	      failures.push(
    97	        `envelope[${i}] objective is not self-contained (back-reference '${backref[0]}'): "${d.objective}"`,
    98	      );
    99	    }
   100	    for (const dep of d.deps) {
   101	      if (dep >= i) failures.push(`envelope[${i}] deps must reference EARLIER items only, got ${dep}`);
   102	    }
   103	  });
   104	  if (failures.length === 0) {
   105	    const depth = chainDepth(drafts.map((d) => d.deps));
   106	    if (depth > MAX_HOP_DEPTH) {
   107	      failures.push(`dependency chain depth ${depth} exceeds the hop cap of ${MAX_HOP_DEPTH}`);
   108	    }
   109	  }
   110	  return failures;
   111	}
   112	
   113	// Same SDK access pattern as kernel classify.ts: subscription-mode only,
   114	// structured output with a mechanical fence-unwrap fallback — Zod stays the
   115	// sole decision gate.
   116	async function runDraftQuery(prompt: string, own: ResolvedRoute): Promise<unknown> {
   117	  const q = query({
   118	    prompt,
   119	    options: {
   120	      // CEO 2026-10-03: nothing of the construction is loaded into a company call (kernel sdk-isolation.ts)
   121	      ...(companyIsolation() ?? {}),
   122	      model: SDK_MODEL_IDS[own.model] ?? own.model,
   123	      effort: own.effort as "low" | "medium" | "high" | "xhigh" | "max",
   124	      tools: [],
   125	      maxTurns: 4,
   126	      outputFormat: { type: "json_schema", schema: sdkJsonSchema(DraftBatch) },
   127	    },
   128	  });
   129	  const seen = isolationReceipt("decompose");
   130	  for await (const msg of q) {
   131	    seen(msg);
   132	    if (msg.type === "result") {
   133	      if (msg.subtype === "success") {
   134	        if (msg.structured_output !== undefined) return msg.structured_output;
   135	        const text = msg.result.trim();
   136	        const fenced = text.match(/```(?:json)?\s*([\s\S]*?)```/);
   137	        try {
   138	          return JSON.parse((fenced ? fenced[1] : text).trim());
   139	        } catch {
   140	          return msg.result;
   141	        }
   142	      }
   143	      throw new Error(`decompose: agent-sdk result error (${msg.subtype})`);
   144	    }
   145	  }
   146	  throw new Error("decompose: agent-sdk stream ended without a result message");
   147	}
   148	
   149	/** Exported so the prompt text is pinned (tests/b51/bundle2-prompts.test.ts). */
   150	export function draftPrompt(ci: ClassifiedIntent, taskClasses: string[], departments: string[]): string {
   151	  return [
   152	    "You are the task decomposer of DXB Global OS. Split the classified CEO intent",
   153	    "into 2-10 SELF-CONTAINED work envelopes as strict JSON matching the schema.",
   154	    "",
   155	    `Legal task_class values (choose one per envelope): ${taskClasses.join(", ")}`,
   156	    `Live departments (choose one per envelope): ${departments.join(", ")}`,
   157	    "",
   158	    "Rules:",
   159	    "- objective: a complete work order readable in TOTAL ISOLATION. Repeat every",
   160	    "  fact the worker needs. NEVER write 'the above', 'previous step', 'as mentioned',",
   161	    "  'yukarıda' or 'önceki' — each envelope is the only text its worker sees.",
   162	    "- output_contract: concrete deliverable format + done-criteria.",
   163	    "- deps: array of indices of EARLIER envelopes this one needs finished first",
   164	    // The cap the code enforces, not an older number (B51 move 5, C2-5): his order of 2026-08-27
   165	    // raised it to MAX_HOP_DEPTH; PHASE-05 §2 row 7 keeps ≤3 as the usual shape.
   166	    "  (0-based, forward references forbidden). Keep the longest chain as short as the work",
   167	    `  allows — usually 3 or fewer; up to ${MAX_HOP_DEPTH} only when the work truly needs it.`,
   168	    "- approval_class: 'outward' when that envelope's work leaves the company,",
   169	    "  'internal' when it needs internal review, else 'none'.",
   170	    "",
   171	    `Classified intent: ${JSON.stringify(ci)}`,
   172	  ].join("\n");
   173	}
   174	
   175	async function finalize(
   176	  ci: ClassifiedIntent,
   177	  drafts: EnvelopeDraft[],
   178	  rules: RoutingRule[],
   179	): Promise<DecomposedEnvelope[]> {
   180	  return drafts.map((d) => {
   181	    const routed = route(
   182	      { ...ci, task_class: d.task_class, departments: [d.department] },
   183	      rules,
   184	    );
   185	    const envelope = TaskEnvelope.parse({
   186	      department: d.department,
   187	      objective: d.objective,
   188	      output_contract: d.output_contract,
   189	      model_tier: routed.model_tier, // route() decides — never the LLM (T-05-11)
   190	      approval_class: raiseApproval(ci.approval_class, d.approval_class),
   191	    });
   192	    return { ...envelope, deps: [...d.deps] };
   193	  });
   194	}
   195	
   196	export async function decompose(ci: ClassifiedIntent): Promise<DecomposedEnvelope[]> {
   197	  const db = getDb();
   198	  const rules = await loadPolicy(db);
   199	
   200	  if (ci.complexity === "single") {
   201	    // No LLM: one envelope straight from the classification.
   202	    const routed = route(ci, rules);
   203	    const envelope = TaskEnvelope.parse({
   204	      department: ci.departments[0],
   205	      objective: ci.intent_summary,
   206	      output_contract:
   207	        `One self-contained deliverable that fully satisfies: ${ci.intent_summary}. ` +
   208	        "Where the intent leaves specifics (names, prices, categories, dates) undefined, " +
   209	        "mark them as explicit [placeholders] — inventing facts violates this contract.",
   210	      model_tier: routed.model_tier,
   211	      approval_class: ci.approval_class,
   212	    });
   213	    return [{ ...envelope, deps: [] }];
   214	  }
   215	
   216	  // 'multi' — one drafting call; parameters come from the 'orchestration'
   217	  // routing row (data, not constants), same own-route rule as classify().
   218	  const own = route(
   219	    { ...ci, task_class: "orchestration" },
   220	    rules,
   221	  );
   222	  if (own.mode !== "subscription") {
   223	    throw new Error(
   224	      `decompose: 'orchestration' routing row resolved mode '${own.mode}' — ` +
   225	        "decomposition runs on subscription-mode models only (no raw provider keys)",
   226	    );
   227	  }
   228	  const deptRows = await db.selectFrom("departments").select("slug").orderBy("slug").execute();
   229	  const departments = deptRows.map((r) => r.slug);
   230	  const taskClasses = [...new Set(rules.map((r) => r.task_class))].sort();
   231	  const basePrompt = draftPrompt(ci, taskClasses, departments);
   232	
   233	  let lastFailure = "";
   234	  for (let attempt = 0; attempt < 2; attempt++) {
   235	    const prompt =
   236	      attempt === 0
   237	        ? basePrompt
   238	        : `${basePrompt}\n\nYour previous batch was rejected:\n${lastFailure}\nReturn a corrected JSON batch only.`;
   239	    const raw = await runDraftQuery(prompt, own);
   240	    const parsed = DraftBatch.safeParse(raw);
   241	    if (!parsed.success) {
   242	      lastFailure = JSON.stringify(parsed.error.issues);
   243	      continue;
   244	    }
   245	    const lintFailures = lintBatch(parsed.data.envelopes);
   246	    if (lintFailures.length > 0) {
   247	      lastFailure = lintFailures.join("\n");
   248	      continue;
   249	    }
   250	    return finalize(ci, parsed.data.envelopes, rules);
   251	  }
   252	  throw new Error(`decompose: draft batch rejected twice: ${lastFailure}`);
   253	}
     1	// Persona loading for the live answer lanes (voice + chat), ONE definition.
     2	//
     3	// WHY THIS FILE EXISTS — defect measured 2026-07-27, and it is the direct cause of the CEO's
     4	// complaint that "Hamza does not know the holding, does not know the system, he is confused":
     5	// both lanes had a private copy of a `personaHead()` that read **the first 60 lines of the
     6	// persona FILE**. A persona file opens with the 33-row SİCİL dossier table (48 lines for the
     7	// orchestrator), so those 60 lines were: the dossier, the persona header, §1, and the first
     8	// sentence of §2 — **2 of 13 sections** (measured: the delivered head carried `## 1.` and `## 2.`
     9	// and nothing else). Everything that makes the employee who he is arrived
    10	// nowhere: his working method, his decision rules, his escalation limits, his reporting
    11	// standard, §12 (Discipline DNA & Islamic conduct — constitutional, CEO rulings D5+D6) and
    12	// §13 (the character the CEO bound the orchestrator to). The persona was authored, gated,
    13	// versioned and stored — and then not delivered.
    14	//
    15	// The boundary used here is the SAME one the sync script, the quality gate and the compiler
    16	// already use: the persona is the text from the `# PERSONA — ` header to the end of file. There
    17	// is exactly one definition of "the persona" in this company, and this is it.
    18	//
    19	// Not compiled through `@dxb/hr` compilePersonaPrompt on purpose: that compiler requires a
    20	// `hookStandardText` which has no producer in the runtime today. Inventing one here would be a
    21	// new design decision in the wrong place. The body IS the identity; the hook standard is a
    22	// separate layer that already binds through @dxb/hook. Recorded as a boundary, not skipped.
    23	
    24	import { readFile } from "node:fs/promises";
    25	import { join } from "node:path";
    26	
    27	/** The `## {n}.` boundary — same section grammar as @dxb/hr template.ts. */
    28	const PERSONA_HEADER = "# PERSONA — ";
    29	
    30	/**
    31	 * The employee's full persona body, as authored.
    32	 *
    33	 * @param repoRoot    absolute repo root
    34	 * @param personaPath repo-relative path from `agents.persona_path` (null = no persona on file)
    35	 * @returns the persona body, or "" when there is no persona to read — a missing persona file is
    36	 *          degraded context, never a crash (the answer lane must still speak to the CEO).
    37	 */
    38	export async function loadPersonaBody(
    39	  repoRoot: string,
    40	  personaPath: string | null,
    41	): Promise<string> {
    42	  if (!personaPath) return "";
    43	  try {
    44	    const text = await readFile(join(repoRoot, personaPath), "utf8");
    45	    const start = text.indexOf(PERSONA_HEADER);
    46	    // No header = a skeleton file that was never written ("⏳ FABLE-YAZIMI BEKLİYOR" stock).
    47	    // Sending the dossier table as if it were an identity is what this fix exists to stop, so
    48	    // an unwritten persona yields nothing rather than a table.
    49	    if (start < 0) return "";
    50	    // HTML comments are the file's own bookkeeping — version lines (`<!-- v1 · fable-5 · … -->`),
    51	    // the §12 note, approval markers — never the employee's mind; none reaches a model (B51 move 5,
    52	    // R14, 2026-10-04). The DB copy and its gate keep the whole file (sync-personas-to-db.sh).
    53	    return text.slice(start).replace(/<!--[\s\S]*?-->/g, "").replace(/\n{3,}/g, "\n\n").trim();
    54	  } catch {
    55	    return "";
    56	  }
    57	}
    75	 * "2-4 sentences" quota went — the length is what the question needs; the no-markdown need stays
    76	 * because text-to-speech would read the symbols out.
    77	 */
    78	export function voiceLaneLines(lang: "tr" | "en"): string[] {
    79	  return [
    80	    "This is a VOICE call and the answer is read aloud by text-to-speech: answer in a few short spoken sentences — only what the question needs — with no markdown or list symbols, which the voice would read out.",
    81	    lang === "tr"
    82	      ? "Bir insana sesli söylendiğinde kulağa doğal gelmeli: tam cümleler kur, devrik ya da telgraf üslubu kullanma."
    83	      : "It must sound natural when read aloud to a person: complete sentences, no telegraphic compression.",
    84	    `First line of your output MUST be exactly "TOPIC: <2-4 word topic of the question in ${lang === "tr" ? "Turkish" : "English"}>", then an empty line, then the spoken answer. The TOPIC line is never spoken.`,
    85	  ];
    86	}
    87	
    88	async function defaultAnswer(db: Kysely<DB>, q: AnswerQuestion): Promise<string> {
    89	  // One brain (V2): same subscription path and routing rows the kernel uses.
    90	  // Voice is a LATENCY-CRITICAL lane (registered adaptation 2026-07-17): a
    91	  // 2-4 sentence spoken answer routed through the L1 'orchestration' row cost
    92	  // a measured 104s wall on the CEO's live call — the dedicated 'voice.answer'
    93	  // row (fast tier, still subscription data in routing_rules) is the fix.
    94	  // Fallback to 'orchestration' keeps pre-migration DBs answering.
    95	  const rules = await loadPolicy(db);
    96	  const ci = {
    97	    intent_summary: `voice call answer as ${q.agent.slug}`,
    98	    departments: [q.agent.department],
    99	    approval_class: "none" as const,
   100	    complexity: "single" as const,
   101	  };
   102	  let r;
   103	  try {
   104	    r = route({ ...ci, task_class: "voice.answer" }, rules);
   105	  } catch {
   106	    r = route({ ...ci, task_class: "orchestration" }, rules);
   107	  }
   108	  // Standing layer from the ONE definition (prompt-core): identity, persona, memory, the CEO
   109	  // language law, the honesty rule and the approval gate. Only what is genuinely spoken-lane
   110	  // specific is written here — the style ruling of 2026-07-24 ("türkçesi çok kötü... tarzanca")
   111	  // and the TOPIC contract the transcript header depends on.
   112	  const sys = [
   113	    ...standingPrompt({
   114	      agent: q.agent,
   115	      personaBody: q.personaBody,
   116	      memoryLines: q.memoryLines,
   117	      memoryUnreachable: q.memoryUnreachable,
   118	      lang: q.lang,
   119	      lane: "voice",
   120	    }),
   121	    ...voiceLaneLines(q.lang),
   122	  ].filter(Boolean).join("\n\n");
   123	  const historyText = (q.history ?? [])
   124	    .map((m) => `${m.role === "ceo" ? "CEO" : "Hamza"}: ${m.content}`)
   125	    .join("\n");
   126	  const stream = query({
   127	    prompt: `${sys}${historyText ? `\n\nConversation so far (chat and voice are ONE conversation):\n${historyText}` : ""}\n\nCEO asks: ${q.question}`,
   128	    options: {
   129	      // CEO 2026-10-03: nothing of the construction is loaded into a company call (kernel sdk-isolation.ts)
   130	      ...(companyIsolation() ?? {}),
   131	      model: SDK_MODEL_IDS[r.model] ?? r.model,
   132	      // U21: effort comes from the routing row, never from a constant here.
   133	      // The hardcoded "low" silently overrode the row and made the voice lane
   134	      // the one place a CEO dashboard change could not reach. Same guard idiom
   135	      // as chat-drain: an unknown row value falls back to "low" rather than
   136	      // handing the SDK a value it cannot parse. One guard for both lanes (prompt-core).
   137	      effort: routeEffort(r.effort),
   138	      tools: [],
   139	      // Same lesson as classify NOT 1: with maxTurns 1 the SDK cannot recover
   140	      // when the model spends its only turn before the final text — measured
   141	      // error_max_turns on the fast-lane row (probe call 30ddba44, 2026-07-17).
   142	      maxTurns: 4,
   143	    },
   144	  });
   145	  const seen = isolationReceipt("voice");
   146	  for await (const msg of stream) {
   147	    seen(msg);
   148	    if (msg.type === "result") {
   149	      if (msg.subtype !== "success") throw new Error(`voice answer failed (${msg.subtype})`);
   150	      return String(msg.result ?? "").trim();
   151	    }
   152	  }
   153	  throw new Error("voice answer: stream ended without result");
   154	}
   155	
   156	/** Stages 3-6 on a parked 'routing' row: route → answer → speak → ended.
   157	 *  Claim guard: any status other than 'routing' is skipped, so a double-fired
   158	 *  drain can never double-answer a call (single scheduler by design, 04-01). */
   159	export async function answerVoiceCall(
   160	  deps: VoiceAnswerDeps,
   161	  job: { callId: string },
   162	): Promise<VoiceAnswerResult> {
   163	  const db = deps.db;
   164	  const tts = deps.tts ?? ttsSpeak;
   165	  const produceAnswer = deps.answer ?? ((q: AnswerQuestion) => defaultAnswer(db, q));
   166	  const cfg = deps.speaches ?? speachesConfig();
   167	  const repoRoot = deps.repoRoot ?? process.cwd();
   168	
   169	  const result: VoiceAnswerResult = {
   170	    callId: job.callId, state: "routing", targetSlug: null,
   260	      recallForAnswer(db, question, "voice", { recall: deps.recall }),
   261	      // U15 D12 (one-conversation law): the voice answer sees the same board
   262	      // history chat sees — a voice question continues the chat thread. W1.5
   263	      // scopes that to the CURRENT thread, so a spoken question no longer
   264	      // inherits the tail of whatever was discussed last week.
   265	      db.selectFrom("chat_messages")
   266	        .select(["role", "content"])
   267	        .where(
   268	          "session_id",
   269	          "in",
   270	          db.selectFrom("chat_sessions").select("id").orderBy("last_message_at", "desc").limit(1),
   271	        )
   272	        .orderBy("created_at", "desc")
   273	        .limit(12)
   274	        .execute()
   275	        .catch(() => []),
   276	    ]);
   277	    answerText = await produceAnswer({
   278	      question, lang,
   279	      agent: { slug: agent.slug, department: agent.department, role_level: agent.role_level, persona_path: agent.persona_path },
   280	      personaBody: head, memoryLines: recall.lines, memoryUnreachable: recall.unreachable,
   281	      history: historyRows.reverse().map((m) => ({ role: m.role, content: m.content.slice(0, 500) })),
   282	    });
   283	  } catch (e) {
   284	    return fail(`answer_error: ${(e as Error).message.slice(0, 200)}`);
   285	  }
   286	  result.timings.answer_ms = Date.now() - answerStart;
   287	  // Topic contract (CEO 2026-07-19): the model's first line is
   288	  // "TOPIC: <2-4 words>" — parsed off, NEVER spoken. Missing marker
   289	  // (injected test answers, non-compliant model) → fall back to the first
   290	  // words of the question so the history list always says what it was about.
   291	  let topic: string | null = null;
   292	  const topicMatch = /^TOPIC:\s*(.+)\s*\n+/.exec(answerText);
   293	  if (topicMatch) {
   294	    topic = topicMatch[1].trim().slice(0, 60);
   295	    answerText = answerText.slice(topicMatch[0].length).trim();
   296	  } else {
   297	    topic = question.split(/\s+/).slice(0, 4).join(" ").slice(0, 60) || null;
   298	  }
   299	  result.answerText = answerText;
   300	  const answerLine: TranscriptLine = { role: agent.slug, text: answerText, at: new Date().toISOString() };
   301	
   302	  // 5. Speak (answer_ready Broadcast fires from the control fn on 'speaking'):
   303	  //    registered identity or fallback voice, degraded=true — the answer is
   304	  //    NEVER dropped for voice-supply reasons (§17).
   305	  step("speaking");
   306	  const identity = await db
   307	    .selectFrom("voice_identities")
   308	    .select(["engine", "profile_ref", "locale"])
   309	    .where("agent_id", "=", agent.id)
   310	    .where("status", "=", "active")
   311	    .executeTakeFirst();
   312	  result.degraded = !identity;
   313	  // The voice must carry the ANSWER language (§27) — a registered identity in
   314	  // another locale would read EN text through TR phonemes (unintelligible,
   315	  // measured on the CEO's live call 2026-07-17). Identity wins only when its
   316	  // locale matches; otherwise the language-default voice speaks.
   317	  const langVoice = ttsForLang(cfg, lang);
   318	  const spokenVoice = identity && identity.locale === lang
   319	    ? { model: undefined as string | undefined, voice: identity.profile_ref }
   320	    : { model: langVoice.model, voice: langVoice.voice };
   321	  await logCall(db, {
   322	    id: job.callId, status: "speaking", target_agent_slug: agent.slug, topic,
   323	    transcript: [...transcript, answerLine], timeline,
   324	    stt_ms: row.stt_ms, answer_ms: result.timings.answer_ms, degraded: result.degraded,
   325	  });
   326	  const ttsStart = Date.now();
   327	  try {
   328	    result.answerAudio = await tts(answerText, {
   329	      voice: spokenVoice.voice,
   330	      ...(spokenVoice.model ? { model: spokenVoice.model } : {}),
   331	      config: cfg,
   332	    });
   333	  } catch (e) {
   334	    return fail(`tts_error: ${(e as Error).message.slice(0, 200)}`);
   335	  }
    62	  failed: number;
    63	}
    64	
    65	/**
    66	 * What is genuinely chat-lane specific, in order: the conversation register, the plan-mode or
    67	 * dispatch line, the leg's own instruction, and the format the board can show. B51 move 5
    68	 * (C2-6/7, 2026-10-04): the board renders plain text (chat-board.tsx, whitespace-pre-wrap, no
    69	 * markdown renderer), so the format rule carries that reason; the 8-sentence quota and the
    70	 * plan-mode capitals went — this call has tools: [] and cannot dispatch anything anyway.
    71	 */
    72	export function chatLaneLines(planMode: boolean, legLine = ""): string[] {
    73	  return [
    74	    "This is a CONVERSATION, not a task intake. A greeting gets a warm greeting back. A question gets a direct answer. An idea gets genuine engagement — agree, push back, refine.",
    75	    planMode
    76	      ? "Plan mode is on: think the CEO's topic through with him — propose a concrete plan (goal, steps, who does what, rough cost) and ask what to adjust. Work starts only when he dispatches it himself."
    77	      : "If the CEO clearly wants work executed, summarize what you would dispatch in one sentence and remind him of the 'Görev olarak gönder' button — never dispatch from chat yourself.",
    78	    legLine,
    79	    "His chat board shows plain text and does not render markdown: write plain prose, and when you list steps or options use plain numbered lines without #, ** or other markdown symbols. Answer at the length the question needs.",
    80	  ];
    81	}
    82	
    83	async function defaultAnswer(db: Kysely<DB>, q: ChatAnswerInput): Promise<string> {
    84	  // One brain (V2): the same subscription routing rows the kernel uses.
    85	  const rules = await loadPolicy(db);
