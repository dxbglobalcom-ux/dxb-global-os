    91	      // tool call — with a single turn the SDK cannot retry when the model
    92	      // answers inline first (observed live on opus-4.8 effort=high).
    93	      maxTurns: 4,
    94	      outputFormat: { type: "json_schema", schema: sdkJsonSchema(ClassifiedIntent) },
    95	    },
    96	  });
    97	  const seen = isolationReceipt("classify");
    98	  for await (const msg of q) {
    99	    seen(msg);
   100	    if (msg.type === "result") {
   101	      if (msg.subtype === "success") {
   102	        if (msg.structured_output !== undefined) return msg.structured_output;
   103	        // Mechanical unwrap only (``` fences); ClassifiedIntent.parse stays the
   104	        // sole decision gate — this is not a free-text fallback.
   105	        const text = msg.result.trim();
   106	        const fenced = text.match(/```(?:json)?\s*([\s\S]*?)```/);
   107	        try {
   108	          return JSON.parse((fenced ? fenced[1] : text).trim());
   109	        } catch {
   110	          return msg.result;
   111	        }
   112	      }
   113	      throw new Error(`classify: agent-sdk result error (${msg.subtype})`);
   114	    }
   115	  }
   116	  throw new Error("classify: agent-sdk stream ended without a result message");
   117	}
