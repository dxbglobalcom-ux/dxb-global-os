    36	# such as ~/.claude/hooks/dxb-cost-gate.py -- stays as written, because the mirror has no copy of
    37	# it (Sol's single pass, 2026-10-04: the mirror named .codex/hooks/dxb-design-max.py, which does not
    38	# exist).
    39	rewrite() {
