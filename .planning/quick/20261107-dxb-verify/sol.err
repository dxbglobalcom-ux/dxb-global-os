    88	#      one of those pieces or the rulers themselves are in the staged change.
    89	OPENING_TOUCHED=$(git diff --cached --name-only | grep -E '^\.claude/CLAUDE\.md$|^\.claude/skills/|^\.claude/hooks/spec-bootstrap\.sh$|^tests/hooks/' || true)
    90	if [ -n "$OPENING_TOUCHED" ]; then
