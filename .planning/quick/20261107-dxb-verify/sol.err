     1	#!/usr/bin/env bash
     2	# B36 · Block 3-bis — THE WHOLE BATTERY, and it says which half ran where.
     3	#
     4	# Two halves, both required, nothing hidden between them:
     5	#
     6	#   1. THE CONSTRUCTION RUNTIME — everything, inside the sandbox opened by
     7	#      scripts/construction/run.sh: no network, no Docker socket, no credential,
     8	#      and one unix socket to the company's read gateway.
     9	#
    10	#   2. THE AUTHOR'S HAND, on the company's side — the few files that must enter a
    11	#      container or inspect this machine's own processes, and therefore cannot
    12	#      run inside a sandbox built to take those away. They are named here, in
    13	#      full, so that nothing can be moved out of the wall quietly.
    14	set -uo pipefail
    15	REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
    16	cd "$REPO"
    17	
    18	# ── ONE BATTERY AT A TIME ON ONE ENGINE ─────────────────────────────────────
    19	# The bench is a single database, and a suite that measures "what is in the
    20	# table" cannot be right while a second run is writing to the same table.
    21	# Measured 2026-09-21 by the adversarial pass: two `construction:battery`
    22	# processes overlapped on port 54422 and audit_log moved 59215 -> 59211 ->
    23	# 59212 underneath the observer, and one run's teardown could have deleted the
    24	# other's queued jobs. Suites defend themselves with markers and watermarks
    25	# against each OTHER; nothing can defend a run against its own twin. So the
    26	# battery refuses to start beside one, loudly, instead of producing a number
    27	# that is not true. (`flock` is util-linux; if it is missing the battery runs
    28	# as before and says so, because a missing lock must not stop the work.)
    29	if command -v flock >/dev/null 2>&1; then
    30	  exec 200>"${TMPDIR:-/tmp}/dxb-construction-battery.lock"
    31	  # DXB_ENGINE_LOCK_WAIT=<seconds> (dxb-team2 §5, 2026-10-06): a battery started
    32	  # beside a writer's run queues for the engine instead of colliding with it. A
    33	  # positive integer only; anything else is today's immediate refusal.
    34	  WAIT="${DXB_ENGINE_LOCK_WAIT:-}"
    35	  [[ "$WAIT" =~ ^[1-9][0-9]*$ ]] || WAIT=""
    36	  if ! flock -n 200 && { [ -z "$WAIT" ] || {
    37	        echo "waiting up to $WAIT s for the construction engine…" >&2
    38	        ! flock -w "$WAIT" 200; }; }; then
    39	    echo "REFUSED: another construction battery is already running against this engine."
    40	    echo "         Two runs on one bench measure each other, not the code. Wait for it,"
    41	    echo "         or point this one elsewhere with DXB_CONSTRUCTION_URL."
    42	    exit 2
    43	  fi
    44	  # 2026-09-21: the lock is no longer only battery-against-battery. It now names
    45	  # the ENGINE, and every vitest run takes it — because a single-file run beside
    46	  # a battery falls inside the battery's own before/after counting, and since the
    47	  # receipts are reconciled per run it would also hand back rows that are not
    48	  # its own. Measured that day: a `vitest run <one file>` started beside a
    49	  # battery took `dxb_internal.ops_live_issued` from 652 to 4. The two vitest
    50	  # halves below are this battery's own, so they are told the engine is already
    51	  # held rather than left to fight their parent for it.
    52	  export DXB_ENGINE_LOCK_HELD=1
    53	else
    54	  echo "⚠ UNVERIFIED — flock is not installed, so a concurrent battery cannot be ruled out"
    55	fi
