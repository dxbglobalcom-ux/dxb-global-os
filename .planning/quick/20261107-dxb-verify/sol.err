     1	#!/usr/bin/env bash
     2	# The only door to the audit twin (U36) — a Codex session that CANNOT write.
     3	#
     4	# WHY (CEO order 2026-08-16). `.claude/skills/dxb-verify` has always said the
     5	# auditor is "read-only BY TOOL, never by promise". Measured that night, the
     6	# tool said otherwise: both Codex homes ran at sandbox_mode = "danger-full-
     7	# access" with approval_policy = "never", so the refuter could edit the very
     8	# repository it was auditing. The base config was left alone — it serves the
     9	# CEO's other projects — and the read-only setting lives in a profile instead.
    10	# A profile only protects you if it is actually passed, so this script exists
    11	# to be the one way the refuter is launched. Never call `codex` directly for an
    12	# audit.
    13	#
    14	# The auditor is gpt-6.1-sol (CEO 2026-10-01, after the auditor exam; gpt-6-sol
    15	# before it). The lead chooses its effort (CEO 2026-10-06): high by default,
    16	# xhigh for money, database, security, approval or governance work, medium for a
    17	# text-only change — dxb-team2 owns that rule; this door only bounds the level.
    18	#
    19	# Usage:
    20	#   scripts/governance/refuter.sh "<claim + where to measure it>"                  # effort high
    21	#   scripts/governance/refuter.sh --effort xhigh "<claim + where to measure it>"   # medium, high or xhigh
    22	#   scripts/governance/refuter.sh --deny-read /abs/path [--deny-read …] "<claim>"   # paths the audit may not read
    23	#   scripts/governance/refuter.sh --proof                                          # prove it cannot write
    24	#   scripts/governance/refuter.sh --install-profile                                # copy the tracked profile into ~/.codex
    25	#
    26	# Each launch, every retry included, is one row of ~/.local/state/dxb/audits.log.
    27	#
    28	# THE AUDITOR'S OWN HAND (dxb-team2 job 1, CEO 2026-09-28 "önerin tmm"). The
    29	# profile starts one MCP server, `dxbdb`, whose one tool `sql_read` runs a
    30	# read-only query on the CONSTRUCTION engine as `sol_reader` — so Sol gathers
    31	# database evidence itself instead of receiving the author's output. Read
    32	# scripts/governance/sol-db-mcp.mjs before trusting it. Never the company.
    33	#
    34	# Hand it a CLAIM and WHERE TO MEASURE IT — never the author's conclusion — and
    35	# tell it to refute. A finding is evidence, never a verdict (dxb-verify).
    36	set -euo pipefail
    37	
    38	ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
    39	cd "$ROOT"
    40	
    41	PROFILE="refuter"
    42	EFFORT="high"
    43	# --deny-read only NARROWS what the read-only sandbox may read (a Codex permissions profile: the whole
    44	# disk readable and nothing writable, as the profile's own read-only mode, minus each named path —
    45	# measured 2026-10-19 with `codex sandbox`: a denied path answers "Permission denied", a write still
    46	# "Read-only file system"). The blind plan audit (second-plan.sh audit) uses it to keep the key, the
    47	# original plans and the lead's transcripts out of Sol's reach.
    48	DENY=()
    49	while :; do
    50	  case "${1:-}" in
    51	    --effort)
    52	      case "${2:-}" in
    53	        medium|high|xhigh) EFFORT="$2"; shift 2 ;;
    54	        *) echo "REFUTER_FAIL: --effort takes medium, high or xhigh." >&2; exit 1 ;;
    55	      esac ;;
    56	    --deny-read)
    57	      case "${2:-}" in
    58	        /*) case "$2" in *'"'*|*'\\'*) echo "REFUTER_FAIL: --deny-read path may not hold a quote or a backslash: $2" >&2; exit 1 ;; esac
    59	            DENY+=("$2"); shift 2 ;;
    60	        *) echo "REFUTER_FAIL: --deny-read takes an absolute path." >&2; exit 1 ;;
    61	      esac ;;
    62	    *) break ;;
    63	  esac
    64	done
    65	
    66	# The gate runs before anything else for an audit, so a refused audit costs nothing.
    67	case "${1:-}" in
    68	  --proof|--install-profile) ;;
    69	  *)
    70	    # What may follow the effort: an ALLOW-LIST of `codex exec` options and exactly one prompt (or
