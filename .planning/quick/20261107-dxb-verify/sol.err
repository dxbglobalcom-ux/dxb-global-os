    92	  if ! node --no-warnings "$REPO_TOP/tests/hooks/opening-budget.ts"; then
    93	    echo "" >&2
    94	    echo "COMMIT DURDURULDU — acilis butcesi asildi (yukaridaki tablo)." >&2
    95	    echo "Duzelt, 'node --no-warnings tests/hooks/opening-budget.ts' yesil yansin, sonra tekrar commit et." >&2
    96	    exit 1
    97	  fi
    98	fi
    99	
   100	# (4) Scan staged changes only; redact matched values in all output.
   101	exec gitleaks git --pre-commit --staged --redact --verbose

