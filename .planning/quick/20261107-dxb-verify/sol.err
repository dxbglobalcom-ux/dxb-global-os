    88	        --cd=*|--color=*|--output-last-message=*|--output-schema=*|--image=*) OPTS+=("$1"); shift ;;
    89	        -C?*|-o?*|-i?*)   # attached short forms: -C/tmp, -C=/tmp, -ofile, -o=file, -ix.png
    90	          case "$1" in -C*) long=--cd ;; -o*) long=--output-last-message ;; -i*) long=--image ;; esac
    91	          v="${1:2}"; v="${v#=}"
    92	          OPTS+=("$long=$v"); shift ;;
    93	        --) [ $# -ge 2 ] && [ "$HAVE_PROMPT" -eq 0 ] || { echo "REFUTER_FAIL: '--' must be followed by the one prompt." >&2; exit 1; }
    94	            PROMPT_ARG="$2"; HAVE_PROMPT=1; shift 2
    95	            [ $# -eq 0 ] || { echo "REFUTER_FAIL: nothing may follow the prompt after '--'." >&2; exit 1; } ;;
    96	        -) [ "$HAVE_PROMPT" -eq 0 ] || { echo "REFUTER_FAIL: more than one prompt given (an -i takes one file; repeat -i for more)." >&2; exit 1; }
