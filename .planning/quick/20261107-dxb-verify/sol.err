     1	#!/usr/bin/env sh
     2	# DXB Global OS — fail-closed secret-scanning pre-commit hook (SEC-03)
     3	#
     4	# Blocks any commit containing a detectable secret in staged changes.
     5	#
     6	# CLONE BOOTSTRAP (required once per fresh clone):
     7	#   git config core.hooksPath scripts/hooks
     8	# Without this the hook file exists but never fires (RESEARCH Pitfall 7).
     9	#
    10	# Policy:
    11	#   - Fail closed: if gitleaks is missing, the commit is BLOCKED (exit 1).
    12	#     A missing scanner must never let a commit pass unscanned.
    13	#   - --redact is mandatory: hook output never prints a matched secret value
    14	#     (CEO no-values rule).
    15	
    16	# (1) Ensure gitleaks resolves for every git client (GUI, agents, cron),
    17	#     regardless of the login-shell PATH.
    18	PATH="$HOME/.local/bin:$PATH"
    19	export PATH
    20	
    21	# (2) Fail closed if the scanner is absent.
    22	if ! command -v gitleaks >/dev/null 2>&1; then
    23	  echo "ERROR: gitleaks not installed — commit blocked (fail closed)." >&2
    24	  echo "Install: download release from github.com/gitleaks/gitleaks/releases into ~/.local/bin" >&2
    25	  exit 1
    26	fi
    27	
    28	# (3) THE CLASS'S RULER RUNS BEFORE THE COMMIT — the CEO's ruling of 2026-09-15
    29	#     (ceo-approvals.json, `ruler-table-holding-wide-2026-09-15`): "every commit runs its
    30	#     class's ruler automatically — no ruler green, no commit". The research engine is a class
    31	#     of its own and its ruler is scripts/research-ruler.sh (~0.3 s). It runs ONLY when that
    32	#     engine, its tests or the ruler itself are in the staged change, so an ordinary commit
    33	#     pays nothing. Measured on 2026-09-17, the day it was written: the engine went into that
    34	#     commit at 10/10 PASS, having been at 4/10 with 18 failures that morning.
    35	RESEARCH_TOUCHED=$(git diff --cached --name-only | grep -E '^\.claude/skills/dxb-research/|^tests/b46/|^scripts/research-ruler\.sh$' || true)
    36	if [ -n "$RESEARCH_TOUCHED" ]; then
    37	  REPO_TOP=$(git rev-parse --show-toplevel)
    38	  if ! bash "$REPO_TOP/scripts/research-ruler.sh"; then
    39	    echo "" >&2
    40	    echo "COMMIT DURDURULDU — arastirma motorunun cetveli kirmizi (yukaridaki tablo)." >&2
    41	    echo "Duzelt, 'bash scripts/research-ruler.sh' yesil yansin, sonra tekrar commit et." >&2
    42	    exit 1
    43	  fi
    44	  # ...AND THE RULER'S OWN BITE TESTS, because a ruler that has stopped biting still prints
    45	  # a green table. Measured 2026-09-21 and this is why the line exists: commit f6e41a68 that
    46	  # morning raised the channel count 37 -> 39 and corrected the prose the metre could see; the bite
    47	  # test patched the literal "37 channels", stopped matching, and went red - `1 failed | 63
    48	  # passed` - while scripts/research-ruler.sh printed 16/16 and this gate let the commit
    49	  # through. Three metres were watching and none of them ran the suite. It costs ~75 s and
    50	  # only on a commit that touches the engine; skip it deliberately with DXB_SKIP_B46=1 and
    51	  # say so out loud when you do.
    52	  if [ "${DXB_SKIP_B46:-0}" != "1" ]; then
    53	    if ! npx --prefix "$REPO_TOP" vitest run --root "$REPO_TOP" tests/b46 >/tmp/dxb-b46.log 2>&1; then
    54	      echo "" >&2
    55	      tail -20 /tmp/dxb-b46.log >&2
    56	      echo "COMMIT DURDURULDU — motorun kendi test takimi kirmizi (tests/b46)." >&2
    57	      echo "Duzelt, 'npx vitest run tests/b46' yesil yansin, sonra tekrar commit et." >&2
    58	      exit 1
    59	    fi
    60	  fi
    61	fi
    62	
    63	# (3b) THE RECORDS RULER RUNS BEFORE THE COMMIT — same ruling, second class. The records
    64	#      (.planning/STATE.md, the open board, the approvals ledger) have had their ruler since
    65	#      2026-09-19, on the CEO's order of that day (ceo-approvals.json,
    66	#      `records-ruler-ordered-on-his-word-2026-09-19`): tests/b43/records-truth.ts (~0.3 s), which
    67	#      rings when a record still says his eye is awaited on something the ledger holds as
