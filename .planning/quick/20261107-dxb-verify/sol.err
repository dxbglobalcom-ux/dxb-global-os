    69	#      the working tree, as the research ruler does.
    70	RECORDS_TOUCHED=$(git diff --cached --name-only | grep -E '^\.planning/STATE\.md$|^HOLDING-OS-MASTER-PLAN/00-BOARD-OPEN-WORK\.md$|^scripts/governance/ceo-approvals\.json$|^tests/b43/records-truth' || true)
    71	if [ -n "$RECORDS_TOUCHED" ]; then
