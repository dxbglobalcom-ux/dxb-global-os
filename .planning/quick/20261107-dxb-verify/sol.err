     1	#!/usr/bin/env bash
     2	# Generate the Codex refuter's context from the Claude author's context.
     3	#
     4	# WHY THIS EXISTS (CEO order 2026-08-16). The refuter — Codex, gpt-5.6-sol at
     5	# high reasoning — is the project's adversarial second eye, and it reads its own
     6	# carriers: AGENTS.md at the repo root, .agents/skills/ for the doors, and
     7	# .codex/hooks/ for the standing orders. Until tonight those carriers were made
     8	# by a blind find/replace of the word "claude" -> "Codex". Measured damage:
     9	#   * AGENTS.md pointed the refuter at `.Codex/hooks/` and `.Codex/skills/`.
    10	#     The filesystem is case-sensitive; `.Codex` does not exist. It could not
    11	#     open the doors it was told to open.
    12	#   * 5 of the 9 doors had drifted the same way, and in dxb-verify the sentence
    13	#     that explains WHY the audit is cross-model ("a Claude auditing a Claude
    14	#     shares its blind spots") had been rewritten into "a Codex auditing a
    15	#     Codex", destroying its own reason.
    16	# The repair is not to patch the copies: it is to stop hand-making them. One
    17	# rule, one owner — .claude/ is the source, this script is the only way the
    18	# mirror is written, and it substitutes PATHS ONLY. Prose is never touched, so
    19	# the word "Claude" survives wherever it means the model rather than a folder.
    20	#
    21	# Usage:
    22	#   sync-codex-mirror.sh            regenerate the mirror
    23	#   sync-codex-mirror.sh --check    exit 1 if the mirror is stale (battery gate)
    24	set -euo pipefail
    25	
    26	ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
    27	cd "$ROOT"
    28	
    29	MODE="${1:-write}"
    30	STAGE="$(mktemp -d)"
    31	trap 'rm -rf "$STAGE"' EXIT
    32	
    33	# The ONLY substitutions. Repo paths, nothing else, longest first.
    34	# A home path (`.claude/` right after ~/, $HOME/, ${HOME}/, /root/ or /home/<user>/) is never
    35	# rewritten: it is masked with a sentinel first and unmasked last, because ~/.codex/hooks/ and
    36	# ~/.agents/ do not exist (Sol's single pass on 193eea17, 2026-10-04: ~/.claude/hooks/order.sh became
    37	# ~/.codex/hooks/order.sh). A hook path moves only where the mirror really holds the file: the hooks
    38	# folder itself and each *.sh step 3 copies, its name matched literally, so `name+extra.sh` and
    39	# `name space.sh` move too. Any other hook path -- a .py hook, a .sh with no such file -- stays
    40	# (Sol, 2026-10-04: the mirror named .codex/hooks/dxb-design-max.py, which does not exist).
    41	HOME_MASK=$'\001'
    42	HOOK_RULES=()
    43	for f in .claude/hooks/*.sh; do
    44	  [ -e "$f" ] || continue
    45	  n="$(basename "$f" | sed 's/[\.*^$[|]/\\&/g')"
    46	  HOOK_RULES+=(-e "s|\\.claude/hooks/\\($n\\)\\([^A-Za-z0-9._-]\\)|.codex/hooks/\\1\\2|g"
    47	               -e "s|\\.claude/hooks/\\($n\\)\$|.codex/hooks/\\1|")
    48	done
    49	rewrite() {
    50	  sed -E "s#(~/|\\\$HOME/|\\\$\\{HOME\\}/|/root/|/home/[^/]+/)\\.claude/#\\1$HOME_MASK/#g" |
    51	  sed -e 's|\.claude/CLAUDE\.md|AGENTS.md|g' \
    52	      -e 's|\.claude/skills/|.agents/skills/|g' \
    53	      "${HOOK_RULES[@]}" \
    54	      -e 's|\.claude/hooks/\([^A-Za-z0-9._-]\)|.codex/hooks/\1|g' \
    55	      -e 's|\.claude/hooks/$|.codex/hooks/|' |
    56	  sed -e "s|$HOME_MASK|.claude|g"
    57	}
    58	
    59	BANNER='<!-- GENERATED FILE — DO NOT EDIT BY HAND.
    60	     Source: .claude/CLAUDE.md · Generator: scripts/governance/sync-codex-mirror.sh
    61	     Edit the source and re-run the generator; a hand edit here is overwritten
    62	     and, worse, silently splits one rule into two owners. -->'
    63	
    64	# 1. The always-on core -> AGENTS.md
    65	{ printf '%s\n' "$BANNER"; rewrite < .claude/CLAUDE.md; } > "$STAGE/AGENTS.md"
    66	
    67	# 2. The doors -> .agents/skills/
    68	mkdir -p "$STAGE/skills"
    69	for dir in .claude/skills/*/; do
    70	  name="$(basename "$dir")"
    71	  mkdir -p "$STAGE/skills/$name"
    72	  find "$dir" -type f -print0 | while IFS= read -r -d '' f; do
    73	    rel="${f#"$dir"}"
    74	    mkdir -p "$STAGE/skills/$name/$(dirname "$rel")"
    75	    case "$f" in
    76	      *.md) rewrite < "$f" > "$STAGE/skills/$name/$rel" ;;
    77	      *)    cp "$f" "$STAGE/skills/$name/$rel" ;;
    78	    esac
    79	  done
    80	done
    81	
    82	# 3. The standing orders -> .codex/hooks/
    83	mkdir -p "$STAGE/hooks"
    84	for f in .claude/hooks/*.sh; do
    85	  rewrite < "$f" > "$STAGE/hooks/$(basename "$f")"
    86	  chmod +x "$STAGE/hooks/$(basename "$f")"
    87	done
    88	
    89	# The mirror may never contain the broken capital-C path that caused this.
    90	if grep -rqn '\.Codex' "$STAGE"; then
    91	  echo "SYNC_FAIL: generated output still contains '.Codex'" >&2
    92	  grep -rn '\.Codex' "$STAGE" >&2
    93	  exit 1
    94	fi
    95	
    96	if [ "$MODE" = "--check" ]; then
    97	  # Compiled Python is not part of a door. Running a door's scripts leaves
    98	  # __pycache__/*.pyc on whichever side ran them, so the check ignores both, on
    99	  # both sides; otherwise a fresh .pyc reads as a stale mirror (board row B63).
   100	  mirror_diff() { diff -rq --exclude=__pycache__ --exclude='*.pyc' "$1" "$2"; }
   101	  stale=0
   102	  mirror_diff "$STAGE/AGENTS.md" AGENTS.md >/dev/null 2>&1 || stale=1
   103	  mirror_diff "$STAGE/skills" .agents/skills >/dev/null 2>&1 || stale=1
   104	  mirror_diff "$STAGE/hooks" .codex/hooks   >/dev/null 2>&1 || stale=1
   105	  if [ "$stale" -ne 0 ]; then
   106	    echo "SYNC_STALE: the Codex mirror does not match .claude/ — run scripts/governance/sync-codex-mirror.sh" >&2
   107	    # Every differing path, uncut: a `head -10` here once pushed split.py out of
   108	    # the listing behind .pyc lines (B63), and a stale file nobody is shown stays.
   109	    mirror_diff "$STAGE/AGENTS.md" AGENTS.md >&2 || true
   110	    mirror_diff "$STAGE/skills" .agents/skills >&2 || true
   111	    mirror_diff "$STAGE/hooks" .codex/hooks >&2 || true
   112	    exit 1
   113	  fi
   114	  echo "SYNC_OK mirror matches source"
   115	  exit 0
   116	fi
   117	
   118	cp "$STAGE/AGENTS.md" AGENTS.md
   119	rm -rf .agents/skills && mkdir -p .agents && cp -r "$STAGE/skills" .agents/skills
   120	mkdir -p .codex/hooks && cp "$STAGE"/hooks/*.sh .codex/hooks/
   121	
   122	echo "SYNC_OK AGENTS.md + $(find .agents/skills -name SKILL.md | wc -l) doors + $(ls -1 .codex/hooks/*.sh | wc -l) hooks regenerated from .claude/"

