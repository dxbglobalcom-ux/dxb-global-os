   164	export const repoRoot = (root?: string) => root ?? join(here, "..", "..");
   165	
   166	export function readLedger(root: string): Record<string, unknown> {
   167	  return JSON.parse(readFileSync(join(root, C.ledger), "utf8")) as Record<string, unknown>;
   168	}
   169	
   170	/** R1 — the records' own gate, ledger-truth.mjs, exits 0 (run, not re-implemented). */
   171	export function r1LedgerGate(root: string): Verdict {
   172	  try {
   173	    execFileSync("node", [join(root, C.ledgerGate)], { cwd: root, stdio: ["ignore", "pipe", "pipe"] });
   174	    return { rule: "R1 ledger-truth exits 0", pass: true, failures: [] };
   175	  } catch (e) {
   176	    const err = e as { stdout?: Buffer; stderr?: Buffer; status?: number };
   177	    const tail = `${err.stdout ?? ""}${err.stderr ?? ""}`.trim().split("\n").slice(-6).join("\n");
   178	    return { rule: "R1 ledger-truth exits 0", pass: false, failures: [`exit ${err.status}: ${tail}`] };
   179	  }
   180	}
   181	
   182	/** R2 — no sentence in the records names an accepted subject and still says his eye or word is awaited. */
   183	export function r2NoAwaitingOnAccepted(root: string, texts?: Record<string, string>): Verdict {
   184	  const failures: string[] = [];
   185	  for (const rel of C.records) {
   186	    const text = texts?.[rel] ?? readFileSync(join(root, rel), "utf8");
   187	    text.split("\n").forEach((line, i) => {
   188	      for (const sentence of line.split(C.sentenceBreak)) {
   189	        if (!C.awaiting.test(sentence) || C.cleared.test(sentence)) continue;
   190	        for (const row of C.accepted) {
   191	          if (row.subject.test(sentence)) {
   192	            failures.push(`${rel}:${i + 1} — says his eye/word is awaited on a subject the ledger holds as accepted (${row.id}): "${sentence.trim().slice(0, 140)}"`);
   193	          }
   194	        }
   195	      }
     1	// THE OPENING RULER — how much of the session's opening does THIS REPOSITORY own, in bytes?
     2	//
     3	// Row B47 (2026-09-19, his order "Bunu inşaata kuralım"): a fresh session's first request costs
     4	// 57,657 tokens before his first word is read; roughly 37 k of it is the harness's own text and
     5	// is not ours. What IS ours arrives from three places this repository controls, and two of them
     6	// have grown back once already (STATE.md to 1,796 lines; the position hook to 52,329 bytes). This
     7	// ruler holds each piece to a byte budget so the opening cannot grow back in silence. It is
     8	// dictated by the checker session (dxb-global-os-25, Fable 5.1) and committed by the builder under
     9	// the audit law of 2026-09-15; the thresholds are the checker's, set beside the numbers measured
    10	// on 2026-09-19, and a threshold change is its own `records(ruler): …` commit.
    11	//
    12	// One thing, one ruler: the position hook already has its own (session-start-fits.ts) — this
    13	// ruler CALLS it and never measures the hook a second way. The cupboard page (B47 L3) has its
    14	// rule R5 since 2026-09-19; until the page exists the rule names its absence instead of hiding it.
    15	//
    16	//   node --no-warnings tests/hooks/opening-budget.ts        — the table, exit 1 on any failure
    17	//   npx vitest run tests/hooks/opening-budget.test.ts       — the same rules under vitest, biting on copies
    18	import { existsSync, readdirSync, readFileSync } from "node:fs";
    19	import { homedir } from "node:os";
    20	import { join } from "node:path";
    21	import { fileURLToPath } from "node:url";
    22	import { runRuler as sessionStartRuler, type RulerReport as SessionStartReport } from "./session-start-fits.ts";
    23	
    24	/** THE CONSTANTS — every budget in one place. Bytes, UTF-8. Measured 2026-09-19 in the comments. */
    25	export const C = {
    26	  core: ".claude/CLAUDE.md",
    27	  skillsDir: ".claude/skills",
    28	  /** outside the repository — measured and reported, never budgeted here */
    29	  globalSkillsDir: join(homedir(), ".claude", "skills"),
    30	  /** R1 — measured 12,058 */
    31	  maxCore: 13000,
    32	  /** R2 — frontmatter name + description of every project SKILL.md; measured 4,193 over 12 skills */
    33	  maxSkills: 5000,
    34	  /** R4 — core + project skills + the position block the hook delivers; measured 24,128 */
    35	  maxTotal: 26000,
    36	  /** R5 — the cupboard page (B47 L3): one page the warrior reads at the opening — what exists, where, how it opens */
    37	  cupboard: ".claude/CUPBOARD.md",
    38	  maxCupboard: 1500,
    39	};
    40	
    41	export type Verdict = { rule: string; pass: boolean; failures: string[] };
    42	export type Piece = { name: string; bytes: number };
    43	export type Inputs = { core: string; skills: Piece[]; hook: SessionStartReport; globalSkills: Piece[]; cupboard: string | null };
    44	export type RulerReport = {
    45	  verdicts: Verdict[];
    46	  pass: boolean;
    47	  bytes: { core: number; skills: number; hook: number; total: number; globalSkills: number; cupboard: number | null };
    48	};
    49	
    50	const here = fileURLToPath(new URL(".", import.meta.url));
    51	export const repoRoot = (root?: string) => root ?? join(here, "..", "..");
    52	const bytes = (s: string) => Buffer.byteLength(s, "utf8");
    53	
    54	/** frontmatter `name:` + `description:` (a description may run over several lines) — what the harness lists at the opening */
    55	export function frontmatterBytes(skillMd: string): number {
    56	  const m = skillMd.match(/^---\n([\s\S]*?)\n---/);
    57	  if (!m) return 0;
    58	  const fm = m[1];
    59	  const name = fm.match(/^name:.*$/m)?.[0] ?? "";
    60	  const desc = fm.match(/^description:[\s\S]*?(?=^\w[\w-]*:|(?![\s\S]))/m)?.[0] ?? "";
    61	  return bytes(name) + bytes(desc.replace(/\s+$/, ""));
    62	}
    63	
    64	export function skillsIn(dir: string): Piece[] {
    65	  if (!existsSync(dir)) return [];
    66	  return readdirSync(dir)
    67	    .filter((d) => existsSync(join(dir, d, "SKILL.md")))
    68	    .sort()
    69	    .map((d) => ({ name: d, bytes: frontmatterBytes(readFileSync(join(dir, d, "SKILL.md"), "utf8")) }));
    70	}
