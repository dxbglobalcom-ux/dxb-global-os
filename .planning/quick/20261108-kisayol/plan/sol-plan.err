    25	def build(prompt, width, height, length, steps=4, seed=42, prefix="h3",
    26	          first_frame=None, last_frame=None, lora=TURBO_LORA, cfg=1.0,
    27	          negative_prompt=None):
    28	    """first_frame / last_frame: filenames inside ComfyUI/input.
    29	
    30	    FL2VA means FIRST-and-LAST-to-video. Given only a first frame the model has no
    31	    destination: it holds the supplied face for about a second and a half and then
    32	    drifts — measured 2026-08-31 on the Badr fight shot, where the same warrior went
    33	    from pores, wet eyes and a stamped helmet at 7.7 s to a featureless doll with no
    34	    helmet ornament at 10.8 s, inside one 3.75 s shot. Giving the closing photograph
    35	    too forces the model to ARRIVE somewhere real, and it costs no extra card time.
    36	    ComfyUI's node has taken it all along (comfy_extras/nodes_minimax_h3.py:129);
    37	    this builder simply never passed it."""
