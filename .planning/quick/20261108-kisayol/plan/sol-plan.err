     9	CREATE TABLE IF NOT EXISTS public.library_items (
    10	  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    11	  kind text NOT NULL CHECK (kind IN (
    12	    'skill','plugin','tool','mcp','prompt_template','persona','policy',
    13	    'governance_rule','workflow','sop','framework','code_component',
    14	    'design_system','research','report','project_doc','training',
    15	    'memory_source','best_practice','lesson_learned')),
    16	  name text NOT NULL,
    17	  version text,
    18	  owner_dept uuid REFERENCES public.departments(id),
    19	  usage_notes text,
    20	  dependencies text[],
    21	  quality_score numeric,
    22	  review_status text,
    23	  last_used_at timestamptz,
    24	  updated_at timestamptz NOT NULL DEFAULT now(),
    25	  UNIQUE (kind, name, version)
    26	);
    27	
    28	CREATE TABLE IF NOT EXISTS public.library_grants (
    29	  id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    30	  item_id uuid NOT NULL REFERENCES public.library_items(id) ON DELETE CASCADE,
    31	  grantee_kind text NOT NULL CHECK (grantee_kind IN ('department','employee','role_level')),
    32	  grantee_id text NOT NULL,
    33	  granted_by text NOT NULL,
    34	  created_at timestamptz NOT NULL DEFAULT now(),
    35	  UNIQUE (item_id, grantee_kind, grantee_id)
    36	);
    37	
    38	CREATE INDEX IF NOT EXISTS idx_library_items_kind ON public.library_items (kind);
