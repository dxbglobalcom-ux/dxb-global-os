    55	/** The repository, from this module's own place (packages/kernel/{src,dist}/) — never from the cwd. */
    56	const REPOSITORY = resolve(dirname(fileURLToPath(import.meta.url)), "..", "..", "..");
    57	
    58	/** `p` is `root`, lies inside it, or holds it — both already canonical. */
    59	const overlaps = (p: string, root: string): boolean =>
    60	  p === root || p.startsWith(`${root}${sep}`) || root.startsWith(p === sep ? sep : `${p}${sep}`);
    61	
    62	/** The parts of a Claude home the CLI uses; each must resolve inside the home. */
    63	const HOME_PARTS = ["work", "cache", ".claude.json", ".credentials.json"] as const;
    64	
    65	/**
    66	 * The company's own Claude home (CLAUDE_CONFIG_DIR, and HOME for the call) — by default
    67	 * `~/.local/share/dxb/company-claude`; `DXB_COMPANY_CLAUDE_HOME` moves it. Returned canonical (every
    68	 * link resolved). Refused, so the lane fails closed instead of running from the construction's login,
    69	 * settings and peer registry (as companyCodexHome() does for the gate's Codex): an empty or relative
    70	 * value; a home that is, lies inside or holds the construction's `~/.claude` (the passwd home's, never
    71	 * $HOME) or the repository; a home whose work/, cache/, .claude.json or .credentials.json leads
    72	 * outside it through a link.
    73	 */
    74	export function companyClaudeHome(env: NodeJS.ProcessEnv = process.env): string {
    75	  const user = userInfo().homedir;
    76	  const home = env.DXB_COMPANY_CLAUDE_HOME ?? join(user, ".local", "share", "dxb", "company-claude");
    77	  if (!home || !isAbsolute(home)) {
    78	    throw new Error(`the company Claude home "${home}" is not an absolute path — a relative one resolves elsewhere in the child`);
    79	  }
    80	  const ours = realPath(home);
    81	  const theirs = realPath(join(user, ".claude"));
    82	  if (overlaps(ours, theirs)) {
    83	    throw new Error(`the company Claude home ${home} is the construction's Claude home (${theirs}), lies inside it or holds it — no company call runs from there`);
    84	  }
    85	  const repository = realPath(REPOSITORY);
    86	  if (overlaps(ours, repository)) {
    87	    throw new Error(`the company Claude home ${home} is the repository (${repository}), lies inside it or holds it — no company call runs from there`);
    88	  }
    89	  for (const part of HOME_PARTS) {
    90	    const at = realPath(join(ours, part));
    91	    if (!at.startsWith(`${ours}${sep}`)) {
    92	      throw new Error(`the company Claude home ${home}: its ${part} leads outside it (${at}) — no company call runs from there`);
    93	    }
    94	  }
    95	  return ours;
    96	}
