   239	    // §9: recompile lands on the `system` channel; §15 swallow — a broadcast
   240	    // failure never invalidates the freshly written profile set.
   241	    try {
   242	      await sql`
   243	        SELECT notify_broadcast('system', 'profile.recompiled', ${JSON.stringify({
   244	          actor: "system",
   245	          entity: { kind: "setting", id: "library.profiles" },
   246	          corr: {},
   247	          payload: {
   248	            source_hash: result.sourceHash,
   249	            departments: result.profiles.length,
   250	            employee_profiles: result.employeeProfiles.length,
   251	          },
   252	        })}::jsonb)
   253	      `.execute(db);
   254	    } catch (err) {
   255	      console.warn("[library-profiles] system broadcast swallowed:", err);
   256	    }
   257	
   258	    return { ...result, changed: true, outDir };
   259	  } finally {
   260	    rmSync(staging, { recursive: true, force: true });
   261	  }
   262	}
