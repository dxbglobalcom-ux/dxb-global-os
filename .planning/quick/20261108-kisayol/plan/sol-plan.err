   211	      return { ...result, changed: false, outDir };
   212	    }
   213	
   214	    // §17 atomic swap: files land only after the FULL new set generated fine.
   215	    const emitted = new Set<string>(["_manifest.json"]);
   216	    const manifestBody = {
   217	      source_hash: result.sourceHash,
   218	      generated_at: overrides.generatedAt ?? new Date().toISOString(),
   219	      profiles: result.profiles.map((p) => p.department),
   220	      employee_profiles: result.employeeProfiles.map((p) => p.employee),
   221	    };
   222	    const manifestJson = `${JSON.stringify(manifestBody, null, 2)}\n`;
   223	    for (const file of readdirSync(staging)) {
   224	      copyFileSync(join(staging, file), join(outDir, file));
   225	      emitted.add(file);
   226	    }
   227	    // Manifest is stamped LAST: a crash mid-swap leaves a hash-less dir the
   228	    // next run treats as stale and rewrites.
   229	    writeFileSync(join(outDir, "_manifest.json"), manifestJson, "utf8");
