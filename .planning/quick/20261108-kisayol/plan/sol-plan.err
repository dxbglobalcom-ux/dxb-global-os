    87	CREATE OR REPLACE FUNCTION public.control_library_action(
    88	  p_payload         jsonb,
    89	  p_idempotency_key text
    90	) RETURNS jsonb
    91	LANGUAGE plpgsql SECURITY DEFINER SET search_path = public AS $$
    92	DECLARE
    93	  v_actor      text;
    94	  v_digest     text;
    95	  v_prev       record;
    96	  v_action     text;
    97	  v_item       record;
    98	  v_item_id    uuid;
    99	  v_grant_id   bigint;
   100	  v_grant      record;
   101	  v_grantee    text;
   102	  v_dept_uuid  uuid;
   103	  v_changes    jsonb := '[]'::jsonb;
   104	  v_change_id  bigint;
   105	  v_audit_id   bigint;
   106	  v_resp       jsonb;
   107	  v_detail_tbl text;
   108	  v_detail_id  text;
   109	BEGIN
   110	  v_actor := CASE
   111	    WHEN auth.uid() IS NOT NULL THEN 'ceo'
   112	    WHEN current_user IN ('service_role', 'postgres') THEN 'system'
   113	  END;
   114	  IF v_actor IS NULL THEN
   115	    RETURN jsonb_build_object('ok', false, 'error', 'PERMISSION_DENIED');
   116	  END IF;
   117	
   118	  p_payload := jsonb_strip_nulls(p_payload);
   119	
   120	  v_digest := md5('library|' || p_payload::text);
   121	  SELECT request_digest, response INTO v_prev
   122	    FROM control_idempotency WHERE key = p_idempotency_key;
   123	  IF FOUND THEN
   124	    IF v_prev.request_digest <> v_digest THEN
   125	      RETURN jsonb_build_object('ok', false, 'error', 'IDEMPOTENCY_MISMATCH');
   126	    END IF;
   127	    RETURN v_prev.response;
   128	  END IF;
   129	
   130	  v_action := p_payload->>'action';
   131	  IF v_action IS NULL OR v_action NOT IN
   132	     ('register_item','update_item','grant','revoke_grant') THEN
   133	    RETURN jsonb_build_object('ok', false, 'error', 'VALIDATION_FAILED',
   134	      'detail', 'action must be register_item|update_item|grant|revoke_grant');
   135	  END IF;
