    57	/** Expand one library item to concrete capability names.
    58	 *  tool  → its "<server>.<tool>" name (bare names assume dxb-mcp);
    59	 *  mcp   → "dxb-mcp/<group>" = every pinned dxb-mcp tool with the group's
    60	 *          `<group>_` prefix; "dxb-mcp" = the whole pinned server;
    61	 *  skill/plugin → the item name into the skills allowlist. */
    62	function expandItem(
    63	  row: Pick<GrantRow, "kind" | "name">,
    64	  pinned: { server: string; tool: string }[],
    65	): LibrarySubjectCaps {
    66	  if (row.kind === "skill" || row.kind === "plugin") {
    67	    return { tools: [], skills: [row.name] };
    68	  }
    69	  if (row.kind === "tool") {
    70	    return { tools: [row.name.includes(".") ? row.name : `dxb-mcp.${row.name}`], skills: [] };
    71	  }
    72	  // kind === "mcp"
    73	  const [server, group] = row.name.includes("/")
    74	    ? [row.name.slice(0, row.name.indexOf("/")), row.name.slice(row.name.indexOf("/") + 1)]
    75	    : [row.name, null];
    76	  return {
    77	    tools: pinned
    78	      .filter((p) => p.server === server && (group === null || p.tool.startsWith(`${group}_`)))
    79	      .map((p) => `${p.server}.${p.tool}`),
    80	    skills: [],
    81	  };
    82	}
    83	
    84	function mergeCaps(target: LibrarySubjectCaps, add: LibrarySubjectCaps): void {
    85	  for (const t of add.tools) if (!target.tools.includes(t)) target.tools.push(t);
    86	  for (const s of add.skills) if (!target.skills.includes(s)) target.skills.push(s);
    87	}
    88	
    89	/** Read the active (non-expired) grant record into the generator's layer. */
    90	export async function readLibraryLayer(db: Kysely<DB>): Promise<LibraryLayer> {
    91	  const grants = (
    92	    await sql<GrantRow>`
    93	      SELECT li.kind, li.name, g.grantee_kind, g.grantee_id
    94	        FROM library_grants g
    95	        JOIN library_items li ON li.id = g.item_id
    96	       WHERE li.kind IN ('tool','mcp','skill','plugin')
    97	         AND (g.expires_at IS NULL OR g.expires_at > now())
    98	       ORDER BY li.kind, li.name
    99	    `.execute(db)
   100	  ).rows;
   101	
   102	  const pinned = (
   103	    await sql<{ server: string; tool: string }>`
   104	      SELECT server, tool FROM tool_pins WHERE NOT quarantined ORDER BY server, tool
   105	    `.execute(db)
   106	  ).rows;
   107	
   108	  const byDept: Record<string, LibrarySubjectCaps> = {};
   109	  const byRole: Record<string, LibrarySubjectCaps> = {};
   110	  const byEmployeeId: Record<string, LibrarySubjectCaps> = {};
   111	  for (const g of grants) {
   112	    const caps = expandItem(g, pinned);
   113	    const bucket =
   114	      g.grantee_kind === "department" ? byDept : g.grantee_kind === "role_level" ? byRole : byEmployeeId;
   115	    bucket[g.grantee_id] ??= { tools: [], skills: [] };
   116	    mergeCaps(bucket[g.grantee_id]!, caps);
   117	  }
   118	
   119	  // Employee overlays exist only for employees holding employee-kind grants
   120	  // (role_level grants apply to everyone of that level through the union —
   121	  // they never shrink the department surface on their own).
   122	  const employees: LibraryLayer["employees"] = {};
   123	  const employeeIds = Object.keys(byEmployeeId);
   124	  if (employeeIds.length > 0) {
   125	    const agents = (
   126	      await sql<{ id: string; slug: string; department: string; role_level: string | null }>`
   127	        SELECT id, slug, department, role_level FROM agents
   128	         WHERE id = ANY(${employeeIds}::uuid[])
   129	           AND employment_status IS DISTINCT FROM 'archived'
   130	      `.execute(db)
   131	    ).rows;
   132	    // W9: the departments an employee is ASSIGNED to, beside its home one.
   133	    const assignedBy = new Map<string, string[]>();
   134	    for (const row of (
   135	      await sql<{ agent_id: string; department: string }>`
   136	        SELECT x.agent_id, d.slug AS department
   137	          FROM agent_assignments x
   138	          JOIN departments d ON d.id = x.department_id
   139	         WHERE x.agent_id = ANY(${employeeIds}::uuid[])
   140	         ORDER BY d.slug
   141	      `.execute(db)
   142	    ).rows) {
   143	      const list = assignedBy.get(row.agent_id) ?? [];
   144	      if (!list.includes(row.department)) list.push(row.department);
   145	      assignedBy.set(row.agent_id, list);
   146	    }
   147	    for (const a of agents) {
   148	      const union: LibrarySubjectCaps = { tools: [], skills: [] };
   149	      mergeCaps(union, byEmployeeId[a.id]!);
   150	      if (byDept[a.department]) mergeCaps(union, byDept[a.department]!);
   151	      // The assigned department raises the CEILING (below, in the generator) and grants
   152	      // nothing by itself: least privilege — the seat keeps its home kit and adds only
   153	      // what it was granted BY NAME as an employee. Merging the studio's whole grant set
   154	      // here would hand the borrowed seat every tool the studio ever gains, silently.
   155	      const assigned = assignedBy.get(a.id) ?? [];
   156	      if (a.role_level && byRole[a.role_level]) mergeCaps(union, byRole[a.role_level]!);
   157	      union.tools.sort();
   158	      union.skills.sort();
   159	      employees[a.slug] = {
   160	        department: a.department,
   161	        ...(assigned.length > 0 ? { assignedDepartments: assigned } : {}),
   162	        ...union,
   163	      };
   164	    }
   165	  }
   166	
   167	  for (const caps of Object.values(byDept)) {
   168	    caps.tools.sort();
   169	    caps.skills.sort();
   170	  }
   171	  return { departments: byDept, employees };
   172	}
