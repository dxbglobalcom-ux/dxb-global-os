     m=re.search(r'\\bno (background )?music\\b|\\bwithout (background )?music\\b',s,re.I);hits.append((no,r['id'],r['source_slug'],s[max(0,m.start()-60):m.end()+90]))
   if re.search(r'\\balcohol-free\\b|\\bnon-alcoholic\\b',s,re.I) and len(other)<1:
