   190	/** Full record→profiles compile: read layer, generate into staging, swap only
   191	 *  on hash change, emit the `system` channel event (§9). Deterministic inputs
   192	 *  → deterministic hash; generatedAt is excluded from the hash by design. */
   193	export async function compileLibraryProfiles(
   194	  db: Kysely<DB>,
   195	  overrides: { outDir?: string; generatedAt?: string } = {},
   196	): Promise<CompileLibraryProfilesResult> {
   197	  const packageRoot = join(dirname(fileURLToPath(import.meta.url)), "..");
   198	  const outDir = overrides.outDir ?? profileDir(packageRoot);
   199	  mkdirSync(outDir, { recursive: true });
   200	
   201	  const library = await readLibraryLayer(db);
   202	  const staging = mkdtempSync(join(outDir, ".staging-"));
   203	  try {
   204	    const result = await generateProfilesFromPolicy(db, {
   205	      outDir: staging,
   206	      generatedAt: overrides.generatedAt,
   207	      library,
   208	    });
