     1	#!/usr/bin/env bash
     2	# Install the holding's vendored copy of the scrollcraft skill into the machine's global
     3	# skills path, and prove the installed copy is byte-identical to the one in this repository.
     4	#
     5	# The repository copy at tools/scrollcraft/skill is the ONLY source of truth. The installed
     6	# copy is a product of this script and is replaced by it. Run this after changing the
     7	# vendored copy, and run it with --check to find out whether the two have drifted apart.
     8	#
     9	#   bash tools/scrollcraft/install.sh          install (or reinstall) and verify
    10	#   bash tools/scrollcraft/install.sh --check   verify only, change nothing
    11	#
    12	# Upstream: https://github.com/nateherkai/scroll-craft  pinned at e957985  (MIT)
    13	set -euo pipefail
    14	
    15	REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
    16	SRC="$REPO/tools/scrollcraft/skill"
    17	DST="${CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}/scrollcraft"
    18	
    19	fingerprint() { # sha256 over every file's path and content, order-stable
    20	  (cd "$1" && find . -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1)
    21	}
    22	
    23	[ -d "$SRC" ] || { echo "source missing: $SRC" >&2; exit 1; }
    24	
    25	if [ "${1:-}" != "--check" ]; then
    26	  mkdir -p "$(dirname "$DST")"
    27	  rm -rf "$DST"
    28	  cp -r "$SRC" "$DST"
    29	  echo "installed: $DST"
    30	fi
    31	
    32	[ -d "$DST" ] || { echo "NOT INSTALLED: $DST" >&2; exit 1; }
    33	
    34	a="$(fingerprint "$SRC")"
    35	b="$(fingerprint "$DST")"
    36	echo "repo copy      $a"
    37	echo "installed copy $b"
    38	if [ "$a" = "$b" ]; then
    39	  echo "IDENTICAL — the installed skill is the holding's own copy."
    40	else
    41	  echo "DRIFT — the installed skill is not the repository's copy. Run without --check to restore." >&2
    42	  exit 1
    43	fi
