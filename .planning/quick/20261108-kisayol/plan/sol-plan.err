    98	/**
    99	 * The company's memory drawer (CEO 2026-10-04, company-memory-drawer-2026-10-04): the scheduler binds
   100	 * DXB_MEMORY_ROOT to the company Claude home before any lane runs — always, overwriting whatever the
   101	 * process inherited (Sol's single pass, B2: an inherited value is not validated). Every company Claude
   102	 * child inherits it through the DXB_* allowlist below, so the dxb-mcp child — working in the home's
   103	 * `work` folder — reads and writes the same notes as the scheduler's own recall. Only main.ts calls
   104	 * this; the battery never runs main.ts and keeps its own root through vitest's env. Never throws: a
   105	 * refused home DELETES the root, and memory-router then refuses every note.
   106	 */
   107	export function ensureCompanyMemoryRoot(env: NodeJS.ProcessEnv = process.env): string | undefined {
   108	  try {
   109	    env.DXB_MEMORY_ROOT = companyClaudeHome(env);
   110	  } catch {
   111	    // the home was refused — companyClaudeLoginLine says so; memory stays refused
   112	    delete env.DXB_MEMORY_ROOT;
   113	  }
   114	  return env.DXB_MEMORY_ROOT;
   115	}
   116	
   117	/**
   118	 * What a company call may take from the parent's environment — an allowlist (Sol's single pass on
   119	 * phase 3, A2). The locale, PATH and temp, the terminal and the user's name; the proxy and the CA
   120	 * certificates; LITELLM_BASE_URL (read by @dxb/shared's llmCall/llmEmbed inside the dxb-mcp child);
   121	 * DXB_* — the database URLs and the departments' LiteLLM keys the dxb-mcp child needs — except the
   122	 * home's own knob. Nothing else: no HOME, XDG_*, GIT_*, NODE_OPTIONS, ANTHROPIC_*, CLAUDE*.
   123	 */
   124	const COMPANY_ENV = new Set([
   125	  "PATH", "TMPDIR", "LANG", "TERM", "TZ", "USER", "LOGNAME", "SHELL",
   126	  "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "ALL_PROXY", "http_proxy", "https_proxy", "no_proxy", "all_proxy",
   127	  "NODE_EXTRA_CA_CERTS", "LITELLM_BASE_URL",
   128	]);
   129	const companyEnvName = (k: string): boolean =>
   130	  COMPANY_ENV.has(k) || k.startsWith("LC_") || k.startsWith("SSL_CERT_") || (k.startsWith("DXB_") && k !== "DXB_COMPANY_CLAUDE_HOME");
   131	
   132	export function companyIsolation(env: NodeJS.ProcessEnv = process.env): SdkIsolation | null {
   133	  if (env.DXB_WORKER_ISOLATION === "0") return null;
   134	  const home = companyClaudeHome(env);
   135	  const work = join(home, "work");
   136	  const carried: Record<string, string> = {};
   137	  for (const [k, v] of Object.entries(env)) {
   138	    if (v !== undefined && companyEnvName(k)) carried[k] = v;
   139	  }
   140	  return {
   141	    settingSources: [],
   142	    settings: { autoMemoryEnabled: false },
   143	    persistSession: false,
   144	    strictMcpConfig: true,
   145	    cwd: work,
   146	    env: { ...carried, CLAUDE_CONFIG_DIR: home, HOME: home, XDG_CACHE_HOME: join(home, "cache"), PWD: work },
   147	  };
   148	}
