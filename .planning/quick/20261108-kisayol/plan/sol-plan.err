   423	  const [prompt, head, out] = rest;
   424	  if (!prompt || !head || !out) {
   425	    throw new Error('usage: studio.mjs shot "<prompt>" <head.png> <out.mp4> [--tail b.png] [--dur 5]');
   426	  }
   427	  const dur = Number(flag(rest, "--dur", "5"));
   428	  if (!(dur > 0)) throw new Error(`bad --dur "${flag(rest, "--dur")}"`);
   429	  if (dur > MAX_SHOT_SECONDS) {
   430	    throw new StudioCannot(`a ${dur} s clip (the studio's MiniMax H3 lane makes at most ${MAX_SHOT_SECONDS} s per shot) — chain shorter shots with --tail`);
   431	  }
   432	  const tail = flag(rest, "--tail");
   433	  refuseUrls(head, tail);
   434	  for (const f of [head, tail].filter(Boolean)) if (!fs.existsSync(f)) throw new Error("input not found: " + path.resolve(f));
   435	
   436	  const src = ffprobeSize(head);
   437	  const { width, height } = shotSize(src.w, src.h);
   438	  await requireGate();
   439	
   440	  const id = jobId();
   441	  const staged = [];   // registered BEFORE ffmpeg writes it, so a failed stage leaves nothing
   442	  let leftIn = null;   // the prompt id still inside ComfyUI after a timeout: its inputs stay
   443	  try {
   444	    const first = `sc_${id}_head.png`;
   445	    staged.push(first); stageFrame(head, first, width, height);
   446	    let last = null;
   447	    if (tail) { last = `sc_${id}_tail.png`; staged.push(last); stageFrame(tail, last, width, height); }
   448	    const { graph, frames } = buildGraph({
   449	      kind: "shot", prompt, width, height, seconds: dur, seed: newSeed(),
   450	      prefix: `scrollcraft/sc_${id}`, first_frame: first, last_frame: last,
   451	    });
   452	    process.stderr.write(`  ${path.basename(out)}: ${width}x${height}, ${frames} frames (${(frames / 24).toFixed(2)} s @24fps)\n`);
   453	    const pid = await submit(graph);
   454	    let outputs;
   455	    try {
   456	      outputs = await waitPrompt(pid, { label: path.basename(out), timeoutMs: TIMEOUT_MS ?? 30 * 60 * 1000 });
   457	    } catch (err) {
   458	      if (err.timedOut && !(await cancelPrompt(pid))) {
   459	        leftIn = pid;
   460	        err.message += ` — still in ComfyUI; its inputs are kept: ${staged.map((n) => path.join(ROOT, "input", n)).join(", ")}`;
   461	      } else if (err.timedOut) {
   462	        err.message += " — removed from ComfyUI";
   463	      }
   464	      throw err;
   465	    }
   466	    const f = outputFiles(outputs).find((x) => /\.(mp4|webm|mov)$/i.test(x.filename));
   467	    if (!f) throw new Error(`${path.basename(out)}: completed with no video output: ${JSON.stringify(outputs).slice(0, 300)}`);
   468	    const raw = path.resolve(out) + `.engine-${id}${path.extname(f.filename)}`;
   469	    await fetchOutput(f, raw);
   470	    try {
   471	      // H3 renders a soundtrack beside the picture; a scrubbed clip must not carry one.
   472	      execFileSync(FFMPEG, ["-hide_banner", "-loglevel", "error", "-y", "-i", raw,
   473	        "-map", "0:v:0", "-c", "copy", "-an", "-movflags", "+faststart", path.resolve(out)],
   474	        { stdio: ["ignore", "ignore", "pipe"] });
   475	    } finally {
   476	      fs.rmSync(raw, { force: true });
   477	    }
   478	    console.log(out);
   479	  } finally {
   480	    if (process.env.STUDIO_KEEP_INPUTS !== "1" && !leftIn) {
   481	      for (const n of staged) fs.rmSync(path.join(ROOT, "input", n), { force: true });
   482	    }
