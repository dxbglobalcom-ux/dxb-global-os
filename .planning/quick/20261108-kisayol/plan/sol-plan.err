     9	CREATE TABLE IF NOT EXISTS public.library_items (
    10	  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    11	  kind text NOT NULL CHECK (kind IN (
    12	    'skill','plugin','tool','mcp','prompt_template','persona','policy',
    13	    'governance_rule','workflow','sop','framework','code_component',
    14	    'design_system','research','report','project_doc','training',
    15	    'memory_source','best_practice','lesson_learned')),
    16	  name text NOT NULL,
    17	  version text,
    18	  owner_dept uuid REFERENCES public.departments(id),
    19	  usage_notes text,
    20	  dependencies text[],
    21	  quality_score numeric,
    22	  review_status text,
    23	  last_used_at timestamptz,
    24	  updated_at timestamptz NOT NULL DEFAULT now(),
    25	  UNIQUE (kind, name, version)
    26	);
    27	
    28	CREATE TABLE IF NOT EXISTS public.library_grants (
    29	  id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    30	  item_id uuid NOT NULL REFERENCES public.library_items(id) ON DELETE CASCADE,
    31	  grantee_kind text NOT NULL CHECK (grantee_kind IN ('department','employee','role_level')),
    32	  grantee_id text NOT NULL,
    33	  granted_by text NOT NULL,
    34	  created_at timestamptz NOT NULL DEFAULT now(),
    35	  UNIQUE (item_id, grantee_kind, grantee_id)
    36	);
    37	
    38	CREATE INDEX IF NOT EXISTS idx_library_items_kind ON public.library_items (kind);
    39	CREATE INDEX IF NOT EXISTS idx_library_grants_grantee ON public.library_grants (grantee_kind, grantee_id);
    40	
    41	REVOKE TRUNCATE ON public.library_items, public.library_grants
    42	  FROM PUBLIC, anon, authenticated, service_role;
    43	
    44	-- RLS + read surface (DATA_MODEL §11: agents read their own grants via the
    45	-- gateway query — that path is service-side; the CEO sees everything).
    46	ALTER TABLE public.library_items  ENABLE ROW LEVEL SECURITY;
    47	ALTER TABLE public.library_grants ENABLE ROW LEVEL SECURITY;
    48	
    49	GRANT SELECT ON public.library_items, public.library_grants TO authenticated;
    50	
    51	DROP POLICY IF EXISTS library_items_ceo_read ON public.library_items;
    52	CREATE POLICY library_items_ceo_read ON public.library_items FOR SELECT TO authenticated USING (true);
    53	DROP POLICY IF EXISTS library_grants_ceo_read ON public.library_grants;
    54	CREATE POLICY library_grants_ceo_read ON public.library_grants FOR SELECT TO authenticated USING (true);
    55	
    56	COMMENT ON TABLE public.library_items is
    57	  '0024x knowledge family: holding-wide inventory (directive item 13); tool_pins bridges to this family for version pinning.';
    58	COMMENT ON TABLE public.library_grants is
    59	  '0024x knowledge family: who may use which item (department/employee/role_level) — CEO-configured, gateway-enforced.';
