     1	#!/usr/bin/env bash
     2	# W11 (CEO 2026-09-15, "tmm başla") — THE PRODUCT REGISTER'S PERMANENT GATE.
     3	#
     4	# The vitrin and the catalogue are what the CEO opens to see what the studio has produced
     5	# (`~/tools/h3/studio/`, outside git, temporary until B32 draws the studio's own tab). Audit W11
     6	# measured what an ungated register drifts into in twelve days: a cast card template that told him
     7	# every face was drawn in FLUX — including the two the engine itself bore; the voice hand he
     8	# cancelled on 2026-09-04 still advertised as a live engine; 2K promises that outlived his 1080p
     9	# ceiling; pointers into a folder he had deleted by hand; AHMET's reference frames filed under
    10	# another man's code; and twenty-five acceptance claims with no registered word of his behind them.
    11	#
    12	# So the register is gated the way the repository is gated. This file is the door: it reads the
    13	# living artefacts and fails on the classes of drift that were found, not on their instances.
    14	# The audit's own ruler (CHECK-W11-2026-09-15.sh) additionally RENDERS the page; this gate reads
    15	# the source, so it runs anywhere, in a second, with no browser.
    16	#
    17	#   bash scripts/b43/vitrin-register-gate.sh          # exit 0 = the register tells the truth
    18	#
    19	# A machine without the vitrin (a clone, CI) is not a failure — there is nothing to gate there.
    20	set -uo pipefail
    21	
    22	V="${DXB_VITRIN_DIR:-$HOME/tools/h3/studio}"
    23	IDX="$V/index.html"; KAT="$V/KATALOG.md"; MEDIA="$V/media"
    24	REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
    25	LEDGER="$REPO/scripts/governance/ceo-approvals.json"
    26	UNIT="$HOME/.config/systemd/user/dxb-vitrin.service"
    27	fail=0
    28	ok(){ printf "PASS  %-58s %s\n" "$1" "$2"; }
    29	no(){ printf "FAIL  %-58s %s\n" "$1" "$2"; fail=1; }
    30	chk(){ if [[ "$2" =~ $3 ]]; then ok "$1" "$2"; else no "$1" "$2 (expected: $3)"; fi; }
    31	
    32	if [[ ! -f "$IDX" ]]; then
    33	  echo "vitrin not on this machine ($V) — nothing to gate"; exit 0
    34	fi
    35	
    36	echo "== VITRIN REGISTER GATE — $V"
    37	
    38	# 1. the cast card names how each face was born, per person, and the template invents nothing
    39	chk "1  every cast entry carries its own origin (kaynak)" \
    40	    "$(( $(grep -c 'slug:"' "$IDX") - $(grep -c 'kaynak:"' "$IDX") ))" "^0$"
    41	chk "2  the card template renders that origin, never a fixed engine name" \
    42	    "$(grep -c '<span class="t">\${p.kaynak}</span>' "$IDX")" "^1$"
    43	
    44	# 2. a hand the CEO cancelled is not advertised as a live one
    45	chk "3  the cancelled TTS hand is not named on the vitrin or in the catalogue" \
    46	    "$(( $(grep -c 'edge-tts' "$IDX") + $(grep -c 'edge-tts' "$KAT") ))" "^0$"
    47	chk "4  no 2K promise outside his 1080p ceiling ruling" \
    48	    "$(grep -h '2K\|1440×2592\|1440x2592' "$IDX" "$KAT" | grep -vic 'iptal\|tavan\|1080p')" "^0$"
    49	
    50	# 3. nothing points at what he deleted
    51	chk "5  no pointer into the folder he deleted 2026-09-04" \
    52	    "$(( $(grep -c 'Medya OS' "$IDX") + $(grep -c 'Medya OS' "$KAT") ))" "^0$"
    53	
    54	# 4. a person's files carry that person's code
    55	chk "6  AHMET's frames are filed under his own code (no a006-birth)" \
    56	    "$(( $(grep -c 'a006-birth' "$IDX") + $(ls "$MEDIA" 2>/dev/null | grep -c '^a006-birth') ))" "^0$"
    57	
    58	# 5. LAW B on his own showcase: an acceptance claim names the registered word behind it
    59	chk "7  acceptance claims without a registered ledger id" \
    60	    "$(python3 - "$LEDGER" "$IDX" "$KAT" <<'PY'
    61	import json,re,sys
    62	keys=set(json.load(open(sys.argv[1])).keys()); n=0
    63	for f in sys.argv[2:]:
    64	    for line in open(f,encoding='utf-8'):
    65	        if re.search(r'kabul',line,re.I) and not any(k in line for k in keys): n+=1
    66	print(n)
    67	PY
    68	)" "^0$"
    69	
    70	# 6. every file the page shows him exists
    71	chk "8  media referenced by the page but missing on disk" \
    72	    "$(grep -o 'media/[^"'"'"' )>?#]*' "$IDX" | sed 's#^media/##' | sort -u | grep -v '\${' | while read -r f; do [[ -e "$MEDIA/$f" ]] || echo "$f"; done | wc -l)" "^0$"
    73	
    74	# 7. the counters are counted from the page, never typed by hand
    75	chk "9  hand-written tab counters in the source" "$(grep -c '<span class="c">[0-9]' "$IDX")" "^0$"
