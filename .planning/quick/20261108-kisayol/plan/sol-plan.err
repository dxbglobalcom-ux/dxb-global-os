   231	    // fully revoked AND department files for slugs no longer in the registry
   232	    // (the E5.x org rebuild left orphan dept files behind — found+fixed E9.5).
   233	    for (const file of readdirSync(outDir)) {
   234	      if (file.endsWith(".mcp.json") && !emitted.has(file)) {
