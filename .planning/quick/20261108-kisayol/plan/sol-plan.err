    39	        "1": {"class_type": "UNETLoader",
    40	              "inputs": {"unet_name": DENOISER, "weight_dtype": "default"}},
    41	        "2": {"class_type": "CLIPLoader",
    42	              "inputs": {"clip_name": TEXT_ENCODER, "type": "minimax", "device": "default"}},
    43	        "3": {"class_type": "VAELoader", "inputs": {"vae_name": VIDEO_VAE}},
    44	        "4": {"class_type": "VAELoader", "inputs": {"vae_name": AUDIO_VAE}},
    45	        "6": {"class_type": "MiniMaxH3SigmaShift",
    46	              "inputs": {"model": ["5", 0] if lora else ["1", 0], "shift_video": 12.0, "shift_audio": 3.0}},
    47	        "7": {"class_type": "MiniMaxH3ImageToVideo",
