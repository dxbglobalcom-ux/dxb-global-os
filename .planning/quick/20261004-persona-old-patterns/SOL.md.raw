for line in raw.splitlines():
 if line.startswith('+++ b/'):file=line[6:]
 if line.startswith(('+','-')) and not line.startswith(('+++','---')):
  l=line[1:]; l=l[2:] if l.startswith('- ') else l
  if any(l.startswith(t) for t in common):continue
