    62	  # judging; this only names the candidates, so a refusal here is the door speaking, not the script.
    63	  rows="$("${PSQL[@]}" -c "
    64	    SELECT a.id::text || '|' || a.slug || '|' || p.id::text || '|v' || p.version::text
    65	      FROM public.agents a
    66	      JOIN LATERAL (
    67	        SELECT id, version FROM public.personas
    68	         WHERE employee_id = a.id AND quality_gate = 'passed'
    69	         ORDER BY version DESC LIMIT 1
    70	      ) p ON TRUE
    71	     WHERE a.persona_id IS DISTINCT FROM p.id
    72	     ORDER BY a.slug")"
    73	  bound=0; refused=0
    74	  if [ -z "${rows//[[:space:]]/}" ]; then
    75	    echo "BIND: nothing to bind — every employee already carries its newest passed persona"
    76	  else
    77	    while IFS='|' read -r aid slug pid pver; do
    78	      [ -n "$aid" ] || continue
    79	      if [ "$DRY" = 1 ]; then
    80	        echo "WOULD BIND $slug -> $pid ($pver)"; continue
    81	      fi
    82	      # </dev/null: PSQL is `docker exec -i`, which would otherwise swallow the rest of this loop's
    83	      # here-string — measured 2026-10-04: 213 candidates, one bound, the loop then saw no input.
    84	      if "${PSQL[@]}" -c "SELECT public.fn_persona_bind('$aid'::uuid, '$pid'::uuid, 'persona-sync');" >/dev/null 2>&1 </dev/null; then
    85	        echo "BOUND $slug -> $pid ($pver)"; bound=$((bound+1))
    86	      else
    87	        echo "REFUSED $slug -> $pid — the door said no (gate, author or ownership); run the statement by hand to see its message"; refused=$((refused+1))
    88	      fi
    89	    done <<< "$rows"
    90	    echo "---"
    91	    echo "bind: $bound · refused: $refused"
    92	    [ "$refused" -eq 0 ] || exit 1
    93	  fi
    94	  exit 0
    95	fi
    96	
    97	files=("$@")
    98	if [ ${#files[@]} -eq 0 ]; then
    99	  mapfile -t files < <(find "$REPO_DIR/personas" -mindepth 2 -name '*.md' | sort)
   100	fi
   101	
   102	# THE RULER (CEO emri 2026-09-15) — bir denetimin cetveli çalıştırılabilir bir betiktir ve iş
   103	# BAŞLAMADAN önce yazarın eline verilir. Kural ihlali olan bir dosya DB'ye girmez: submit modunda
   104	# cetvel bir kez koşar, tablosu basılır ve FAIL alan dosya atlanır (fail closed). Cetvelin sözleşmesi
   105	# tests/personas/persona-ruler.concepts.json — orada adı geçmeyen persona ÖLÇÜLMEZ ve eskisi gibi
   106	# submit edilir; cetvel stüdyonun 16 koltuğu için yazıldı, yazım geçişi emredilmemiş bir departmanın
   107	# önüne dikilmez. --verify modu değişmedi.
   108	declare -A RULER_VERDICT=()
   109	if [ "$MODE" = "submit" ]; then
   110	  ruler_out="$(bash "$REPO_DIR/scripts/persona-ruler.sh" --verdicts "${files[@]}" 2>&1 || true)"
   111	  printf '%s\n' "$ruler_out" | grep -v '^RULER-VERDICT' || true
   112	  while IFS=$'\t' read -r _ rslug rverdict; do
   113	    [ -n "${rslug:-}" ] && RULER_VERDICT["$rslug"]="$rverdict"
   114	  done < <(printf '%s\n' "$ruler_out" | grep '^RULER-VERDICT' || true)
   115	fi
   116	
   117	extract_body() { # dosyadan persona gövdesi: ilk '# PERSONA — ' satırından sona
   118	  awk '/^# PERSONA — /{f=1} f{print}' "$1"
   119	}
   120	
   121	extract_title() { # SİCİL alan 3 (EN, post-directive): '| 3 | Title | X |' → X
   122	  # TR-dönemi dosyalarda (alan adı "Unvan", H1 karışık dilli) BOŞ döner —
   123	  # DB'deki dil-ayrıştırılmış backfill (migration 20260713010000) ezilmez.
   124	  # `|| true`: Title satırı yok → grep exit 1; set -euo pipefail altında bu
   125	  # scripti öldürüyordu (R1.8 dalgasında ilk dosyada ölüm) — boş dönüş kasıtlı.
   126	  grep -m1 -oP '^\| 3 \| Title \| \K[^|]+' "$1" | sed 's/ *$//' || true
   127	}
   128	
   129	submitted=0; verified=0; mismatched=0; skipped=0; failed=0
   130	for f in "${files[@]}"; do
   131	  slug="$(basename "$f" .md)"
   132	  body="$(extract_body "$f")"
   133	  if [ -z "$body" ]; then
   134	    echo "SKIP  $slug — ⏳ Fable-yazımı bekliyor (persona gövdesi yok)"
   135	    skipped=$((skipped+1)); continue
   136	  fi
   137	  if [ "$MODE" = "submit" ] && [ "${RULER_VERDICT[$slug]:-SKIP}" = "FAIL" ]; then
   138	    echo "FAIL  $slug — persona cetveli reddetti (yukarıdaki tablo; kural ihlali olan dosya DB'ye girmez)"
   139	    failed=$((failed+1)); continue
   140	  fi
   141	  if printf '%s' "$body" | grep -q '\$dxb_body\$'; then
   142	    echo "FAIL  $slug — gövde dollar-quote çakışması"; failed=$((failed+1)); continue
   143	  fi
   144	  emp_id="$("${PSQL[@]}" -c "SELECT id FROM agents WHERE slug='$slug';")"
   145	  if [ -z "$emp_id" ]; then
   146	    echo "FAIL  $slug — agents tablosunda yok"; failed=$((failed+1)); continue
   147	  fi
   148	  if [ "$MODE" = "verify" ]; then
   149	    db_hash="$("${PSQL[@]}" -c "SELECT md5(body_md) FROM personas WHERE employee_id='$emp_id' ORDER BY version DESC LIMIT 1;")"
   150	    file_hash="$(printf '%s\n' "$body" | md5sum | cut -d' ' -f1)"
   151	    if [ "$db_hash" = "$file_hash" ]; then
   152	      echo "MATCH $slug — DB↔dosya gövde eş (md5 $file_hash)"; verified=$((verified+1))
   153	    else
   154	      echo "DIFF  $slug — DB($db_hash) ≠ dosya($file_hash) — sync gerekli"; mismatched=$((mismatched+1))
   155	    fi
   156	  else
   157	    # The psql exit code is NOT trusted alone here: with a heredoc the client can still return 0
   158	    # while the server refused the INSERT. The returned persona id IS the proof of a write, so an
   159	    # empty id is treated as a failure. Measured 2026-07-27: a CHECK-constraint refusal
   160	    # (personas_author_check) printed its error and the run still reported "submit: 1 · fail: 0" —
   161	    # a script that reports success for work the database refused is worse than no script.
   162	    if ! pid="$("${PSQL[@]}" <<SQL
   163	SELECT public.fn_persona_submit('$emp_id'::uuid, \$dxb_body\$$body
   164	\$dxb_body\$, '$AUTHOR');
   165	SQL
   166	)" || [ -z "${pid//[[:space:]]/}" ]; then
   167	      echo "FAIL  $slug — submit reddedildi (DB yazmadı; yukarıdaki hataya bak)"; failed=$((failed+1)); continue
   168	    fi
   169	    echo "SUBMIT $slug — persona id: $pid · author: $AUTHOR (pending; gate verdikti ayrı adım)"
   170	    # Unvan da dosyadan akar (tek yön, E6.3 fix wave 3): dossier Title → agents.title (EN kanonik)
   171	    title="$(extract_title "$f")"
   172	    if [ -n "$title" ]; then
   173	      "${PSQL[@]}" -c "UPDATE agents SET title='${title//\'/\'\'}' WHERE id='$emp_id';" >/dev/null
   174	    fi
   175	    submitted=$((submitted+1))
   176	  fi
   177	done
   178	
   179	echo "---"
   180	if [ "$MODE" = "verify" ]; then
   181	  echo "match: $verified · diff: $mismatched · skip(⏳): $skipped · fail: $failed"
   182	  [ $mismatched -eq 0 ] && [ $failed -eq 0 ] && echo "VERIFY: PASS" || { echo "VERIFY: FAIL"; exit 1; }
   183	else
   184	  echo "submit: $submitted · skip(⏳): $skipped · fail: $failed"
   185	  [ $failed -eq 0 ] || exit 1
   186	fi
