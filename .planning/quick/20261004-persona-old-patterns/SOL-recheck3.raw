from pathlib import Path
import subprocess,re
files=subprocess.check_output(['git','diff','--name-only','0467dbb6..HEAD','--','personas'],text=True).splitlines()
ids=[]
for f in files:
 s=Path(f).read_text();m=re.search(r'"'^'"\\| 3 \\| Title \\| (["'^|]+)'"',s,re.M)
 if m: ids.append(Path(f).stem)
submitted=[]
for l in Path('.planning/quick/20261004-persona-old-patterns/evidence/submit.log').read_text().splitlines():
 if l.startswith('SUBMIT '):submitted.append(l.split()[1])
print('Title-bearing submitted personas:', len(set(ids)&set(submitted)))
print('Title-bearing but not submitted:', sorted(set(ids)-set(submitted)))
for fn in ['bind.log','bind2.log']:
 p=Path('.planning/quick/20261004-persona-old-patterns/evidence')/fn
 print(str(p)+':'+str(len(p.read_text().splitlines())),p.read_text().splitlines()[-1])
for p in Path('.planning/quick/20261004-persona-old-patterns/evidence').glob('tests*.txt'):
 print(p)
 for i,l in enumerate(p.read_text().splitlines(),1):
  if 'Test Files' in l or 'Tests ' in l:print(i,l)
PY
