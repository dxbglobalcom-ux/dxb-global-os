/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import subprocess
s=Path('scripts/sync-personas-to-db.sh').read_text()
bind=s[s.index('if [ \""'$MODE" = "bind" ]; then'"'):s.index('\\nfiles=(\""'$@")'"')]
mock='''MODE=bind; DRY=0; PSQL=(mock_psql)
mock_psql() {
 if [[ \""'$*" == *'"'JOIN LATERAL'* ]]; then
  printf 'a1|seat1|p1|v3\\\\na2|seat2|p2|v3\\\\na3|seat3|p3|v3\\\\n'
 else
  cat >/dev/null
  printf 'persona-id\\\\n'
 fi
}
'''
for label,code in [('before',bind.replace(' 2>&1 </dev/null;',' 2>&1;')),('after',bind)]:
 r=subprocess.run(['bash','-c',mock+code],capture_output=True,text=True,input='')
 print(label, 'exit',r.returncode,r.stdout.strip())
