    39	
    40	// The one number the CEO reads on the bar. Returns null when Claude Code sent no meter.
    41	function usedPercent(cw) {
    42	  const remaining = cw?.remaining_percentage;
    43	  if (remaining == null) return null;
    44	  const total = cw.total_tokens || 1_000_000;
