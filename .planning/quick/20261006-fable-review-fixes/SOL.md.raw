    96	# ── THE BENCH'S OWN RULER (CEO 2026-09-21: "tezgah kendini temizlesin her zaman
    97	# bu sorunlarla karşılaşmayalım temiz işle ilerleyelim").
    98	#
    99	# A suite that leaves rows behind poisons the next audit, and for months the
   100	# only way to learn that was for a later run to go red for a reason that had
   101	# nothing to do with the code under test — three files did exactly that on
   102	# 2026-09-21, counting work another suite's scheduler had done. So the battery
   103	# now measures itself: every table in the construction engine's public schema
   104	# is counted before and after, and a table that GREW names itself and turns the
   105	# battery red. pg-boss's own schema is excluded — it is the queue's bookkeeping,
   106	# not the company's record.
   107	#
   108	# It measures the CONSTRUCTION engine and nothing else (port 54422).
   109	#
   110	# FOUR THINGS THE FIRST VERSION OF THIS RULER GOT WRONG, each one measured by
   111	# the adversarial pass on the day it was written (2026-09-21):
   112	#   · it compared with `>` and so was blind to SHRINKING — which is the very
   113	#     fault that started this work, a suite deleting another suite's rows;
   114	#   · it counted only the `public` schema, and `dxb_internal.ops_live_issued`
   115	#     grew 0 -> 247 under it while it reported "no suite left a row behind";
   116	#   · it used an inner join, so a table BORN or DROPPED during the run fell
   117	#     silently out of the comparison;
   118	#   · when it could not measure at all it still printed "residue: none" and
   119	#     allowed BATTERY_GREEN — a ruler that cannot see must say so, not agree.
   120	# WHAT IT COUNTS, and the list is deliberate. `public` and `dxb_internal` are
   121	# the schemas this repository's own migrations build — the bench's record of
   122	# the company. Everything else on the engine belongs to somebody else's
   123	# machinery and churns on its own: `pgboss` is the queue's bookkeeping,
   124	# `realtime` grew 642 rows in one run with no suite involved, and `auth`,
   125	# `storage`, `net`, `vault` and the supabase_* schemas are the platform's.
   126	BENCH_URL="${DXB_CONSTRUCTION_URL:-postgresql://postgres:postgres@127.0.0.1:54422/postgres}"
   127	bench_counts() {
   128	  local q
   129	  q=$(psql -tA "$BENCH_URL" -c "SELECT string_agg(format('SELECT %L AS t, count(*)::bigint AS n FROM %I.%I', schemaname||'.'||tablename, schemaname, tablename), ' UNION ALL ') FROM pg_tables WHERE schemaname IN ('public','dxb_internal');" 2>/dev/null) || return 1
   130	  [ -z "$q" ] && return 1
   131	  # COLLATE "C" and LC_ALL=C below so the two lists are ordered by the same
   132	  # rule; join needs that, and the server's collation is not the shell's.
   133	  psql -tA -F'|' "$BENCH_URL" -c "SELECT t, n FROM ($q) s ORDER BY t COLLATE \"C\";" 2>/dev/null
   134	}
   135	BEFORE_ROWS="$(PGPASSWORD=postgres bench_counts || true)"
   136	if [ -z "$BEFORE_ROWS" ]; then
   137	  echo "⚠ UNVERIFIED — the bench ruler could not read $BENCH_URL; residue is NOT measured this run"
   138	fi
   139	
   140	echo "=== 1/2 · THE CONSTRUCTION RUNTIME — the sandboxed suite ==="
   141	EXCLUDES=()
   142	for f in "${HOST_FILES[@]}"; do EXCLUDES+=(--exclude "$f"); done
   143	bash scripts/construction/run.sh pnpm vitest run "${EXCLUDES[@]}"
   144	sandboxed=$?
   145	
   146	echo
   147	echo "=== 2/2 · THE AUTHOR'S HAND — on the company's side, outside the sandbox ==="
   148	for f in "${HOST_FILES[@]}"; do echo "    $f"; done
   149	pnpm vitest run "${HOST_FILES[@]}"
   150	host=$?
   151	
   152	echo
   153	echo "=== THE BENCH'S OWN RULER — what this run left behind ==="
   154	# 0 = measured and clean · 1 = measured and dirty · 2 = could not be measured
   155	residue=2
   156	if [ -n "$BEFORE_ROWS" ]; then
   157	  AFTER_ROWS="$(PGPASSWORD=postgres bench_counts || true)"
   158	  if [ -z "$AFTER_ROWS" ]; then
   159	    echo "⚠ UNVERIFIED — the bench could not be re-counted; residue unknown for this run"
   160	  else
   161	    # -a1 -a2: a table that exists on only ONE side is reported too, never
   162	    # dropped. The empty side reads as '-' and the line says so.
   163	    moved=$(join -t'|' -a1 -a2 -e '-' -o '0,1.2,2.2' \
   164	              <(LC_ALL=C sort -t'|' -k1,1 <<<"$BEFORE_ROWS") \
   165	              <(LC_ALL=C sort -t'|' -k1,1 <<<"$AFTER_ROWS") \
   166	            | awk -F'|' '$2 != $3 {
   167	                 if ($2 == "-")      printf "    %-34s (absent) -> %s   table appeared\n", $1, $3;
   168	                 else if ($3 == "-") printf "    %-34s %s -> (absent)   table vanished\n", $1, $2;
   169	                 else                printf "    %-34s %s -> %s  (%+d)\n", $1, $2, $3, $3-$2;
   170	               }')
   171	    if [ -n "$moved" ]; then
   172	      echo "    a suite changed the construction engine — it must leave what it found:"
   173	      echo "$moved"
   174	      residue=1
   175	    else
   176	      echo "    every table is the size it was — no suite left or took a row"
   177	      residue=0
   178	    fi
   179	  fi
   180	fi
   181	
   182	echo
   183	echo "sandboxed suite : exit $sandboxed"
   184	echo "host suite      : exit $host"
   185	case "$residue" in
   186	  0) echo "bench residue   : none" ;;
   187	  1) echo "bench residue   : LEFT_BEHIND" ;;
   188	  *) echo "bench residue   : UNVERIFIED — not measured, so not green" ;;
   189	esac
   190	if [ "$sandboxed" -ne 0 ] || [ "$host" -ne 0 ] || [ "$residue" -ne 0 ]; then
   191	  echo "BATTERY_RED"
   192	  exit 1
   193	fi
   194	echo "BATTERY_GREEN"
     1	#!/usr/bin/env bash
     2	# B36 · Block 3-bis — THE DOOR THE CONSTRUCTION SITE RUNS THROUGH.
     3	#
     4	# This file is deliberately thin. The wall itself — the identity it drops to, the
     5	# empty network namespace, the list of ports that may be carried in, what is
     6	# bound and what is not — lives in a ROOT-OWNED program the construction cannot
     7	# rewrite:
     8	#
     9	#   /usr/local/sbin/dxb-construction-sandbox
    10	#
    11	# Its reviewable source is scripts/construction/sandbox.sh, and
    12	# scripts/construction/install-wall.sh is what puts it in place. If the two ever
    13	# differ, tests/b36/company-is-read-only.test.ts says so.
    14	#
    15	# Usage:  scripts/construction/run.sh <command …>
    16	#         scripts/construction/run.sh pnpm test
    17	set -euo pipefail
    18	
    19	WALL=/usr/local/sbin/dxb-construction-sandbox
    20	
    21	if [ ! -x "$WALL" ]; then
    22	  echo "the construction wall is not installed: $WALL" >&2
    23	  echo "install it:  bash scripts/construction/install-wall.sh" >&2
    24	  exit 2
    25	fi
    26	
    27	# ── THE ENGINE IS TAKEN OUT HERE, ON THE HOST SIDE ──────────────────────────
    28	# One run at a time on one bench, and the door is where that is decided for
    29	# everything that goes through it. It cannot be decided on the other side:
    30	# measured 2026-09-21, inside the wall `/tmp` is a fresh tmpfs, so the lock file
    31	# is not even visible there, and no environment variable of ours crosses either.
    32	# So the lock is held HERE, by this shell, for as long as the command inside
    33	# runs — which is also why the wall is no longer `exec`ed: a shell that has been
    34	# replaced is a shell that is no longer holding anything.
    35	# The battery sets DXB_ENGINE_LOCK_HELD before it calls this door, because it is
    36	# already holding the same lock and must not queue behind itself.
    37	LOCK="${TMPDIR:-/tmp}/dxb-construction-battery.lock"
    38	if [ -z "${DXB_ENGINE_LOCK_HELD:-}" ] && command -v flock >/dev/null 2>&1; then
    39	  exec 200>"$LOCK"
    40	  # DXB_ENGINE_LOCK_WAIT=<seconds> (dxb-team2 §5, 2026-10-06): parallel writers
    41	  # queue for the engine instead of colliding on it. A positive integer only;
    42	  # anything else is today's immediate refusal.
    43	  WAIT="${DXB_ENGINE_LOCK_WAIT:-}"
    44	  [[ "$WAIT" =~ ^[1-9][0-9]*$ ]] || WAIT=""
    45	  if ! flock -n 200 && { [ -z "$WAIT" ] || {
    46	        echo "waiting up to $WAIT s for the construction engine…" >&2
    47	        ! flock -w "$WAIT" 200; }; }; then
    48	    echo "REFUSED: another run already holds the construction engine." >&2
    49	    echo "         Two runs on one bench measure each other, not the code. Wait for it," >&2
    50	    echo "         or point this one elsewhere with DXB_CONSTRUCTION_URL." >&2
    51	    exit 2
    52	  fi
    53	  export DXB_ENGINE_LOCK_HELD=1
    54	elif ! command -v flock >/dev/null 2>&1; then
    55	  echo "⚠ UNVERIFIED — flock is not installed, so a concurrent run cannot be ruled out" >&2
    56	fi
    57	
    58	rc=0
    59	sudo -n "$WALL" "$@" || rc=$?
    60	exit "$rc"

