   126	
   127	def read_regular(name, dir_fd=None, limit=SMALL_BYTES, tail=False):
   128	    """At most `limit` bytes of a regular file (its last `limit` bytes when `tail`), or None -- a link, a FIFO or
   129	    nothing is None. A read error is raised; each source catches its own. A file growing while it is read is
   130	    still read no further than `limit`."""
   131	    try:
   132	        fd = os.open(name, FILE_FLAGS, dir_fd=dir_fd)
   133	    except OSError:
   134	        return None
   135	    try:
   136	        info = os.fstat(fd)
   137	        if not stat.S_ISREG(info.st_mode):
   138	            return None
   139	        if tail and info.st_size > limit:
   140	            os.lseek(fd, info.st_size - limit, os.SEEK_SET)
   141	        chunks = []
   142	        left = limit
   143	        while left > 0:
   144	            chunk = os.read(fd, min(65536, left))
   145	            if not chunk:
   146	                break
   147	            chunks.append(chunk)
   148	            left -= len(chunk)
   149	        return b"".join(chunks)
   150	    finally:
   151	        os.close(fd)
