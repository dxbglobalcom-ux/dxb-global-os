   138	// HISTORY_KEEP_HOURS once it passes HISTORY_MAX_LINES lines. Best effort, like the record.
   139	const HISTORY_MIN_GAP_S = 60;
   140	const HISTORY_MAX_LINES = 2000;
   141	const HISTORY_KEEP_HOURS = 24;
   142	
   143	function persistRateHistory(dir, rec) {
   144	  try {
   145	    const file = path.join(dir, 'rate-limits-history.jsonl');
   146	    const ts = Date.parse(rec.written_at) / 1000;
   147	    const line = JSON.stringify({ ts, seven_day: rec.seven_day, five_hour: rec.five_hour });
   148	    let lines = [];
   149	    try { lines = fs.readFileSync(file, 'utf8').split('\n').filter(Boolean); } catch { /* none yet */ }
   150	    const parse = l => { try { return JSON.parse(l); } catch { return null; } };
   151	    const used = w => (w && typeof w === 'object' ? w.used_percentage : undefined);
   152	    const last = lines.length ? parse(lines[lines.length - 1]) : null;
   153	    const unchanged = Boolean(last) && typeof last.ts === 'number' && ts - last.ts < HISTORY_MIN_GAP_S
   154	      && used(last.seven_day) === used(rec.seven_day) && used(last.five_hour) === used(rec.five_hour);
   155	    if (!unchanged) lines.push(line);
   156	    if (lines.length > HISTORY_MAX_LINES) {
   157	      const cutoff = ts - HISTORY_KEEP_HOURS * 3600;
   158	      const kept = lines.filter(l => { const e = parse(l); return e && typeof e.ts === 'number' && e.ts >= cutoff; });
