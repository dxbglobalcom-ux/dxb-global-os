    26	function formatTokens(t) {
    27	  if (t >= 1_000_000 || Math.round(t / 1000) >= 1000) return (t / 1_000_000).toFixed(1) + 'M';
    28	  if (t >= 1000) return Math.round(t / 1000) + 'k';
