   109	def open_dir(path, create=False, private=True):
   110	    """A descriptor on the folder, or None when it is missing or not to be trusted."""
   111	    if create:
   112	        try:
   113	            os.mkdir(path, 0o700)
   114	        except FileExistsError:
   115	            pass
   116	    try:
   117	        fd = os.open(path, DIR_FLAGS)
   118	    except OSError:  # missing, or a link (O_NOFOLLOW), or not a directory
   119	        return None
   120	    info = os.fstat(fd)
   121	    if info.st_uid != os.getuid() or (private and info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
   122	        os.close(fd)
   123	        return None
   124	    return fd
