   274	      /served twice, cannot be stored: b49-fixture\.toolA/,
   275	    );
   276	
   277	    // (b) A server named `__proto__` was invisible to BOTH sides of the count
   278	    // gate (assignment to that key on a plain object is swallowed), so the file
   279	    // could carry a row it never declared and the gate called them equal.
   280	    const sneaky: ToolPinsManifest = {
