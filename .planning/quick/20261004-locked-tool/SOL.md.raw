    39	const mIdx = args.indexOf("--manifest");
    40	const manifestPath = mIdx >= 0 ? args[mIdx + 1]! : join(REPO, MANIFEST_RELATIVE_PATH);
    41	const auditId = args.find((a, i) => /^\d+$/.test(a) && args[i - 1] !== "--manifest");
    42	
    43	function fail(msg: string): never {
    44	  console.error(`manifest-add: ${msg}`);
    45	  process.exit(1);
    46	}
    47	
    48	if (!auditId) fail("usage: manifest-add <audit_id> [--yes] [--manifest <path>]");
    49	
    50	const db = getDb();
    51	try {
    52	  const row = (
    53	    await sql<{ action: string; payload: Record<string, unknown> }>`
    54	      SELECT action, payload FROM audit_log WHERE id = ${Number(auditId)}
    55	    `.execute(db)
    56	  ).rows[0];
    57	  if (!row) fail(`audit record ${auditId} does not exist`);
    58	  if (row.action !== "tool_quarantined") fail(`audit record ${auditId} is '${row.action}', not a lock (tool_quarantined)`);
