    66	const ABOUT =
    67	  "The external MCP tool corpus the construction seed pins from. Refreshed BY HAND from the " +
    68	  "live servers (pnpm construction:pins:refresh) and checked against them (pnpm construction:pins:check); " +
    69	  "the seed only ever reads this file. dxb-mcp is deliberately absent — its tools are read " +
    70	  "in-process from this repository's own source, so a file copy could only go stale.";
