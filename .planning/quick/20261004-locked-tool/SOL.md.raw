   303	        { server: "b49", tool: "x.y", description: "two", inputSchema: {}, schema_hash: hashOf("two", {}) },
   304	      ],
   305	    };
   306	    expect(verifyManifest(collide).map((e) => e.tool)).toEqual(["y", "x.y"]);
