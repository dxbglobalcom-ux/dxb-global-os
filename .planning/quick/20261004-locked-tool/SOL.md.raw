   132	    const source = value as Record<string, unknown>;
   133	    const out: Record<string, unknown> = {};
   134	    for (const key of Object.keys(source).sort(byName)) out[key] = sortKeysDeep(source[key]);
   135	    return out;
   136	  }
   137	  return value;
   138	}
