   266	  it("(10) the three holes the SECOND adversarial round found in the first round's fixes", () => {
   267	    const hashOf = (description: string, inputSchema: unknown): string =>
   268	      computeToolHash({ description, inputSchema });
   269	
   270	    // (a) The write path had no duplicate gate, so `refresh` could write a file
   271	    // its own reader refuses — the very reason the schemaless case is refused.
   272	    const served = fixtureEntries(FIXTURE)[0];
