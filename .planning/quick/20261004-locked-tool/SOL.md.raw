   716	// single source of truth escalation counts from.
   717	async function transition(
   718	  taskId: string,
   719	  from: string,
   720	  to: string,
   721	  actor: string,
   722	  payload: Record<string, unknown> = {},
   723	  resultJson?: unknown,
   724	): Promise<void> {
