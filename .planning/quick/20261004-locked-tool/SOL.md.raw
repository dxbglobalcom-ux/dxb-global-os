    98	/** The database handle `pinAll` takes — borrowed so this module needs no
    99	 *  second spelling of the Kysely/DB types (one source of truth: the gateway). */
   100	type PinDb = Parameters<typeof pinAll>[0];
   101	
   102	const byName = (a: string, b: string): number => (a < b ? -1 : a > b ? 1 : 0);
   103	
   104	const keyOf = (t: { server: string; tool: string }): string => `${t.server}.${t.tool}`;
   105	
   106	/** A fresh map with no prototype. A plain `{}` SWALLOWS an assignment to the
   107	 *  key `__proto__` — measured 2026-09-21: a manifest tool whose server was named
   108	 *  `__proto__` counted as nothing on both sides of the count gate, so the file
   109	 *  could carry a row it never declared and the gate called them equal. */
   110	const emptyCounts = (): Record<string, number> => Object.create(null) as Record<string, number>;
   111	
   112	/** Duplicate `(server, tool)` pairs, reported by their readable name.
   113	 *  The dedupe key is NOT the dotted spelling: `a.b` + `c` and `a` + `b.c` share
   114	 *  one dotted string, and a gate that compared those would accuse two perfectly
   115	 *  distinct tools of being each other (adversarial pass, 2026-09-21). */
   116	function duplicatePairs(items: Array<{ server: string; tool: string }>): string[] {
   117	  const seen = new Set<string>();
   118	  const twice = new Set<string>();
   119	  for (const item of items) {
   120	    const key = JSON.stringify([item.server, item.tool]);
   121	    if (seen.has(key)) twice.add(keyOf(item));
   122	    seen.add(key);
   123	  }
   124	  return [...twice].sort(byName);
   125	}
