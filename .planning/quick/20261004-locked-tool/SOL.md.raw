   207	  entry: Pick<ToolInventoryEntry, "server" | "tool" | "description" | "inputSchema">,
   208	): ToolPinsManifest {
   209	  if (entry.server === DXB_MCP_SERVER_NAME) {
   210	    throw new Error(`manifest must not carry ${DXB_MCP_SERVER_NAME} (${keyOf(entry)}) — its authority is the source`);
   211	  }
   212	  if (entry.inputSchema === undefined) throw new Error(`${keyOf(entry)} has no inputSchema, cannot be stored`);
   213	  const tool: ManifestTool = {
   214	    server: entry.server,
   215	    tool: entry.tool,
   216	    description: entry.description,
   217	    inputSchema: entry.inputSchema,
   218	    schema_hash: computeToolHash(entry),
   219	  };
   220	  const others = manifest.tools.filter((t) => keyOf(t) !== keyOf(entry));
   221	  const servers: Record<string, number> = emptyCounts();
   222	  for (const t of [...others, tool]) servers[t.server] = (servers[t.server] ?? 0) + 1;
   223	  return { about: manifest.about, servers, tools: [...others, tool] };
   224	}
