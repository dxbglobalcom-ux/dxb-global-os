    61	  if (typeof p.server !== "string" || typeof p.tool !== "string" || !text || typeof text.description !== "string") {
    62	    fail(`audit record ${auditId} carries no locked text`);
    63	  }
    64	  const entry = { server: p.server, tool: p.tool, description: text.description, inputSchema: text.inputSchema };
    65	  // The record must agree with itself: the text it carries is the text that was locked.
