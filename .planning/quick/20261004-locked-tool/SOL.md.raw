    98	  console.log(
    99	    `${replaced ? "Replaced" : "Added"} ${entry.server}/${entry.tool} in ${manifestPath}. Commit it; the lock lifts at the next tool check.`,
   100	  );
   101	} finally {
   102	  await closeDb();
   103	}
