   137	
   138	  const failEvents = await db
   139	    .selectFrom("task_events")
   140	    .select(["payload", "created_at"])
   141	    .where("task_id", "=", task.id)
   142	    .where("event", "=", "transition")
   143	    .where("to_status", "=", "failed")
   144	    .orderBy("id")
   145	    .execute();
   146	  const failures = failEvents.map((e, i) => {
   147	    const p = e.payload as { error?: string; reason?: string } | null;
   148	    return `${i + 1}. ${p?.error ?? p?.reason ?? "unknown failure"}`;
   149	  });
   150	  const report = [
   151	    `BLOCKED after ${n} failures — escalation ladder exhausted (hard stop).`,
   152	    `Task: ${task.id}`,
   153	    `Objective: ${task.objective}`,
   154	    "Failure history:",
   155	    ...failures,
   156	    "No further automatic retries will occur. CEO decision required.",
   157	  ].join("\n");
   158	
   159	  await db
   160	    .updateTable("tasks")
   161	    .set({ feedback: report, updated_at: sql`now()` })
   162	    .where("id", "=", task.id)
   163	    .execute();
   164	  await db
   165	    .insertInto("audit_log")
   166	    .values({
   167	      actor: ACTOR,
   168	      actor_type: "system",
   169	      action: "task.blocked",
   170	      task_id: task.id,
   171	      payload: JSON.stringify({ fail_count: n, failures }),
   172	    })
   173	    .execute();
   174	  await appendEvent(db, task.id, "blocked", "failed", "failed", {
   175	    ladder: "blocked",
   176	    fail_count: n,
   177	  });
   178	  // §10 "workflow adım dallanması / escalation": the terminal rung is a CEO
   179	  // escalation — the loudest decision the ladder can take.
   180	  await logDecision(
   181	    {
   182	      runId: null,
   183	      decidedBy: ACTOR,
   184	      decision: "escalation",
   185	      rationale: `hard stop after ${n} failures — ladder exhausted, blocked report written for the CEO`,
   186	      dataUsed: ["task_events", "tasks"],
   187	      alternatives: { rejected: "another requeue", reason: "fail_count past the LOCKED ladder (T-05-13)" },
   188	      confidence: null,
   189	      risk: "high",
   190	    },
   191	    { outcome: "blocked", taskId: task.id },
   192	  );
   193	  return { action: "blocked", failCount: n, alreadyBlocked: false };
   194	}
   195	
   196	/**
   197	 * Apply one LOCKED ladder step to a task. Idempotent and race-safe: only a
   198	 * task sitting in 'failed' (or a low-confidence 'review', which is converted
   199	 * first) moves; anything else is a no-op. Every action appends its event.
   200	 */
   201	export async function escalate(db: Kysely<DB>, taskId: string): Promise<EscalateResult> {
   202	  const task = await db
   203	    .selectFrom("tasks")
   204	    .select(["id", "status", "model_tier", "objective"])
   205	    .where("id", "=", taskId)
   206	    .executeTakeFirstOrThrow();
   207	
   208	  await convertLowConfidence(db, taskId, task.status);
   209	
   210	  const n = await failCount(db, taskId);
   211	  let step = ladderAction(n);
   212	  if (step.kind === "none") return { action: "none", failCount: n };
   213	  if (step.kind === "blocked") return blockTask(db, task, n);
   214	
   215	  // U15 D5 registered adaptation (2026-07-25, remediation-note block 6
   216	  // authority): a LOW-CONFIDENCE fail is never retried on the same tier —
   217	  // the same worker at the same tier reproduces the same confidence
   218	  // (measured 2026-07-17: 0.42 → retry-same-tier ×5 → blocked, 10 tasks in
   219	  // one day). Rung 1 escalates the tier for low-confidence fails only;
   220	  // plain execution failures keep the LOCKED retry-same-tier rung, and the
   221	  // fail-count arithmetic (T-05-13/14) is untouched.
   222	  if (step.kind === "requeue" && step.tier === "same") {
   223	    const lastFail = await db
   224	      .selectFrom("task_events")
   225	      .select("payload")
   226	      .where("task_id", "=", taskId)
   227	      .where("event", "=", "transition")
   228	      .where("to_status", "=", "failed")
   229	      .orderBy("id", "desc")
   230	      .executeTakeFirst();
   231	    const reason = (lastFail?.payload as { reason?: string } | null)?.reason;
   232	    if (reason === "low-confidence") {
   233	      step = { kind: "requeue", ladder: "low-confidence-bump", tier: "bump" };
   234	    }
   235	  }
   236	
   237	  const nextTier =
   238	    step.tier === "same" ? task.model_tier : step.tier === "bump" ? bumpTier(task.model_tier) : step.tier;
   239	
   240	  const updated = await db
   241	    .updateTable("tasks")
   242	    .set({
   243	      status: "queued",
   244	      model_tier: nextTier,
   245	      claimed_by: null,
   246	      claimed_at: null,
   247	      lease_expires_at: null,
   248	      updated_at: sql`now()`,
   249	    })
   250	    .where("id", "=", taskId)
   251	    .where("status", "=", "failed")
   252	    .returning("id")

