   111	};
   112	
   113	/** One alert per distinct change of one tool (the dedup key carries the kind and the new hash; a
   114	 *  duplicate is skipped). A lock's alert is informational and names the security engineer: the review
   115	 *  task is the work, tool-lock-watch.ts raises what must reach the CEO. */
   116	async function raisePinAlert(
   117	  trx: Transaction<DB>,
   118	  kind: "repinned" | "quarantined" | "unlocked",
   119	  entry: ToolInventoryEntry,
   120	  liveHash: string,
   121	  auditId: number,
   122	  verdict: DriftVerdict,
   123	  description: DriftDescription,
   124	  oldTextKept: boolean,
   125	  review?: { reviewerId: string | null; taskId: string },
   126	): Promise<void> {
   127	  const name = `${entry.server}/${entry.tool}`;
   128	  const sourceRef = JSON.stringify({ table: "audit_log", audit_id: auditId, server: entry.server, tool: entry.tool });
   129	  if (kind === "repinned" || kind === "unlocked") {
   130	    await trx
   131	      .insertInto("alerts")
   132	      .values({
   133	        level: "informational",
   134	        source: "gateway",
   135	        title:
   136	          kind === "repinned"
   137	            ? `Tool updated without a lock: ${name} changed to the text the repository vouches for`
   138	            : unlockAlertTitle(name),
   139	        affected_area: "tool pins",
   140	        probable_cause: `The new text equals ${AUTHORITY_TEXT[verdict.authority ?? ""] ?? "an approved text"}`,
   141	        // Truthful about what the record holds: a pin from before 2026-10-01 may have kept no text.
   142	        suggested_action: oldTextKept
   143	          ? `Nothing to do; the old and the new text are kept in audit record ${auditId}`
   144	          : `Nothing to do; the new text is kept in audit record ${auditId} (no earlier text was kept)`,
   145	        dedup_key: `pin:${kind}:${entry.server}:${entry.tool}:${liveHash.slice(0, 12)}`,
   146	        source_ref: sourceRef,
   147	      })
   148	      .onConflict((oc) => oc.doNothing())
   149	      .execute();
   150	    return;
   151	  }
   152	  const signals = description.signals.length ? description.signals.join(", ") : "none";
   153	  // The review task rides in source_ref, NOT in alerts.task_id: trg_alert_supersede_on_task_done resolves
   154	  // every open alert whose task_id finishes, and a finished review does not unlock the tool.
   155	  const lockRef = JSON.stringify({ ...JSON.parse(sourceRef), review_task_id: review?.taskId ?? null });
   156	  await trx
   157	    .insertInto("alerts")
   158	    .values({
   159	      level: "informational",
   160	      source: "gateway",
   161	      title: lockAlertTitle(name),
   162	      affected_area: "tool pins",
   163	      probable_cause: lockAlertCause(signals),
   164	      suggested_action: lockAlertAction(auditId),
   165	      responsible_employee: review?.reviewerId ?? null,
   166	      dedup_key: `pin:quarantined:${entry.server}:${entry.tool}:${liveHash.slice(0, 12)}`,
   167	      source_ref: lockRef,
   168	    })
   169	    // The same change locked again while its alert is open (only after a hand unlock): the alert names
   170	    // the newest record and review; it is not re-raised — the watch decides what reaches the CEO.
   171	    .onConflict((oc) =>
   172	      oc
   173	        .column("dedup_key")
   174	        .where("resolved_at", "is", null)
   175	        .where("dedup_key", "is not", null)
   176	        .doUpdateSet({
   177	          probable_cause: (eb) => eb.ref("excluded.probable_cause"),
   178	          suggested_action: (eb) => eb.ref("excluded.suggested_action"),
   179	          responsible_employee: (eb) => eb.ref("excluded.responsible_employee"),
   180	          source_ref: lockRef,
   181	        }),
   182	    )
   183	    .execute();
   184	}
   185	
   186	/** The review task for one lock, in the lock's own transaction (lock-review.ts): the security engineer's,
   187	 *  tool-less, queued, hanging off the holding's own project; then the `tool_review_opened` row that links
   188	 *  the lock to it (append-only — no audit row is ever updated). The seat or the project missing does not
   189	 *  stop the lock: the task is still opened (the gate decides), and the 72-hour rule covers a review that
   190	 *  never comes. */
   191	async function openLockReview(
   192	  trx: Transaction<DB>,
   193	  entry: ToolInventoryEntry,
   194	  oldText: ToolText | null,
   195	  description: DriftDescription,
   196	  lockAuditId: number,
   197	): Promise<{ reviewerId: string | null; taskId: string }> {
   198	  const reviewer = await trx
   199	    .selectFrom("agents")
   200	    .select("id")
   201	    .where("slug", "=", LOCK_REVIEWER_SLUG)
   202	    .where("employment_status", "=", "active")
   203	    .executeTakeFirst();
   204	  const project = (
   205	    await sql<{ id: string }>`SELECT id FROM projects WHERE slug = ${LOCK_REVIEW_PROJECT_SLUG}`.execute(trx)
   206	  ).rows[0];
   207	  const words = buildLockReviewTask(entry.server, entry.tool, oldText, toolText(entry), description, lockAuditId);
   208	  const task = await trx
   209	    .insertInto("tasks")
   210	    .values({
   211	      department: LOCK_REVIEW_DEPARTMENT,
   212	      agent_id: reviewer?.id ?? null,
   213	      project_id: project?.id ?? null,
   214	      objective: words.objective,
   215	      output_contract: words.output_contract,
   216	      label: words.label,
   217	      label_tr: words.label_tr,
   218	      model_tier: "L2",
   219	      approval_class: "none",
   220	      budget_max_tokens: 60000,
   221	      budget_max_cost_eur: 1,
   222	      priority: 8,
   223	      status: "queued",
   224	      tools_allowed: false,
   225	    })
   226	    .returning("id")
   227	    .executeTakeFirstOrThrow();
   228	  await trx
   229	    .insertInto("task_events")
   230	    .values({
   231	      task_id: task.id,
   232	      event: "created",
   233	      from_status: "inbox",
   234	      to_status: "queued",
   235	      actor: ACTOR,
   236	      payload: JSON.stringify({ lock_audit_id: lockAuditId, server: entry.server, tool: entry.tool }),
   237	    })
   238	    .execute();
   239	  await trx
   240	    .insertInto("audit_log")
   241	    .values({
   242	      actor: ACTOR,
   243	      actor_type: "system",
   244	      action: "tool_review_opened",
   245	      task_id: task.id,
   246	      payload: JSON.stringify({ lock_audit_id: lockAuditId, task_id: task.id, server: entry.server, tool: entry.tool }),
   247	    })
   248	    .execute();
   249	  return { reviewerId: reviewer?.id ?? null, taskId: task.id };
   250	}
   251	
   252	/** An unlock's housekeeping, in the unlock's own transaction: every open lock alert of this tool resolved
   253	 *  through the alert door (control_alerts_action — its audit row says who and why), and every review task
   254	 *  of this tool that has not started yet returned. A review already running finishes; its verdict is
   255	 *  recorded and raises nothing, because the watch acts only on locked pins. */
   256	async function closeLock(trx: Transaction<DB>, entry: ToolInventoryEntry, unlockAuditId: number): Promise<void> {
   257	  const open = await trx
   258	    .selectFrom("alerts")
   259	    .select("id")
   260	    .where("source", "=", "gateway")
   261	    .where("dedup_key", "like", `pin:quarantined:${entry.server}:${entry.tool}:%`)
   262	    .where("resolved_at", "is", null)
   263	    .execute();
   264	  for (const a of open) {
   265	    const payload = JSON.stringify({
   266	      op: "resolve",
   267	      alert_id: a.id,
   268	      note: `Unlocked by the repository's word (audit record ${unlockAuditId})`,
   269	      mitigation: `The repository's tool manifest carries the new text (audit record ${unlockAuditId})`,
   270	    });
   271	    await sql`SELECT control_alerts_action(${payload}::jsonb, ${`pin-unlock:${unlockAuditId}:${a.id}`})`.execute(trx);
   272	  }
   273	  const reviews = await trx
   274	    .selectFrom("audit_log as r")
   275	    .innerJoin("tasks as t", (j) => j.on(sql`t.id`, "=", sql`(r.payload->>'task_id')::uuid`))
   276	    .select(["t.id", "t.status"])
   277	    .where("r.action", "=", "tool_review_opened")
   278	    .where(sql<string>`r.payload->>'server'`, "=", entry.server)
   279	    .where(sql<string>`r.payload->>'tool'`, "=", entry.tool)
   280	    .where("t.status", "in", ["inbox", "queued"])
   281	    .execute();
   282	  for (const t of reviews) {
   283	    const moved = await trx
   284	      .updateTable("tasks")
   285	      .set({
   286	        status: "returned",
   287	        feedback: `No longer needed: the tool was unlocked by the repository's word (audit record ${unlockAuditId})`,
   288	        updated_at: sql<Date>`now()`,
   289	      })
   290	      .where("id", "=", t.id)
   291	      .where("status", "in", ["inbox", "queued"])
   292	      .executeTakeFirst();
   293	    if (Number(moved.numUpdatedRows) !== 1) continue;
   294	    await trx
   295	      .insertInto("task_events")
   296	      .values({
   297	        task_id: t.id,
   298	        event: "returned",
   299	        from_status: t.status,
   300	        to_status: "returned",
   301	        actor: ACTOR,
   302	        payload: JSON.stringify({ unlock_audit_id: unlockAuditId }),
   303	      })
   304	      .execute();
   305	  }
   306	}
   307	
   308	export interface PinAllResult {
   309	  pinned: Array<{ server: string; tool: string }>;
   310	  existing: number;
   311	}
   312	
   313	/** First-sight pinning: insert a hash row per unknown (server, tool); rows
   314	 *  that already exist are NEVER touched — a pin is immutable until human
   315	 *  re-approval, so a drifted tool cannot re-legitimize itself by re-pinning. */
   316	export async function pinAll(db: Kysely<DB>, inventory: ToolInventoryEntry[]): Promise<PinAllResult> {
   317	  const pinned: Array<{ server: string; tool: string }> = [];
   318	  let existing = 0;
   319	  for (const entry of inventory) {
   320	    const inserted = await db
   321	      .insertInto("tool_pins")
   322	      .values({
   323	        server: entry.server,
   324	        tool: entry.tool,
   325	        schema_hash: computeToolHash(entry),
   326	        pinned_text: JSON.stringify(toolText(entry)),
   327	      })
   328	      .onConflict((oc) => oc.columns(["server", "tool"]).doNothing())
   329	      .returning(["server", "tool"])
   330	      .executeTakeFirst();
   331	    if (inserted) pinned.push({ server: inserted.server, tool: inserted.tool });
   332	    else existing += 1;
   333	  }
   334	  return { pinned, existing };
   335	}
   336	
   337	export interface CheckPinsResult {
   338	  checked: number;
   339	  matched: number;
   340	  /** Freshly quarantined this run (audit row and high alert written per tool). */
   341	  quarantined: Array<{ server: string; tool: string; signals: string[] }>;
   342	  /** Drifted to a text the repository vouches for and re-approved this run (audit row and
   343	   *  informational alert per tool). */
   344	  repinned: Array<{ server: string; tool: string }>;
   345	  /** Pins whose approved text was stored this run (the live hash still equalled the approved hash). */
   346	  textStored: number;
   347	  /** Drifted but already quarantined and nobody vouches — short-circuited, no duplicate audit. */
   348	  alreadyQuarantined: number;
   349	  /** Locked pins whose live text the repository now vouches for, unlocked this run (audit row, the lock
   350	   *  alert resolved, the waiting review returned, an informational alert). */
   351	  unlocked: Array<{ server: string; tool: string }>;
   352	  /** Pinned in the table but absent from the live inventory (audited as
   353	   *  tool_missing — disappearance ≠ mutation, no quarantine flip). */
   354	  missing: Array<{ server: string; tool: string }>;
   355	  /** Live tools with no pin row yet — reported, not acted on; pinning new
   356	   *  tools is pinAll's (human-initiated) job, never the cron's. */
   357	  unpinned: Array<{ server: string; tool: string }>;
   358	}
   359	
   360	/** Daily drift check: recompute every live tool's hash against its pin.
   361	 *  Mismatch on a non-quarantined tool → drift review (judgeDrift): the repository vouches for the
   362	 *  new text → new hash + text, audit `tool_repinned_auto` and an informational alert; it does not →
   363	 *  quarantined=true, audit `tool_quarantined`, the security engineer's tool-less review task and an
   364	 *  informational alert — each in ONE transaction that first locks the pin row and acts only if it is
   365	 *  still the pin that was judged (two concurrent runs make one transition, never undo a lock).
   366	 *  A quarantined pin whose live text differs from its approved one AND the repository now vouches for
   367	 *  is unlocked (`tool_unquarantined_auto`, same transaction discipline); one that serves its old text
   368	 *  again, or a text nobody vouches for, stays locked.
   369	 *  `approved` defaults to the repository's manifest (loadApprovedCorpus).
   370	 *  R4.3 `serversInScope`: with external servers in the corpus, a server that
   371	 *  failed to SPAWN this run is unreachable, not tool-less — its pins are
   372	 *  excluded from the missing-sweep so an npx/uvx hiccup cannot spam
   373	 *  tool_missing audits. Omitted = every pinned server is in scope. */
   374	export async function checkPins(
   375	  db: Kysely<DB>,
   376	  inventory: ToolInventoryEntry[],
   377	  serversInScope?: Set<string>,
   378	  approved: ApprovedCorpus = loadApprovedCorpus(),
   379	): Promise<CheckPinsResult> {
   380	  const pins = await db.selectFrom("tool_pins").selectAll().execute();
   381	  const byKey = new Map(pins.map((p) => [`${p.server} ${p.tool}`, p]));
   382	  const liveKeys = new Set(inventory.map((e) => `${e.server} ${e.tool}`));
   383	
   384	  const result: CheckPinsResult = {
   385	    checked: 0,
   386	    matched: 0,
   387	    quarantined: [],
   388	    repinned: [],
   389	    textStored: 0,
   390	    alreadyQuarantined: 0,
   391	    unlocked: [],
   392	    missing: [],
   393	    unpinned: [],
   394	  };
   395	
   396	  for (const entry of inventory) {
   397	    const pin = byKey.get(`${entry.server} ${entry.tool}`);
   398	    if (!pin) {
   399	      result.unpinned.push({ server: entry.server, tool: entry.tool });
   400	      continue;
   401	    }
   402	    result.checked += 1;
   403	    const liveHash = computeToolHash(entry);
   404	    if (liveHash === pin.schema_hash) {
   405	      result.matched += 1;
   406	      // The live text hashes to the approved hash, so it IS the approved text: keep it, so a later
   407	      // drift can be shown as a change (the self-backfill of 2026-10-01). Written when no verified
   408	      // text is kept yet (none, or a stale one left by a hand re-pin), and only while the row's hash
   409	      // still equals the live hash at write time.
   410	      const needsText = storedText(pin.pinned_text, pin.schema_hash) === null;
   411	      const updated = await db
   412	        .updateTable("tool_pins")
   413	        .set(
   414	          needsText
   415	            ? { last_checked: sql<Date>`now()`, pinned_text: JSON.stringify(toolText(entry)) }
   416	            : { last_checked: sql<Date>`now()` },
   417	        )
   418	        .where("id", "=", pin.id)
   419	        .where("schema_hash", "=", liveHash)
   420	        .executeTakeFirst();
   421	      if (needsText && Number(updated.numUpdatedRows) === 1) result.textStored += 1;
   422	      continue;
   423	    }
   424	    // The verdict rests on the repository's word alone; the description is for the person who reads
   425	    // the audit row.
   426	    const verdict = judgeDrift(entry.server, entry.tool, liveHash, approved);
   427	    if (pin.quarantined) {
   428	      if (verdict.verdict !== "clean") {
   429	        // Locked, and nobody vouches for what it serves: touch last_checked only — no duplicate audit.
   430	        result.alreadyQuarantined += 1;
   431	        await db
   432	          .updateTable("tool_pins")
   433	          .set({ last_checked: sql<Date>`now()` })
   434	          .where("id", "=", pin.id)
   435	          .execute();
   436	        continue;
   437	      }
   438	      // Locked, and the repository now vouches for exactly the text it serves (the construction added it
   439	      // to the manifest after a person read it, or it is our own source): the unlock, in ONE transaction
   440	      // that acts only if the pin is still the locked pin that was judged.
   441	      const unlocked = await db.transaction().execute(async (trx) => {
   442	        const current = await trx
   443	          .selectFrom("tool_pins")
   444	          .select(["schema_hash", "quarantined", "pinned_text"])
   445	          .where("id", "=", pin.id)
   446	          .forUpdate()
   447	          .executeTakeFirst();
   448	        if (!current || !current.quarantined || current.schema_hash !== pin.schema_hash) return false;
   449	        const oldText = storedText(current.pinned_text, current.schema_hash);
   450	        await trx
   451	          .updateTable("tool_pins")
   452	          .set({
   453	            quarantined: false,
   454	            schema_hash: liveHash,
   455	            pinned_text: JSON.stringify(toolText(entry)),
   456	            pinned_at: sql<Date>`now()`,
   457	            last_checked: sql<Date>`now()`,
   458	          })
   459	          .where("id", "=", pin.id)
   460	          .execute();
   461	        const audit = await trx
   462	          .insertInto("audit_log")
   463	          .values({
   464	            actor: ACTOR,
   465	            actor_type: "system",
   466	            action: "tool_unquarantined_auto",
   467	            task_id: null,
   468	            payload: JSON.stringify({
   469	              server: entry.server,
   470	              tool: entry.tool,
   471	              old_hash: pin.schema_hash,
   472	              new_hash: liveHash,
   473	              authority: verdict.authority,
   474	              old_text: oldText,
   475	              new_text: toolText(entry),
   476	            }),
   477	          })
   478	          .returning("id")
   479	          .executeTakeFirstOrThrow();
   480	        await closeLock(trx, entry, Number(audit.id));
   481	        await raisePinAlert(trx, "unlocked", entry, liveHash, Number(audit.id), verdict, { signals: [], summary: [] }, oldText !== null);
   482	        return true;
   483	      });
   484	      if (unlocked) result.unlocked.push({ server: entry.server, tool: entry.tool });
   485	      continue;
   486	    }
   487	    // Fresh drift.
   488	    // The earlier text, for the record only: the kept one when it hashes to the pin, else the
   489	    // manifest's own text when THAT hashes to the pin (a pin from before 2026-10-01 kept none).
   490	    const key = `${entry.server} ${entry.tool}`;
   491	    const oldText =
   492	      storedText(pin.pinned_text, pin.schema_hash) ??
   493	      (approved.hashes.get(key) === pin.schema_hash ? (approved.texts?.get(key) ?? null) : null);
   494	    const description = describeDrift(oldText, entry);
   495	    const applied = await db.transaction().execute(async (trx) => {
   496	      // Lock the row and act only if it is still the pin that was judged: same approved hash, not
   497	      // quarantined. A concurrent run that got here first has already made the transition.
   498	      const current = await trx
   499	        .selectFrom("tool_pins")
   500	        .select(["schema_hash", "quarantined"])
   501	        .where("id", "=", pin.id)
   502	        .forUpdate()
   503	        .executeTakeFirst();
   504	      if (!current || current.quarantined || current.schema_hash !== pin.schema_hash) return false;
   505	      const clean = verdict.verdict === "clean";
   506	      await trx
   507	        .updateTable("tool_pins")
   508	        .set(
   509	          clean
   510	            ? {
   511	                schema_hash: liveHash,
   512	                pinned_text: JSON.stringify(toolText(entry)),
   513	                pinned_at: sql<Date>`now()`,
   514	                last_checked: sql<Date>`now()`,
   515	              }
   516	            : { quarantined: true, last_checked: sql<Date>`now()` },
   517	        )
   518	        .where("id", "=", pin.id)
   519	        .execute();
   520	      // The audit row keeps both texts, whole: after a re-approval the old one is gone from the pin,
   521	      // and after a lock the server may quietly restore its text — the record must still show it.
   522	      const audit = await trx
   523	        .insertInto("audit_log")
   524	        .values({
   525	          actor: ACTOR,
   526	          actor_type: "system",
   527	          action: clean ? "tool_repinned_auto" : "tool_quarantined",
   528	          task_id: null,
   529	          payload: JSON.stringify({
   530	            server: entry.server,
   531	            tool: entry.tool,
   532	            old_hash: pin.schema_hash,
   533	            new_hash: liveHash,
   534	            authority: verdict.authority,
   535	            signals: description.signals,
   536	            summary: description.summary,
   537	            old_text: oldText,
   538	            new_text: toolText(entry),
   539	          }),
   540	        })
   541	        .returning("id")
   542	        .executeTakeFirstOrThrow();
   543	      // A lock opens its review in the same transaction: the lock, its record, the seat's task and the
   544	      // alert exist together or not at all.
   545	      const review = clean ? undefined : await openLockReview(trx, entry, oldText, description, Number(audit.id));
   546	      await raisePinAlert(
   547	        trx,
   548	        clean ? "repinned" : "quarantined",
   549	        entry,
   550	        liveHash,
   551	        Number(audit.id),
   552	        verdict,
   553	        description,
   554	        oldText !== null,
   555	        review,
   556	      );
   557	      return true;
   558	    });
   559	    if (!applied) continue;
   560	    if (verdict.verdict === "clean") result.repinned.push({ server: entry.server, tool: entry.tool });
   561	    else result.quarantined.push({ server: entry.server, tool: entry.tool, signals: description.signals });
   562	  }
   563	
   564	  for (const pin of pins) {
   565	    if (liveKeys.has(`${pin.server} ${pin.tool}`)) continue;
   566	    // R4.3's scope, WHICH THIS LOOP NEVER APPLIED. The parameter has been
   567	    // accepted and documented since R4.3 — "its pins are excluded from the
   568	    // missing-sweep" — and the code above reads it nowhere, so every call
   569	    // stamped every pin of every server it had not even tried to reach.
   570	    // Measured 2026-09-21 on the construction engine: 38,811 `tool_missing`
   571	    // rows, 13,032 of them for `playwright` alone, and one battery run added
   572	    // 228 — exactly the 76 pins on that engine times the three calls
   573	    // `tests/phase7/pin-quarantine` makes with a scope of ONE fixture server.
   574	    // A server that was not reached is unreachable, not tool-less: saying its
   575	    // tools disappeared is a false statement written into the CEO's ledger.
   576	    if (serversInScope && !serversInScope.has(pin.server)) continue;
   577	    result.missing.push({ server: pin.server, tool: pin.tool });
   578	    await db
   579	      .insertInto("audit_log")
   580	      .values({
   581	        actor: ACTOR,
   582	        actor_type: "system",
   583	        action: "tool_missing",
   584	        task_id: null,
   585	        payload: JSON.stringify({ server: pin.server, tool: pin.tool, pinned_hash: pin.schema_hash }),
   586	      })
   587	      .execute();
   588	  }
   589	
   590	  return result;
   591	}

