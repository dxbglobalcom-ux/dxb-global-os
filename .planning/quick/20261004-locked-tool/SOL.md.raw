    72	/** One pinned tool as the manifest stores it: the served shape plus its hash. */
    73	export interface ManifestTool {
    74	  server: string;
    75	  tool: string;
    76	  description: string;
    77	  inputSchema: unknown;
    78	  schema_hash: string;
    79	}
    80	
    81	export interface ToolPinsManifest {
    82	  /** One sentence: what this file is, who refreshes it, how. */
    83	  about: string;
    84	  /** server → tool count, as the file states it about itself. */
    85	  servers: Record<string, number>;
    86	  tools: ManifestTool[];
    87	}
    88	
    89	export interface ManifestDiff {
    90	  /** In the manifest, absent from the live servers — `server.tool`. */
