    83	export function approvedCorpus(
    84	  entries: ManifestEntry[],
    85	  ownServers: ReadonlySet<string>,
    86	  hash: (t: ToolText) => string,
    87	): ApprovedCorpus {
    88	  const hashes = new Map<string, string>();
    89	  const texts = new Map<string, ToolText>();
    90	  for (const e of entries) {
