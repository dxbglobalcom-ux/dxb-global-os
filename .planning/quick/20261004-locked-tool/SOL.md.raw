   436	        // empty cost book is NOT the defect (the holding is still being built and
   437	        // the earning machine is deliberately off) — the defect is that nothing
   438	        // would fill it on the day it matters. Still no EUR here, so the
   439	        // single-source rule above is untouched.
   440	        await recordSubscriptionSpend({
   441	          taskId: task.id,
   442	          agentId: task.agent_id ?? null,
   443	          department: task.department,
   444	          model: rule.model,
   445	          tokensIn,
   446	          tokensOut,
   447	        });
