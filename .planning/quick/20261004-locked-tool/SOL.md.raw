    54	/** The path with every link resolved — through parts that do not exist yet and through a dangling link. */
    55	function realPath(p: string, depth = 0): string {
    56	  try {
    57	    return realpathSync(p);
    58	  } catch {
    59	    // not there (yet), or a link whose target is not there
    60	  }
    61	  if (depth > 40) return p;
    62	  try {
    63	    return realPath(resolve(dirname(p), readlinkSync(p)), depth + 1);
    64	  } catch {
    65	    // not a link
    66	  }
    67	  const parent = dirname(p);
    68	  return parent === p ? p : join(realPath(parent, depth + 1), basename(p));
    69	}
