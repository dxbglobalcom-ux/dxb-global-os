    70	      SELECT payload FROM audit_log
    71	       WHERE action = 'tool_drift_verdict' AND (payload->>'lock_audit_id')::bigint = ${Number(auditId)}
    72	       ORDER BY id DESC LIMIT 1
    73	    `.execute(db)
    74	  ).rows[0]?.payload;
    75	
    76	  console.log(`Locked tool: ${entry.server}/${entry.tool} (audit record ${auditId})`);
    77	  console.log(`Signals (they decide nothing): ${Array.isArray(p.signals) && p.signals.length ? p.signals.join(", ") : "none"}`);
    78	  for (const line of Array.isArray(p.summary) ? p.summary : []) console.log(`  · ${String(line)}`);
    79	  console.log(
    80	    verdict
    81	      ? `Security engineer's verdict: ${String(verdict.verdict)}${Array.isArray(verdict.reasons) && verdict.reasons.length ? ` — ${verdict.reasons.join(" | ")}` : ""}`
    82	      : "Security engineer's verdict: none yet",
    83	  );
    84	  console.log("── the new text, whole ──");
    85	  console.log(JSON.stringify({ description: entry.description, inputSchema: entry.inputSchema }, null, 2));
    86	
    87	  if (!yes) {
    88	    console.log(`Nothing written. Read the text above; to vouch for it: pnpm construction:pins:add ${auditId} --yes`);
    89	    process.exit(0);
    90	  }
    91	
    92	  const before = readManifest(manifestPath);
    93	  verifyManifest(before); // a file that disagrees with itself is never extended
