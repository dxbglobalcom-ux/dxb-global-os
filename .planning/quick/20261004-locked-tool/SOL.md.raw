    60	  // B45 (2026-09-16): every lane that is resting right now, and the handle that ends
    61	  // its rest early. A resting lane used to hear stop() only when its rest ran out, so
    62	  // shutting the company's hands down cost one full rest per lane set — measured
    63	  // 6068–6082 ms across six runs with nothing whatever to do, paid at every
    64	  // `systemctl --user restart dxb-scheduler.service`. The rest is unchanged in every
    65	  // other respect: it is still deps.sleep, still DXB_LANE_REST_SECONDS, and a lane
    66	  // that is WORKING is still never cut short.
    67	  private readonly resting = new Set<() => void>();
    68	
    69	  constructor(
    70	    private readonly deps: TaskLaneDeps,
    71	    private readonly restMs: number,
    72	    private readonly laneWorkerId: (index: number) => string | undefined,
    73	  ) {}
    74	
    75	  /** Called every tick with the hand count the company decided on. Never blocks. */
    76	  reconcile(desired: number): ReconcileResult {
    77	    if (this.stopping) return { desired: 0, started: 0, running: this.loops.size };
    78	    this.desired = Math.max(0, Math.floor(desired));
    79	    let started = 0;
    80	    for (let i = 0; i < this.desired; i++) {
    81	      if (!this.loops.has(i)) {
    82	        this.loops.set(i, this.runLane(i));
    83	        started += 1;
    84	      }
    85	    }
    86	    return { desired: this.desired, started, running: this.loops.size };
    87	  }
    88	
    89	  get running(): number {
    90	    return this.loops.size;
    91	  }
    92	
    93	  /** Stop taking new work; resolves when every lane has finished its current drain. */
    94	  async stop(): Promise<void> {
    95	    this.stopping = true;
    96	    this.desired = 0;
    97	    // B45: a lane that is resting hears this at once instead of sleeping it out. A lane
    98	    // that is mid-drain is untouched — stop() still waits for the work it is doing.
    99	    for (const wake of this.resting) wake();
   100	    this.resting.clear();
   101	    await Promise.allSettled([...this.loops.values()]);
   102	  }
   103	
   104	  /**
   105	   * B45: one idle rest, ended by whichever comes first — the rest itself, or stop().
   106	   * The lane still rests through deps.sleep (no busy loop, no spin); it simply no
   107	   * longer waits a rest out after the order to stand down has been given.
   108	   */
   109	  private async rest(): Promise<void> {
   110	    if (this.stopping) return;
   111	    let wake!: () => void;
   112	    const woken = new Promise<void>((resolve) => {
   113	      wake = resolve;
   114	    });
   115	    this.resting.add(wake);
   116	    try {
   117	      await Promise.race([this.deps.sleep(this.restMs), woken]);
   118	    } finally {
   119	      this.resting.delete(wake);
   120	    }
   121	  }
   122	
   123	  private async runLane(index: number): Promise<void> {
   124	    const workerId = this.laneWorkerId(index);
   125	    try {
   126	      while (!this.stopping && index < this.desired) {
   127	        let outcome: DrainOutcome | null = null;
   128	        try {
   129	          outcome = await this.deps.drain(workerId);
   130	        } catch (err) {
   131	          // One lane's infrastructure fault must not take its siblings down, and
   132	          // must not spin: the lane rests a tick and tries again.
   133	          this.deps.log?.(`[scheduler] lane ${index + 1} failed: ${err instanceof Error ? err.message : String(err)}`);
   134	        }
   135	        const didWork = outcome !== null && outcome.executed + outcome.reviewed + outcome.escalated > 0;
   136	        if (!didWork && !this.stopping && index < this.desired) await this.rest();
   137	      }
   138	    } finally {
   139	      this.loops.delete(index);
   140	    }
   141	  }
   142	}
