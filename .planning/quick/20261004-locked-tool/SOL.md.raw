   727	    .updateTable("tasks")
   728	    .set({
   729	      status: to,
   730	      updated_at: sql`now()`,
   731	      ...(resultJson !== undefined ? { result: JSON.stringify(resultJson) } : {}),
   732	    })
   733	    .where("id", "=", taskId)
   734	    .where("status", "=", from)
   735	    .returning("id")
   736	    .executeTakeFirst();
   737	  if (!updated) {
   738	    throw new Error(`worker-shim: transition ${from}→${to} lost a race on task ${taskId}`);
   739	  }
   740	  await db
   741	    .insertInto("task_events")
   742	    .values({
   743	      task_id: taskId,
   744	      event: "transition",
   745	      from_status: from,
   746	      to_status: to,
   747	      actor,
   748	      payload: JSON.stringify(payload),
   749	    })
   750	    .execute();
   751	}
   752	
   753	export async function runWorkerOnce(args: RunWorkerArgs): Promise<RunWorkerResult> {
   754	  const { workerId, departments, execute = defaultExecutor, leaseSeconds = 900 } = args;
   755	  const db = getDb();
   756	
   757	  const claimedRows = await sql<ClaimedTask>`
   758	    SELECT * FROM claim_next_task(${workerId}, ${departments}, ${leaseSeconds})
   759	  `.execute(db);
   760	  const task = claimedRows.rows[0];
   761	  if (!task) return { claimed: false };
   762	
   763	  // claim_next_task flips the row; the event trail must record it too.
   764	  await db
   765	    .insertInto("task_events")
   766	    .values({
   767	      task_id: task.id,
   768	      event: "claimed",
   769	      from_status: "queued",
   770	      to_status: "claimed",
   771	      actor: workerId,
   772	      payload: JSON.stringify({ lease_seconds: leaseSeconds }),
   773	    })
   774	    .execute();
   775	
   776	  await transition(task.id, "claimed", "running", workerId);
   777	
   778	  // R2.1 — staff the task BEFORE the gates (spec §3: employee seç → preTask).
   779	  // B39: a department at full stretch hands the task back rather than stacking
   780	  // a second job on somebody already working. Reported as NOT claimed, because
   781	  // that is what happened — no run was born and nothing was consumed.
   782	  if (!(await assignEmployee(task, workerId))) return { claimed: false };
   783	
   784	  // ── E10.2 hook binding (FABLE_5_HOOK §3) ──────────────────────────────────
   785	  // Flag ON: preTask BEFORE the run is born (§6: a block rejection = the run
   786	  // never exists, the task fails as policy), hook_version stamped on the
