   177	/** The manifest's file bytes — deterministic for a given corpus. */
   178	export function serializeManifest(manifest: ToolPinsManifest): string {
   179	  const servers: Record<string, number> = emptyCounts();
   180	  for (const server of Object.keys(manifest.servers).sort(byName)) {
   181	    servers[server] = manifest.servers[server];
   182	  }
   183	  const ordered = {
   184	    about: manifest.about,
   185	    servers,
   186	    tools: manifest.tools
   187	      .slice()
   188	      .sort((a, b) => byName(a.server, b.server) || byName(a.tool, b.tool))
   189	      .map((t) => ({
   190	        server: t.server,
   191	        tool: t.tool,
   192	        description: t.description,
   193	        inputSchema: sortKeysDeep(t.inputSchema),
   194	        schema_hash: t.schema_hash,
   195	      })),
   196	  };
   197	  return `${JSON.stringify(ordered, null, 2)}\n`;
   198	}
