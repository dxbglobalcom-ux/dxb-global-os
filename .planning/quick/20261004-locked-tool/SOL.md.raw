   127	/** Object keys sorted recursively; arrays keep their order (order is meaningful
   128	 *  in JSON Schema — the same rule `canonicalJson` follows when hashing). */
   129	function sortKeysDeep(value: unknown): unknown {
   130	  if (Array.isArray(value)) return value.map(sortKeysDeep);
