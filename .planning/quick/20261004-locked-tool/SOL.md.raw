   342	  /** Drifted to a text the repository vouches for and re-approved this run (audit row and
   343	   *  informational alert per tool). */
   344	  repinned: Array<{ server: string; tool: string }>;
   345	  /** Pins whose approved text was stored this run (the live hash still equalled the approved hash). */
   346	  textStored: number;
   347	  /** Drifted but already quarantined and nobody vouches — short-circuited, no duplicate audit. */
   348	  alreadyQuarantined: number;
   349	  /** Locked pins whose live text the repository now vouches for, unlocked this run (audit row, the lock
