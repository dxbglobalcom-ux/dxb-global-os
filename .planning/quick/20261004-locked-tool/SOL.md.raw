    58	/** One watch pass. `servers` narrows it (a test watches only its own fixture server). */
    59	export async function watchToolLocks(
    60	  db: Kysely<DB>,
    61	  opts: { servers?: string[]; now?: Date } = {},
    62	): Promise<ToolLockWatchResult> {
    63	  const now = opts.now ?? new Date();
    64	  const out: ToolLockWatchResult = { locked: 0, verdicts: [], escalated: [] };
    65	  // Every locked pin with the newest lock record of that tool.
    66	  const locks = await sql<LockRow>`
    67	    SELECT p.server, p.tool, a.id::text AS lock_audit_id, a.created_at AS lock_at,
    68	           a.payload->>'new_hash' AS new_hash, a.payload->'signals' AS signals
    69	      FROM tool_pins p
    70	      JOIN LATERAL (
    71	        SELECT id, created_at, payload FROM audit_log
    72	         WHERE action = 'tool_quarantined'
    73	           AND payload->>'server' = p.server AND payload->>'tool' = p.tool
    74	         ORDER BY id DESC LIMIT 1
    75	      ) a ON true
    76	     WHERE p.quarantined
    77	       AND (${opts.servers ?? null}::text[] IS NULL OR p.server = ANY(${opts.servers ?? null}::text[]))
    78	     ORDER BY p.server, p.tool
    79	  `.execute(db);
    80	  out.locked = locks.rows.length;
    81	
    82	  for (const lock of locks.rows) {
    83	    const lockId = Number(lock.lock_audit_id);
    84	    const review = await sql<{ task_id: string; status: string; result: unknown }>`
    85	      SELECT t.id AS task_id, t.status, t.result
    86	        FROM audit_log r JOIN tasks t ON t.id = (r.payload->>'task_id')::uuid
    87	       WHERE r.action = 'tool_review_opened' AND (r.payload->>'lock_audit_id')::bigint = ${lockId}
    88	       ORDER BY r.id DESC LIMIT 1
    89	    `.execute(db);
    90	    const task = review.rows[0];
    91	
    92	    if (task?.status === "done") {
    93	      const already = await sql<{ verdict: string }>`
    94	        SELECT payload->>'verdict' AS verdict FROM audit_log
    95	         WHERE action = 'tool_drift_verdict' AND (payload->>'lock_audit_id')::bigint = ${lockId}
    96	         LIMIT 1
    97	      `.execute(db);
    98	      let verdict = already.rows[0]?.verdict;
    99	      if (verdict === undefined) {
   100	        const text = (task.result as { text?: unknown } | null)?.text;
   101	        const parsed = parseLockVerdict(text);
   102	        verdict = parsed.verdict;
   103	        await db
   104	          .insertInto("audit_log")
   105	          .values({
   106	            actor: ACTOR,
   107	            actor_type: "system",
   108	            action: "tool_drift_verdict",
   109	            task_id: task.task_id,
   110	            payload: JSON.stringify({
   111	              lock_audit_id: lockId,
   112	              task_id: task.task_id,
   113	              server: lock.server,
   114	              tool: lock.tool,
   115	              verdict: parsed.verdict,
   116	              reasons: parsed.reasons,
   117	            }),
   118	          })
   119	          .execute();
   120	        out.verdicts.push({ server: lock.server, tool: lock.tool, verdict });
   121	      }
   122	      if (verdict === "malicious") await escalate(db, lock, "malicious", out);
   123	      else if (verdict === "unreadable") await escalate(db, lock, "review-failed", out);
   124	    } else if (task?.status === "failed" || task?.status === "returned") {
   125	      await escalate(db, lock, "review-failed", out);
   126	    }
   127	
   128	    if (now.getTime() - new Date(lock.lock_at).getTime() > LOCK_ESCALATION_HOURS * 3600_000) {
   129	      await escalate(db, lock, "lock-72h", out);
   130	    }
   131	  }
   132	  return out;
   133	}
   134	
   135	/** Raise one lock to the CEO for one reason, once: the escalation mark and the alert in one transaction,
   136	 *  the mark checked under an advisory lock on (lock, reason) so two concurrent passes raise it once. */
   137	async function escalate(db: Kysely<DB>, lock: LockRow, reason: EscalationReason, out: ToolLockWatchResult): Promise<void> {
   138	  const lockId = Number(lock.lock_audit_id);
   139	  const raised = await db.transaction().execute(async (trx) => {
   140	    await sql`SELECT pg_advisory_xact_lock(hashtext(${`tool-lock-escalation:${lockId}:${reason}`}))`.execute(trx);
   141	    const marked = await sql<{ id: string }>`
   142	      SELECT id FROM audit_log
   143	       WHERE action = 'tool_lock_escalated'
   144	         AND (payload->>'lock_audit_id')::bigint = ${lockId} AND payload->>'reason' = ${reason}
   145	       LIMIT 1
   146	    `.execute(trx);
   147	    if (marked.rows.length > 0) return false;
   148	    await trx
   149	      .insertInto("audit_log")
   150	      .values({
   151	        actor: ACTOR,
   152	        actor_type: "system",
   153	        action: "tool_lock_escalated",
   154	        task_id: null,
   155	        payload: JSON.stringify({ lock_audit_id: lockId, reason, server: lock.server, tool: lock.tool }),
   156	      })
   157	      .execute();
   158	    const name = `${lock.server}/${lock.tool}`;
   159	    const signals = Array.isArray(lock.signals) && lock.signals.length ? (lock.signals as string[]).join(", ") : "none";
   160	    const action = escalationAction(reason, lockId);
   161	    const sourceRef = JSON.stringify({ table: "audit_log", audit_id: lockId, server: lock.server, tool: lock.tool, escalation: reason });
   162	    await trx
   163	      .insertInto("alerts")
   164	      .values({
   165	        level: "high",
   166	        source: "gateway",
   167	        title: lockAlertTitle(name),
   168	        affected_area: "tool pins",
   169	        probable_cause: lockAlertCause(signals),
   170	        suggested_action: action,
   171	        dedup_key: `pin:quarantined:${lock.server}:${lock.tool}:${String(lock.new_hash).slice(0, 12)}`,
   172	        source_ref: sourceRef,
   173	        escalated_at: sql<Date>`now()`,
   174	        escalated_from: "informational",
   175	      })
   176	      .onConflict((oc) =>
   177	        oc
   178	          .column("dedup_key")
   179	          .where("resolved_at", "is", null)
   180	          .where("dedup_key", "is not", null)
   181	          .doUpdateSet({
   182	            level: "high",
   183	            escalated_from: sql<string>`CASE WHEN alerts.level = 'high' THEN alerts.escalated_from ELSE alerts.level END`,
   184	            escalated_at: sql<Date>`now()`,
   185	            acknowledged_at: null,
   186	            muted_until: null,
   187	            suggested_action: action,
   188	          }),
   189	      )
   190	      .execute();
   191	    return true;
   192	  });
   193	  if (raised) out.escalated.push({ server: lock.server, tool: lock.tool, reason });
   194	}

