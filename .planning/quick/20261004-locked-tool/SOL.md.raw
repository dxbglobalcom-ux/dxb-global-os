   209	export function isolationReceipt(lane: string, log: (line: string) => void = console.log): (msg: unknown) => void {
   210	  let session = "?";
   211	  let loaded = "tools=? mcp=? plugins=? skills=? agents=?";
   212	  let hooks = 0;
   213	  return (msg) => {
   214	    try {
   215	      if (!msg || typeof msg !== "object") return;
   216	      const m = msg as StreamMessage;
   217	      if (session === "?" && typeof m.session_id === "string" && m.session_id) session = m.session_id;
   218	      if (m.type === "system" && m.subtype === "init") {
   219	        loaded =
   220	          `tools=${count(m.tools)} mcp=${count(m.mcp_servers)} plugins=${count(m.plugins)}` +
   221	          ` skills=${count(m.skills)} agents=${count(m.agents)}`;
   222	      } else if (m.type === "system" && m.subtype === "hook_started") {
   223	        hooks += 1;
   224	      } else if (m.type === "result") {
