    74	/** `p` is `root`, lies inside it, or holds it — both already canonical. */
    75	const overlaps = (p: string, root: string): boolean =>
    76	  p === root || p.startsWith(`${root}${sep}`) || root.startsWith(p === sep ? sep : `${p}${sep}`);
    77	
    78	/** The parts of a Claude home the CLI uses; each must resolve inside the home. */
    79	const HOME_PARTS = ["work", "cache", ".claude.json", ".credentials.json"] as const;
    80	
    81	/**
    82	 * The company's own Claude home (CLAUDE_CONFIG_DIR, and HOME for the call) — by default
    83	 * `~/.local/share/dxb/company-claude`; `DXB_COMPANY_CLAUDE_HOME` moves it. Returned canonical (every
    84	 * link resolved). Refused, so the lane fails closed instead of running from the construction's login,
    85	 * settings and peer registry (as companyCodexHome() does for the gate's Codex): an empty or relative
    86	 * value; a home that is, lies inside or holds the construction's `~/.claude` (the passwd home's, never
    87	 * $HOME) or the repository; a home whose work/, cache/, .claude.json or .credentials.json leads
    88	 * outside it through a link.
    89	 */
    90	export function companyClaudeHome(env: NodeJS.ProcessEnv = process.env): string {
    91	  const user = userInfo().homedir;
    92	  const home = env.DXB_COMPANY_CLAUDE_HOME ?? join(user, ".local", "share", "dxb", "company-claude");
    93	  if (!home || !isAbsolute(home)) {
    94	    throw new Error(`the company Claude home "${home}" is not an absolute path — a relative one resolves elsewhere in the child`);
    95	  }
    96	  const ours = realPath(home);
    97	  const theirs = realPath(join(user, ".claude"));
    98	  if (overlaps(ours, theirs)) {
    99	    throw new Error(`the company Claude home ${home} is the construction's Claude home (${theirs}), lies inside it or holds it — no company call runs from there`);
   100	  }
   101	  const repository = realPath(REPOSITORY);
   102	  if (overlaps(ours, repository)) {
   103	    throw new Error(`the company Claude home ${home} is the repository (${repository}), lies inside it or holds it — no company call runs from there`);
   104	  }
   105	  for (const part of HOME_PARTS) {
   106	    const at = realPath(join(ours, part));
   107	    if (!at.startsWith(`${ours}${sep}`)) {
   108	      throw new Error(`the company Claude home ${home}: its ${part} leads outside it (${at}) — no company call runs from there`);
   109	    }
   110	  }
