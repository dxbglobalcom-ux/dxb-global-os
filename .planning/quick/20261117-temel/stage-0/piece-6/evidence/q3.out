== Q3.1 os.count_parts: prosrc alone (what it lacks: the header) vs pg_get_functiondef (search_path '')
  (SET )
  ' select count(*) from os.parts where qty >= min_qty ' | CREATE OR REPLACE FUNCTION os.count_parts(min_qty integer)
 RETURNS bigint
 LANGUAGE sql
 STABLE STRICT SECURITY DEFINER
 SET work_mem TO '8MB'
 SET search_path TO ''
AS $function$ select count(*) from os.parts where qty >= min_qty $function$

