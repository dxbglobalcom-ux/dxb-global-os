== Q1.7 reference text: search_path '' + the other settings at their session values
  (SET )
  722c9bc9d4f4f6039507a5b1ad8f17b1 | ts='2020-01-02 00:04:05+00'::timestamp with time zone ; d='2020-01-02'::date ; iv='1 day 02:03:04'::interval ; b='\x41ff'::bytea ; f8=((0.1)::double precision + (0.0000001)::double precision) ; f4=(0.1)::real ; m=12.34 ; s='a\b'::text ; nm=(1.0 / (3)::numeric) ; arr='{1,NULL,3}'::integer[]
x timestamp with time zone DEFAULT '2020-01-02 00:04:05+00'::timestamp with time zone, y double precision DEFAULT 0.1, z interval DEFAULT '01:30:00'::interval, w text DEFAULT 'a\b'::text
 SELECT ts,
    (f8 * (0.1)::double precision) AS g,
    (iv + '01:00:00'::interval) AS h
   FROM os.q1p
  WHERE ((ts > '2020-01-01 00:00:00+00'::timestamp with time zone) AND (s <> 'x\y'::text));
CHECK (((f8 < ('10000000000'::numeric)::double precision) AND (ts > '2000-01-01 00:00:00+00'::timestamp with time zone)))
((ts > '2020-01-01 00:00:00+00'::timestamp with time zone) AND (f8 > (0.3)::double precision))
CREATE TRIGGER q1t BEFORE INSERT ON os.q1p FOR EACH ROW WHEN ((new.f8 > (0.2)::double precision)) EXECUTE FUNCTION os.q1trg()
CREATE INDEX q1p_i ON os.q1p USING btree (lower(s)) WHERE (f8 > (0.5)::double precision)
CREATE OR REPLACE FUNCTION os.q1f(x timestamp with time zone DEFAULT '2020-01-02 00:04:05+00'::timestamp with time zone, y double precision DEFAULT 0.1, z interval DEFAULT '01:30:00'::interval, w text DEFAULT 'a\b'::text)
 RETURNS integer
 LANGUAGE sql
AS $function$ select 1 $function$

