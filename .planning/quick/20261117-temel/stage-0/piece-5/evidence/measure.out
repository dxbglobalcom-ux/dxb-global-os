== M6 two side facts
-- a. revoke temporary on database roles_measure_p5 from public; then m5_plain's create temp table
     select 'datacl before='||coalesce(datacl::text,'(null)') from pg_database where datname = 'roles_measure_p5';
     datacl before={=Tc/postgres,postgres=CTc/postgres}
     revoke temporary on database roles_measure_p5 from public;
     select 'datacl after='||coalesce(datacl::text,'(null)') from pg_database where datname = 'roles_measure_p5';
     datacl after={=c/postgres,postgres=CTc/postgres}
     select 'm5_plain TEMP='||has_database_privilege('m5_plain', 'roles_measure_p5', 'TEMP');
     m5_plain TEMP=false
     create temp table m5_tmp3(id int);
     ERROR:  permission denied to create temporary tables in database "roles_measure_p5"
     LINE 1: create temp table m5_tmp3(id int);
                               ^
-- b. connected to database postgres: create role m5_owner while it already exists
     select 'exists='||exists(select 1 from pg_roles where rolname = 'm5_owner');
     exists=true
     create role m5_owner;
     ERROR:  role "m5_owner" already exists
== clean-up
     drop database if exists roles_measure_p5 with (force);
     drop database if exists m5_db;
     NOTICE:  database "m5_db" does not exist, skipping
     drop role if exists m5_owner;
     drop role if exists m5_plain;
     drop role if exists m5_login;
     drop role if exists m5_y;
     NOTICE:  role "m5_y" does not exist, skipping
     select 'm5 roles left: '||coalesce(string_agg(rolname, ','),'(none)') from pg_roles where rolname like 'm5\_%';
     m5 roles left: (none)
     select 'database roles_measure_p5 exists='||exists(select 1 from pg_database where datname = 'roles_measure_p5')||' m5_db exists='||exists(select 1 from pg_database where datname = 'm5_db');
     database roles_measure_p5 exists=false m5_db exists=false
