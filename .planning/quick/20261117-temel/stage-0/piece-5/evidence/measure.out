     procedure p_a: EXECUTE=true
     enum e_a: USAGE=true
     domain d_a: USAGE=true
-- d. the two global revokes (functions, types) for m5_owner, issued as m5_owner (postgres holds SET, not INHERIT, here), then set _b
     set role m5_owner;
     alter default privileges for role m5_owner revoke execute on functions from public;
     alter default privileges for role m5_owner revoke usage on types from public;
     reset role;
     :dacl;
     dacl: role=m5_owner schema=(global) type=f acl={m5_owner=X/m5_owner}
     dacl: role=m5_owner schema=(global) type=T acl={m5_owner=U/m5_owner}
     set role m5_owner;
