     select m5_s.f_b();
     ERROR:  permission denied for function f_b
     select 'a'::m5_s.e_a;
     a
     select 'a'::m5_s.e_b;
     a
     call m5_s.p_a();
     call m5_s.p_b();
     ERROR:  permission denied for procedure p_b
     select * from m5_s.t_a;
     ERROR:  permission denied for table t_a
     set role m5_owner;
     revoke usage on schema m5_s from m5_plain;
     reset role;
