     procedure p_b: EXECUTE=false
     enum e_b: USAGE=false
     domain d_b: USAGE=false
-- f. as m5_plain over TCP, no USAGE on m5_s: call f_a / f_b, use e_a / e_b, call p_a
     select current_user;
