     create function m5_s.f_b() returns int language sql return 1;
     create procedure m5_s.p_b() language sql begin atomic select 1; end;
     create type m5_s.e_b as enum ('a');
     create domain m5_s.d_b as int;
     create view m5_s.v_b as select 1 as x;
     reset role;
     :objs;
     proc f_a kind=f owner=m5_owner acl=(null)
     proc f_b kind=f owner=m5_owner acl={m5_owner=X/m5_owner}
     proc p_a kind=p owner=m5_owner acl=(null)
     proc p_b kind=p owner=m5_owner acl={m5_owner=X/m5_owner}
     rel  s_a kind=S owner=m5_owner acl=(null)
     rel  s_b kind=S owner=m5_owner acl=(null)
     rel  t_a kind=r owner=m5_owner acl=(null)
     rel  t_b kind=r owner=m5_owner acl=(null)
     rel  v_a kind=v owner=m5_owner acl=(null)
     rel  v_b kind=v owner=m5_owner acl=(null)
     type d_a typtype=d owner=m5_owner acl=(null)
     type d_b typtype=d owner=m5_owner acl={m5_owner=U/m5_owner}
     type e_a typtype=e owner=m5_owner acl=(null)
     type e_b typtype=e owner=m5_owner acl={m5_owner=U/m5_owner}
-- e. matrix for m5_plain, set _b
     schema m5_s: USAGE=false CREATE=false
     table t_b: SELECT=false INSERT=false UPDATE=false DELETE=false TRUNCATE=false REFERENCES=false TRIGGER=false
     view v_b: SELECT=false INSERT=false UPDATE=false DELETE=false
     seq s_b: USAGE=false SELECT=false UPDATE=false
